<Application x:Class="OverlayMVP.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OverlayMVP.Converters">
    <Application.Resources>

        <!-- ── Global font sizes (used by every window) ─────────────────── -->
        <sys:Double x:Key="GlobalFontSize"   xmlns:sys="clr-namespace:System;assembly=mscorlib">11</sys:Double>
        <sys:Double x:Key="GlobalFontSizeSm" xmlns:sys="clr-namespace:System;assembly=mscorlib">10</sys:Double>
        <sys:Double x:Key="GlobalFontSizeXs" xmlns:sys="clr-namespace:System;assembly=mscorlib">9</sys:Double>

        <!-- ── Converters ────────────────────────────────────────────────── -->
        <local:BoolToVisibilityConverter  x:Key="BoolToVis"/>
        <local:NullToVisibilityConverter  x:Key="NullToVisibility"/>
        <local:StringToBrushConverter     x:Key="StrBrush"/>

        <!-- ── Palette ───────────────────────────────────────────────────── -->
        <SolidColorBrush x:Key="BgPanel"       Color="#CC0D1117"/>
        <SolidColorBrush x:Key="BgCard"        Color="#881A2030"/>
        <SolidColorBrush x:Key="BgMultibox"    Color="#EE080D10"/>
        <SolidColorBrush x:Key="AccentBlue"    Color="#FF4FC3F7"/>
        <SolidColorBrush x:Key="AccentGold"    Color="#FFFFD54F"/>
        <SolidColorBrush x:Key="AccentRed"     Color="#FFEF5350"/>
        <SolidColorBrush x:Key="AccentGreen"   Color="#FF66BB6A"/>
        <SolidColorBrush x:Key="TextPrimary"   Color="#FFE8EDF2"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#FF8A99AA"/>
        <SolidColorBrush x:Key="Border"        Color="#FF1E3148"/>

        <!-- ══════════════════════════════════════════════════════════════════
             ComboBox — application-wide dark high-contrast style.
             Full ControlTemplate required: without it the popup always renders
             with the system (light) theme regardless of Background/Foreground.
             ══════════════════════════════════════════════════════════════════ -->

        <!-- Drop-down list item -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background"  Value="#FF0D1320"/>
            <Setter Property="Foreground"  Value="#FFE8EDF2"/>
            <Setter Property="FontFamily"  Value="Consolas"/>
            <Setter Property="FontSize"    Value="{DynamicResource GlobalFontSize}"/>
            <Setter Property="Padding"     Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FF1A3A5C"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FF0C2E52"/>
                                <Setter Property="Foreground" Value="#FF7DD3FC"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected"   Value="True"/>
                                    <Condition Property="IsMouseOver"  Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FF1A4A78"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The collapsed box + the popup together -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground"           Value="#FFE8EDF2"/>
            <Setter Property="FontFamily"           Value="Consolas"/>
            <Setter Property="FontSize"             Value="{DynamicResource GlobalFontSize}"/>
            <Setter Property="MinHeight"            Value="26"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- Collapsed toggle-button shell -->
                            <ToggleButton x:Name="ToggleButton"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Shell"
                                                Background="#FF0D1320"
                                                BorderBrush="#FF3A5A82"
                                                BorderThickness="1"
                                                CornerRadius="3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="22"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Selected value label -->
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding RelativeSource={RelativeSource AncestorType=ComboBox},
                                                                          Path=SelectionBoxItem}"
                                                           Foreground="#FFE8EDF2"
                                                           FontFamily="Consolas"
                                                           FontSize="{DynamicResource GlobalFontSize}"
                                                           Margin="8,4,4,4"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <!-- Chevron separator + arrow -->
                                                <Border Grid.Column="1"
                                                        BorderBrush="#FF3A5A82"
                                                        BorderThickness="1,0,0,0">
                                                    <TextBlock Text="▾"
                                                               Foreground="#FF4FC3F7"
                                                               FontSize="{DynamicResource GlobalFontSizeSm}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Shell" Property="BorderBrush" Value="#FF4FC3F7"/>
                                                <Setter TargetName="Shell" Property="Background"  Value="#FF111D30"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Shell" Property="BorderBrush" Value="#FF4FC3F7"/>
                                                <Setter TargetName="Shell" Property="Background"  Value="#FF111D30"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- Dropdown popup -->
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDown"
                                        Background="#FF0D1320"
                                        BorderBrush="#FF3A5A82"
                                        BorderThickness="1"
                                        CornerRadius="0,0,3,3"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Base text ──────────────────────────────────────────────────── -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily"  Value="Consolas"/>
            <Setter Property="Foreground"  Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize"    Value="{DynamicResource GlobalFontSize}"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontFamily"  Value="Consolas"/>
            <Setter Property="FontWeight"  Value="Bold"/>
            <Setter Property="FontSize"    Value="{DynamicResource GlobalFontSizeSm}"/>
            <Setter Property="Foreground"  Value="{StaticResource AccentBlue}"/>
            <Setter Property="Margin"      Value="0,0,0,4"/>
        </Style>

        <!-- ── Intel badge button (base for SmallBtn) ────────────────────── -->
        <Style x:Key="IntelBtn" TargetType="Button">
            <Setter Property="FontFamily"        Value="Consolas"/>
            <Setter Property="FontSize"          Value="{DynamicResource GlobalFontSizeSm}"/>
            <Setter Property="FontWeight"        Value="Bold"/>
            <Setter Property="Foreground"        Value="{StaticResource AccentBlue}"/>
            <Setter Property="Background"        Value="#221E3148"/>
            <Setter Property="BorderBrush"       Value="#443060A0"/>
            <Setter Property="BorderThickness"   Value="1"/>
            <Setter Property="Padding"           Value="8,4"/>
            <Setter Property="Cursor"            Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Small action button ────────────────────────────────────────── -->
        <Style x:Key="SmallBtn" TargetType="Button" BasedOn="{StaticResource IntelBtn}">
            <Setter Property="FontSize"    Value="{DynamicResource GlobalFontSizeXs}"/>
            <Setter Property="Padding"     Value="6,2"/>
        </Style>

        <!-- ── ToolTip (dark theme) ───────────────────────────────────────
             Without this, tooltips use WPF's pale default background while
             inheriting the app's near-white foreground — unreadable. -->
        <Style TargetType="ToolTip">
            <Setter Property="Background"      Value="#FF0D1117"/>
            <Setter Property="Foreground"      Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource AccentBlue}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="8,5"/>
            <Setter Property="FontSize"        Value="{DynamicResource GlobalFontSizeXs}"/>
            <Setter Property="HasDropShadow"   Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
