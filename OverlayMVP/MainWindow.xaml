<!-- filename: MainWindow.xaml -->
<Window x:Class="OverlayMVP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ARC Overlay"
        Width="480" Height="640"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">

  <Window.Resources>
    <Style x:Key="Panel" TargetType="Border">
      <Setter Property="Background" Value="#1A0D1F2E"/>
      <Setter Property="BorderBrush" Value="#33AADDFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="10"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="SectionHeader" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#FF9AD1FF"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="DataLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#AACCDDFF"/>
      <Setter Property="FontSize" Value="10"/>
    </Style>
    <Style x:Key="DataValue" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#FFEEFFFF"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="OverlayBtn" TargetType="Button">
      <Setter Property="Height" Value="32"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="5" Padding="8,4">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.82"/></Trigger>
              <Trigger Property="IsPressed"   Value="True"><Setter Property="Opacity" Value="0.55"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SmallBtn" TargetType="Button" BasedOn="{StaticResource OverlayBtn}">
      <Setter Property="Height" Value="22"/>
      <Setter Property="FontSize" Value="9"/>
    </Style>
  </Window.Resources>

  <Border Background="#CC060E1C" CornerRadius="12"
          BorderThickness="1" BorderBrush="#44AADDFF">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- ══════════════════════════════════════════ TITLE BAR -->
      <Border Grid.Row="0" Background="#220A1A2F" CornerRadius="12,12,0,0"
              Padding="12,8" MouseLeftButtonDown="TitleBar_MouseDown">
        <DockPanel>
          <!-- App title — localized -->
          <TextBlock Text="{Binding Loc.AppTitle}"
                     FontSize="12" FontWeight="Bold"
                     Foreground="#FF9AD1FF"
                     DockPanel.Dock="Left"
                     VerticalAlignment="Center"/>

          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Language toggle -->
            <Button Content="{Binding Loc.LanguageButtonLabel}"
                    Width="42" Height="22"
                    FontSize="9" FontWeight="Bold"
                    Background="#22001A30"
                    BorderBrush="#4499BBFF"
                    Foreground="#FF9AD1FF"
                    Margin="0,0,6,0"
                    Cursor="Hand"
                    Command="{Binding ToggleLanguageCommand}"
                    Style="{StaticResource SmallBtn}"/>
            <!-- Connection status -->
            <TextBlock Text="{Binding ConnectionStatus}"
                       Foreground="#AAFFFFFF" FontSize="9"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <!-- Close -->
            <Button Content="✕" Width="20" Height="20" FontSize="10"
                    Background="Transparent" Foreground="#88FFFFFF"
                    BorderThickness="0" Cursor="Hand"
                    Click="CloseBtn_Click"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- ══════════════════════════════════════ MAIN CONTENT -->
      <ScrollViewer Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Padding="10,8">
        <StackPanel>

          <!-- ─── PILOT STATUS ─── -->
          <Border Style="{StaticResource Panel}">
            <StackPanel>
              <TextBlock Text="{Binding Loc.PanelPilot}" Style="{StaticResource SectionHeader}"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="54"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="44"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Loc.LabelPilot}" Style="{StaticResource DataLabel}" Margin="0,0,4,4"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CharacterName}"  Style="{StaticResource DataValue}" Margin="0,0,8,4"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Loc.LabelCorp}"  Style="{StaticResource DataLabel}" Margin="0,0,4,4"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding Corporation}"    Style="{StaticResource DataValue}" Margin="0,0,0,4" TextTrimming="CharacterEllipsis"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Loc.LabelShip}"  Style="{StaticResource DataLabel}" Margin="0,0,4,4"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ShipType}"        Style="{StaticResource DataValue}" Margin="0,0,8,4"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Loc.LabelSec}"   Style="{StaticResource DataLabel}" Margin="0,0,4,4"/>
                <TextBlock Grid.Row="1" Grid.Column="3" Margin="0,0,0,4">
                  <TextBlock.Inlines>
                    <Run Text="{Binding SecurityStatus}" Foreground="{Binding SecurityColour}" FontWeight="Bold"/>
                  </TextBlock.Inlines>
                </TextBlock>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding Loc.LabelSystem}" Style="{StaticResource DataLabel}" Margin="0,0,4,0"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                           Text="{Binding SolarSystem}" Style="{StaticResource DataValue}" FontSize="12"/>
              </Grid>
            </StackPanel>
          </Border>

          <!-- ─── INTEL & ALERTS ─── -->
          <Border Style="{StaticResource Panel}">
            <StackPanel>
              <DockPanel Margin="0,0,0,8">
                <TextBlock Text="{Binding Loc.PanelIntel}" Style="{StaticResource SectionHeader}"
                           DockPanel.Dock="Left" Margin="0"/>
                <TextBlock Text="{Binding IntelStatus}"
                           Foreground="#FFCC44" FontSize="9"
                           DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right"/>
              </DockPanel>

              <!-- Row 1: Gate Camp + Pirates -->
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="4"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="{Binding Loc.BtnGateCamp}"
                        Style="{StaticResource OverlayBtn}"
                        Background="#661A0A0A" BorderBrush="#88FF4444" Foreground="#FFFF6666"
                        Command="{Binding ReportGateCampCommand}"/>
                <Button Grid.Column="2"
                        Content="{Binding Loc.BtnPirates}"
                        Style="{StaticResource OverlayBtn}"
                        Background="#66200A0A" BorderBrush="#88FF6600" Foreground="#FFFF8844"
                        Command="{Binding ReportPiratesCommand}"/>
              </Grid>

              <!-- Row 2: Roaming + Clear -->
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="4"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="{Binding Loc.BtnRoaming}"
                        Style="{StaticResource OverlayBtn}"
                        Background="#66201A00" BorderBrush="#88FFCC00" Foreground="#FFFFCC44"
                        Command="{Binding ReportRoamingCommand}"/>
                <Button Grid.Column="2"
                        Content="{Binding Loc.BtnClear}"
                        Style="{StaticResource OverlayBtn}"
                        Background="#660A200A" BorderBrush="#8844FF88" Foreground="#FF66FF88"
                        Command="{Binding ReportClearCommand}"/>
              </Grid>

              <!-- Recent intel list -->
              <ItemsControl ItemsSource="{Binding Intel}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="#110A1520" BorderBrush="#22AADDFF"
                            BorderThickness="1" CornerRadius="4"
                            Padding="8,4" Margin="0,0,0,3">
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding AgeLabel}"
                                   Foreground="#66FFFFFF" FontSize="9"
                                   VerticalAlignment="Center"/>
                        <TextBlock>
                          <Run Text="{Binding TypeEmoji}"/>
                          <Run Text=" "/>
                          <Run Text="{Binding System}" FontWeight="Bold" Foreground="#FFEEFFFF"/>
                          <Run Text=" — "/>
                          <Run Text="{Binding TypeLabel}" Foreground="#FFCC8844"/>
                          <Run Text="  x"/>
                          <Run Text="{Binding Count}" Foreground="#FFAADDFF"/>
                        </TextBlock>
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- ─── MISSIONS ─── -->
          <Border Style="{StaticResource Panel}">
            <StackPanel>
              <DockPanel Margin="0,0,0,8">
                <TextBlock Text="{Binding Loc.PanelMissions}" Style="{StaticResource SectionHeader}"
                           DockPanel.Dock="Left" Margin="0"/>
                <TextBlock Text="{Binding MissionSummary}"
                           Foreground="#FF9AD1FF" FontSize="9"
                           DockPanel.Dock="Right" VerticalAlignment="Center"/>
              </DockPanel>

              <ItemsControl ItemsSource="{Binding Missions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="#110A1520" BorderBrush="#22AADDFF"
                            BorderThickness="1" CornerRadius="6"
                            Padding="10,8" Margin="0,0,0,6">
                      <StackPanel>
                        <!-- Title row -->
                        <DockPanel Margin="0,0,0,4">
                          <TextBlock DockPanel.Dock="Right" FontSize="9" Foreground="#88FFFFFF" VerticalAlignment="Center">
                            <Run Text="#" Foreground="#44FFFFFF"/>
                            <Run Text="{Binding Id}" Foreground="#FFAADDFF" FontWeight="Bold"/>
                          </TextBlock>
                          <TextBlock>
                            <Run Text="{Binding StatusEmoji}"/>
                            <Run Text=" "/>
                            <Run Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" FontSize="11"/>
                          </TextBlock>
                        </DockPanel>

                        <!-- Description -->
                        <TextBlock Text="{Binding Description}"
                                   Foreground="#AACCDDFF" FontSize="9"
                                   TextWrapping="Wrap" MaxHeight="40"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,0,6"/>

                        <!-- Reward + Status -->
                        <DockPanel Margin="0,0,0,6">
                          <TextBlock DockPanel.Dock="Left" FontSize="9">
                            <Run Text="💰 " Foreground="#FFDDAA44"/>
                            <Run Text="{Binding Reward}" Foreground="#FFFFCC88"/>
                          </TextBlock>
                          <TextBlock DockPanel.Dock="Right" FontSize="9" HorizontalAlignment="Right">
                            <Run Text="{Binding StatusLabel}" Foreground="#FF9AD1FF"/>
                          </TextBlock>
                        </DockPanel>

                        <!-- Action buttons — labels from Loc -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                          <Button Content="{Binding DataContext.Loc.BtnAssign, RelativeSource={RelativeSource AncestorType=Window}}"
                                  Style="{StaticResource SmallBtn}"
                                  Background="#331A2A00" BorderBrush="#5566DD88" Foreground="#FF88FF99"
                                  Margin="0,0,6,0"
                                  CommandParameter="{Binding Id}"
                                  Command="{Binding DataContext.AssignMissionCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                          <Button Content="{Binding DataContext.Loc.BtnComplete, RelativeSource={RelativeSource AncestorType=Window}}"
                                  Style="{StaticResource SmallBtn}"
                                  Background="#330A2A0A" BorderBrush="#5544FF66" Foreground="#FF66FF88"
                                  CommandParameter="{Binding Id}"
                                  Command="{Binding DataContext.CompleteMissionCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Sync button -->
              <Button Content="{Binding Loc.BtnSync}"
                      Height="28" FontSize="10" FontWeight="Bold"
                      Background="#22001A30" BorderBrush="#4499BBFF" Foreground="#FF9AD1FF"
                      Margin="0,4,0,0" Cursor="Hand"
                      Command="{Binding RefreshCommand}"
                      Style="{StaticResource OverlayBtn}"/>
            </StackPanel>
          </Border>

          <!-- ─── FACTION FOCUS ─── -->
          <Border Style="{StaticResource Panel}">
            <StackPanel>
              <TextBlock Text="{Binding Loc.PanelFaction}" Style="{StaticResource SectionHeader}"/>
              <ComboBox SelectedValue="{Binding FactionFocus}"
                        SelectedValuePath="Tag"
                        Background="#110A1520" Foreground="White"
                        BorderBrush="#33AADDFF" Height="28">
                <ComboBoxItem Content="Caldari"        Tag="CALDARI"/>
                <ComboBoxItem Content="ORE"            Tag="ORE"/>
                <ComboBoxItem Content="CONCORD"        Tag="CONCORD"/>
                <ComboBoxItem Content="EDENCOM"        Tag="EDENCOM"/>
                <ComboBoxItem Content="Sisters of EVE" Tag="SOE"/>
              </ComboBox>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>

      <!-- ══════════════════════════════════════════════ FOOTER -->
      <Border Grid.Row="2" Background="#110A1020" CornerRadius="0,0,12,12" Padding="12,6">
        <DockPanel>
          <TextBlock DockPanel.Dock="Right"
                     Text="{Binding ClickThroughLabel}"
                     Foreground="#88FFFFFF" FontSize="9" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding Loc.FooterHotkeys}"
                     Foreground="#55FFFFFF" FontSize="8" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>

    </Grid>
  </Border>
</Window>
