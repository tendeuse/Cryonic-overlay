<!-- filename: MainWindow.xaml -->
<Window x:Class="OverlayMVP.MainWindow"
        xmlns:local="clr-namespace:OverlayMVP.Converters"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OverlayMVP.ViewModels"
        xmlns:ctl="clr-namespace:OverlayMVP.Controls"
        Title="Cryonic Overlay"
        Width="460"
        Height="Auto"
        MinWidth="320"
        MinHeight="180"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- ── Zero int → Collapsed ─────────────────────────────────────── -->
        <local:ZeroToCollapsedConverter x:Key="ZeroToCollapsed"/>
        <local:KillRoleIconConverter       x:Key="KillRoleIcon"/>
        <local:ThresholdStatusConverter    x:Key="ThresholdStatus"/>
        <local:IntelStatusColourConverter  x:Key="IntelStatusColour"/>
        <local:BoolToFontWeightConverter   x:Key="BoolToWeight"/>
        <local:BoolToEsiColourConverter   x:Key="BoolToEsiColour"/>
        <local:InvertBoolToVisConverter   x:Key="InvertBoolToVis"/>
        <!-- ── Step status emoji (MultiValueConverter) ─────────────────── -->
        <local:StepStatusEmojiConverter x:Key="StepStatusEmojiConverter"/>
        <!-- ── Step progress 0–1 (MultiValueConverter) ───────────────────── -->
        <local:StepProgressConverter x:Key="StepProgressConverter"/>
    </Window.Resources>

    <!-- ── Outer container: rounded dark panel ────────────────────────── -->
    <!--
      TextElement.FontSize stays here on the instance, not in the WindowShell
      template. It's a user setting (SettingsWindow writes it, App.xaml.cs
      pushes it into Application.Current.Resources at startup), not chrome —
      a skin swapping the template must not be able to silently reset it.
    -->
    <ctl:WindowShell Background="{DynamicResource Bg}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="0"
            TextElement.FontSize="{DynamicResource GlobalFontSize}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- row 0: title bar -->
                <RowDefinition Height="Auto"/>   <!-- row 1: repair banner -->
                <RowDefinition Height="Auto"/>   <!-- row 2: multibox -->
                <RowDefinition Height="Auto"/>   <!-- row 3: intel (always visible) -->
                <RowDefinition Height="Auto"/>   <!-- row 4: pilot status -->
                <RowDefinition Height="Auto"/>   <!-- row 5: panel launcher -->
                <RowDefinition Height="Auto"/>   <!-- row 6: footer -->
            </Grid.RowDefinitions>

            <!-- ════════════════════════════════════════════════════════ -->
            <!--  TITLE BAR                                               -->
            <!-- ════════════════════════════════════════════════════════ -->
            <ctl:TitleBar Grid.Row="0" Background="{DynamicResource Onyx}"
                    CornerRadius="8,8,0,0"
                    Padding="10,6"
                    MouseLeftButtonDown="TitleBar_MouseDown"
                    Cursor="SizeAll">
                <StackPanel>
                    <!-- Line 1: brand + close -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Title -->
                        <TextBlock Grid.Column="0"
                                   Text="◈ CRYONIC OVERLAY"
                                   FontWeight="Bold"
                                   FontSize="{DynamicResource GlobalFontSize}"
                                   Foreground="{DynamicResource Accent}"
                                   VerticalAlignment="Center"/>

                        <!-- Close -->
                        <Button Grid.Column="1"
                                Content="✕"
                                Click="CloseBtn_Click"
                                Style="{StaticResource SmallBtn}"
                                Background="{DynamicResource Red33}"
                                BorderBrush="{DynamicResource Red}"
                                Foreground="{DynamicResource Red}"/>
                    </Grid>

                    <!-- Line 2: connection status + tool buttons -->
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Connection status -->
                        <TextBlock Grid.Column="0"
                                   Text="{Binding ConnectionStatus}"
                                   FontSize="{DynamicResource GlobalFontSizeXs}"
                                   Foreground="{DynamicResource TextDim}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>

                        <!-- Language toggle -->
                        <Button Grid.Column="1"
                                Content="{Binding Loc.LanguageButtonLabel}"
                                Command="{Binding ToggleLanguageCommand}"
                                Style="{StaticResource SmallBtn}"
                                Background="{DynamicResource White33}"
                                BorderBrush="{DynamicResource Border}"
                                Margin="0,0,4,0"/>

                        <!-- Intel search button -->
                        <Button Grid.Column="2"
                                Content="&#x1F50D;"
                                Click="IntelBtn_Click"
                                Style="{StaticResource SmallBtn}"
                                Background="{DynamicResource Red33}"
                                BorderBrush="{DynamicResource Red}"
                                ToolTip="Pilot Intel Search"
                                Margin="0,0,4,0"
                                Visibility="{Binding ShowPilotIntelBtn, Converter={StaticResource BoolToVis}}"/>

                        <!-- System info button -->
                        <Button Grid.Column="3"
                                Content="&#x1F30D;"
                                Click="SystemBtn_Click"
                                Style="{StaticResource SmallBtn}"
                                Background="{DynamicResource Accent33}"
                                BorderBrush="{DynamicResource Accent}"
                                ToolTip="System Info (Dotlan)"
                                Margin="0,0,4,0"
                                Visibility="{Binding ShowSystemInfoBtn, Converter={StaticResource BoolToVis}}"/>

                        <!-- Control panel (super-users only) -->
                        <Button Grid.Column="4"
                                Content="🛠"
                                Click="ControlPanelBtn_Click"
                                Style="{StaticResource SmallBtn}"
                                Background="{DynamicResource Accent33}"
                                BorderBrush="{DynamicResource Accent}"
                                ToolTip="Open Control Panel"
                                Margin="0,0,4,0"
                                Visibility="{Binding IsSuperUser, Converter={StaticResource BoolToVis}}"/>

                        <!-- Settings -->
                        <Button Grid.Column="5"
                                Content="⚙"
                                Click="SettingsBtn_Click"
                                Style="{StaticResource SmallBtn}"
                                Background="{DynamicResource White33}"
                                BorderBrush="{DynamicResource Border}"
                                ToolTip="{Binding Loc.TipSettings}"
                                Margin="0,0,6,0"/>
                    </Grid>
                </StackPanel>
            </ctl:TitleBar>

            <!-- ── Update notice ────────────────────────────────────────────
                 Stacked inside row 1 (rather than adding a new RowDefinition)
                 to avoid renumbering every Grid.Row below, including the resize
                 strips at the bottom of the grid. -->
            <StackPanel Grid.Row="1">
                <!-- ── Update notice (server-driven; non-intrusive banner row —
                     never a modal, never blocks overlay use; dismissible) ───── -->
                <Border Background="{DynamicResource BorderCC}"
                        CornerRadius="0"
                        Padding="8,4"
                        Visibility="{Binding ShowUpdateNotice, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock FontSize="{DynamicResource GlobalFontSizeXs}" FontWeight="Bold"
                                       Foreground="{DynamicResource Accent}" TextWrapping="Wrap">
                                <Run Text="⬆ Update available — v"/><Run Text="{Binding UpdateVersion, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding UpdateNotes}"
                                       FontSize="{DynamicResource GlobalFontSizeXs}"
                                       Foreground="{DynamicResource TextDim}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="Download"
                                Click="UpdateBtn_Click"
                                Style="{StaticResource SmallBtn}"
                                Margin="0,0,4,0"/>
                        <Button Grid.Column="2"
                                Content="✕"
                                Command="{Binding DismissUpdateCommand}"
                                Style="{StaticResource SmallBtn}"
                                ToolTip="Dismiss"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ════════════════════════════════════════════════════════ -->
            <!--  MULTIBOX SWITCHER  (always visible)                    -->
            <!-- ════════════════════════════════════════════════════════ -->
            <ctl:SectionPanel Grid.Row="2"
                              Background="{DynamicResource Well}"
                              BorderBrush="{DynamicResource SteelBlue}"
                              BorderThickness="0,0,0,1"
                              Padding="8,6"
                              Visibility="{Binding ShowMultibox, Converter={StaticResource BoolToVis}}">
                <ctl:SectionPanel.Header>
                    <TextBlock Text="◈ ACTIVE INSTANCES"
                               Style="{StaticResource SectionHeader}"
                               Foreground="{DynamicResource Amber}"
                               Margin="0"/>
                </ctl:SectionPanel.Header>

                    <!-- Scroll horizontally if many instances -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="MultiboxItemsControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!--
                                        Each card is 140×90.
                                        ThumbnailHost (the inner dark border) is the DWM dest rect.
                                        The click handler calls MultiboxManager.SwitchTo(inst).
                                    -->
                                    <Border Width="100" Height="76"
                                            Margin="0,0,4,0"
                                            CornerRadius="4"
                                            BorderBrush="{DynamicResource BorderStrong}"
                                            BorderThickness="1"
                                            Cursor="Hand"
                                            MouseLeftButtonDown="MultiboxCard_Click"
                                            ToolTip="Click to focus · Double-click to detach">
                                        <Grid>
                                            <!-- DWM thumbnail destination area -->
                                            <Border x:Name="ThumbnailHost"
                                                    Background="{DynamicResource Abyss}"
                                                    CornerRadius="4,4,0,0"
                                                    Height="56"
                                                    VerticalAlignment="Top"/>

                                            <!-- Label strip at bottom -->
                                            <Border Background="{DynamicResource BgDD}"
                                                    CornerRadius="0,0,4,4"
                                                    Height="20"
                                                    VerticalAlignment="Bottom"
                                                    Padding="4,2">
                                                <Grid>
                                                    <TextBlock Text="{Binding Label, Mode=OneWay}"
                                                               FontSize="{DynamicResource GlobalFontSizeXs}"
                                                               Foreground="{DynamicResource Amber}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>

                                            <!-- Hover highlight -->
                                            <Border CornerRadius="4"
                                                    Background="Transparent">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource AquaBlue}"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                            <!-- Empty state -->
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Style.Triggers>
                                        <Trigger Property="HasItems" Value="False">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate>
                                                        <TextBlock Text="No EVE instances detected"
                                                                   Foreground="{DynamicResource TextDim}"
                                                                   FontStyle="Italic"
                                                                   Padding="4,8"/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                        </ItemsControl>
                    </ScrollViewer>
            </ctl:SectionPanel>

            <!-- ════════════════════════════════════════════════════════ -->
            <!--  CONTENT PANELS                                          -->
            <!-- ════════════════════════════════════════════════════════ -->
            <!-- FIX: ScrollViewer replaces SizeToContent to prevent WPF layout SO -->
            <!-- ════════════════════════════════════════════════════════ -->
            <!--  INTEL & ALERTS  (always visible, never scrolls)         -->
            <!-- ════════════════════════════════════════════════════════ -->
            <ctl:SectionPanel Grid.Row="3"
                              Background="{DynamicResource Panel}"
                              BorderBrush="{DynamicResource Border}"
                              BorderThickness="0,1,0,1"
                              Padding="8,6"
                              Visibility="{Binding ShowIntelAlerts, Converter={StaticResource BoolToVis}}">
                <ctl:SectionPanel.Header>
                    <TextBlock Text="{Binding Loc.IntelAlerts}"
                               Style="{StaticResource SectionHeader}"
                               Margin="0"/>
                </ctl:SectionPanel.Header>
                <ctl:SectionPanel.HeaderAccessory>
                    <TextBlock Text="{Binding IntelStatus}"
                               Foreground="{Binding HasAlerts, Converter={StaticResource IntelStatusColour}}"
                               FontSize="{DynamicResource GlobalFontSizeXs}"
                               FontWeight="{Binding HasAlerts, Converter={StaticResource BoolToWeight}}"
                               VerticalAlignment="Center"/>
                </ctl:SectionPanel.HeaderAccessory>

                <StackPanel>
                    <!-- System input -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="System: "
                                   Foreground="{DynamicResource TextDim}"
                                   FontSize="{DynamicResource GlobalFontSizeSm}"
                                   VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding CurrentSystem, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{DynamicResource Border22}"
                                 Foreground="{DynamicResource Text}"
                                 BorderBrush="{DynamicResource Border}"
                                 BorderThickness="1"
                                 FontFamily="Consolas"
                                 FontSize="{DynamicResource GlobalFontSizeSm}"
                                 Padding="4,2"
                                 CaretBrush="{DynamicResource Accent}"/>
                    </Grid>

                    <!-- Report buttons -->
                    <WrapPanel Margin="0,0,0,4">
                        <Button Content="⚠ GATE CAMP"
                                Command="{Binding ReportGateCampCommand}"
                                Style="{StaticResource StatusKey}"
                                Background="{DynamicResource Red33}"
                                BorderBrush="{DynamicResource Red}"
                                Margin="0,0,4,0"/>
                        <Button Content="☠ PIRATES"
                                Command="{Binding ReportPiratesCommand}"
                                Style="{StaticResource StatusKey}"
                                Background="{DynamicResource Orange33}"
                                BorderBrush="{DynamicResource Orange}"
                                Margin="0,0,4,0"/>
                        <Button Content="⟳ ROAMING"
                                Command="{Binding ReportRoamingCommand}"
                                Style="{StaticResource StatusKey}"
                                Background="{DynamicResource Amber33}"
                                BorderBrush="{DynamicResource Amber}"/>
                    </WrapPanel>

                    <!-- Intel feed -->
                    <ItemsControl ItemsSource="{Binding Intel}" MaxHeight="70">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,1"
                                           Foreground="{DynamicResource Text}">
                                    <Run Text="{Binding AgeLabel, Mode=OneWay}" Foreground="{DynamicResource TextDim}"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding System, Mode=OneWay}"   Foreground="{DynamicResource Accent}"/>
                                    <Run Text=" — " Foreground="{DynamicResource TextDim}"/>
                                    <Run Text="{Binding Notes, Mode=OneWay}"   Foreground="{DynamicResource Text}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ctl:SectionPanel>

            <!-- ════════════════════════════════════════════════════════ -->
            <!--  PILOT STATUS  (always visible, inline)                  -->
            <!-- ════════════════════════════════════════════════════════ -->
            <ctl:SectionPanel Grid.Row="4"
                              Background="{DynamicResource Panel}"
                              BorderBrush="{DynamicResource Border}"
                              BorderThickness="0,1,0,1"
                              Padding="8,6"
                              Visibility="{Binding ShowPilotStatus, Converter={StaticResource BoolToVis}}">
                <ctl:SectionPanel.Header>
                    <TextBlock Text="{Binding Loc.PilotStatus}"
                               Style="{StaticResource SectionHeader}"
                               Margin="0"/>
                </ctl:SectionPanel.Header>
                <ctl:SectionPanel.HeaderAccessory>
                    <Button Content="⟳"
                            Command="{Binding RefreshStandingsCommand}"
                            Style="{StaticResource SmallBtn}"
                            ToolTip="Refresh ESI standings"
                            Visibility="{Binding EveLinked, Converter={StaticResource BoolToVis}}"
                            VerticalAlignment="Center"/>
                </ctl:SectionPanel.HeaderAccessory>

                <ctl:SectionPanel.Toolbar>
                        <!-- ESI character selector -->
                        <Border Background="{DynamicResource White11}" CornerRadius="3" Padding="6,4" Margin="0,0,0,4"
                                Visibility="{Binding EveLinked, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ESI: "
                                           Foreground="{DynamicResource Accent}"
                                           FontSize="{DynamicResource GlobalFontSizeSm}"
                                           VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding LinkedCharacters}"
                                          SelectedItem="{Binding ActiveCharacter, Mode=TwoWay}"
                                          FontSize="{DynamicResource GlobalFontSizeSm}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CharacterName}"
                                                       FontFamily="Consolas"
                                                       FontSize="{DynamicResource GlobalFontSizeSm}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </Border>
                </ctl:SectionPanel.Toolbar>

                <StackPanel>

                    <!-- Connection status -->
                    <TextBlock Text="{Binding ConnectionStatus}"
                               Foreground="{DynamicResource TextDim}"
                               FontSize="{DynamicResource GlobalFontSizeXs}"
                               Margin="0,0,0,4"/>

                    <!-- Locally detected EVE windows -->
                    <ItemsControl ItemsSource="{Binding EveWindows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding ActiveIndicator, Mode=OneWay}"
                                               Foreground="{DynamicResource Amber}"
                                               FontSize="{DynamicResource GlobalFontSize}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DisplayLabel, Mode=OneWay}"
                                               Foreground="{DynamicResource Text}"
                                               FontWeight="Bold"
                                               FontSize="{DynamicResource GlobalFontSize}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Ship / System info row -->
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                            <TextBlock Text="{Binding ShipType}"
                                       Foreground="{DynamicResource Accent}"
                                       FontSize="{DynamicResource GlobalFontSizeSm}"/>
                            <TextBlock Text="{Binding Corporation}"
                                       Foreground="{DynamicResource TextDim}"
                                       FontSize="{DynamicResource GlobalFontSizeXs}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding SolarSystem}"
                                       Foreground="{DynamicResource Text}"
                                       FontWeight="Bold"
                                       FontSize="{DynamicResource GlobalFontSizeSm}"/>
                            <TextBlock Text="{Binding SecurityStatus}"
                                       Foreground="{Binding SecurityColour, Converter={StaticResource StrBrush}}"
                                       FontSize="{DynamicResource GlobalFontSizeXs}"/>
                        </StackPanel>
                    </Grid>

                </StackPanel>
            </ctl:SectionPanel>

            <!-- ══ Panel launcher buttons (one per row) ════════════════════════════ -->
            <!-- Headerless, like the footer. BorderThickness="0" is REQUIRED:
                 the SectionPanel style defaults to 0,1,0,1 for the intel and
                 pilot rows, and without this the launcher gains rules it has
                 never had. -->
            <ctl:SectionPanel Grid.Row="5"
                              Background="{DynamicResource Graphite}"
                              BorderThickness="0"
                              Padding="8,6">
                <StackPanel>
                    <Button x:Name="BtnStanding"
                            Content="📋  Standing"
                            Style="{StaticResource LauncherBtn}"
                            Click="PanelBtn_Click" Tag="standing"
                            ToolTip="Faction Standing Guide"
                            Visibility="{Binding ShowStandingGuide, Converter={StaticResource BoolToVis}}"/>
                    <Button x:Name="BtnProgress"
                            Content="📊  Session"
                            Style="{StaticResource LauncherBtn}"
                            Click="PanelBtn_Click" Tag="progress"
                            ToolTip="Mission Progress tracker"
                            Visibility="{Binding ShowMissionProgress, Converter={StaticResource BoolToVis}}"/>
                    <Button x:Name="BtnSkills"
                            Content="🎓  Skills"
                            Style="{StaticResource LauncherBtn}"
                            Click="PanelBtn_Click" Tag="skills"
                            ToolTip="Faction Skill Plan"
                            Visibility="{Binding ShowSkillPlan, Converter={StaticResource BoolToVis}}"/>
                    <!-- Help. Always visible: it has no Settings toggle on
                         purpose, because the toggle that hides it lives in the
                         very screen a lost user cannot find. -->
                    <Button x:Name="BtnHelp"
                            Content="❔  Help"
                            Style="{StaticResource LauncherBtn}"
                            Click="HelpBtn_Click"
                            ToolTip="Hotkeys, panels and getting started"/>

                    <Grid>
                        <Button x:Name="BtnOrders"
                                Content="📢  Orders"
                                Style="{StaticResource LauncherBtn}"
                                Click="PanelBtn_Click" Tag="orders"
                                ToolTip="Orders from your corp / coalition"/>
                        <TextBlock Text="⚠"
                                   Foreground="{DynamicResource Amber}"
                                   FontWeight="Bold"
                                   FontSize="{DynamicResource GlobalFontSize}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"
                                   IsHitTestVisible="False"
                                   ToolTip="New order received"
                                   Visibility="{Binding HasNewOrders, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </StackPanel>
            </ctl:SectionPanel>

            <!-- ════════════════════════════════════════════════════════ -->
            <!--  FOOTER + RESIZE GRIPS                                   -->
            <!-- ════════════════════════════════════════════════════════ -->
            <ctl:SectionPanel Grid.Row="6"
                               Background="{DynamicResource Obsidian}"
                               BorderThickness="0"
                               CornerRadius="0,0,8,8"
                               Padding="0">
                <StackPanel>

                    <!-- ── SPONSOR BANNER ─────────────────────────────────────
                         EULA §4.4(c): a general ad shown to ALL users, non-intrusive.
                         Clicking opens SponsorUrl in the default browser.
                         NOT linked to donations — never remove/alter it for donors. -->
                    <Border x:Name="SponsorBanner"
                            Background="{DynamicResource InkBlue}"
                            BorderBrush="{DynamicResource Border}"
                            BorderThickness="0,1,0,0"
                            Padding="8,5"
                            Cursor="Hand"
                            MouseLeftButtonDown="SponsorBanner_Click"
                            ToolTip="{Binding SponsorSubtext}"
                            Visibility="{Binding ShowSponsorBanner, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- "AD" disclosure tag (honesty / store-policy safe) -->
                            <Border Grid.Column="0"
                                    Background="{DynamicResource Amber22}"
                                    CornerRadius="3"
                                    Padding="4,1"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="AD"
                                           FontSize="{DynamicResource GlobalFontSizeXs}"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource Amber}"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SponsorHeadline}"
                                           Foreground="{DynamicResource Text}"
                                           FontWeight="Bold"
                                           FontSize="{DynamicResource GlobalFontSizeSm}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding SponsorSubtext}"
                                           Foreground="{DynamicResource TextDim}"
                                           FontSize="{DynamicResource GlobalFontSizeXs}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2"
                                       Text="↗"
                                       Foreground="{DynamicResource Accent}"
                                       FontSize="{DynamicResource GlobalFontSize}"
                                       VerticalAlignment="Center"
                                       Margin="6,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- ── Hotkey line + Support + resize grip ──────────────── -->
                    <Border Padding="8,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding AppVersion}"
                                           FontSize="{DynamicResource GlobalFontSizeXs}"
                                           Foreground="{DynamicResource TextDim}"
                                           Opacity="0.6"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ClickThroughLabel}"
                                       FontSize="{DynamicResource GlobalFontSizeXs}"
                                       Foreground="{DynamicResource Amber}"
                                       VerticalAlignment="Center"/>

                            <!-- Voluntary donation link — decoupled from ads/features (§4.4b) -->
                            <Button Grid.Column="2"
                                    Content="♥ Support"
                                    Click="SupportBtn_Click"
                                    Style="{StaticResource SmallBtn}"
                                    Background="{DynamicResource Red33}"
                                    BorderBrush="{DynamicResource Red}"
                                    Foreground="{DynamicResource Red}"
                                    Margin="8,0,0,0"
                                    ToolTip="Support development on GitHub Sponsors — a voluntary donation. It does not unlock features or remove ads."/>

                            <!-- Resize grip ◢ -->
                            <TextBlock Grid.Column="3"
                                       Text="◢"
                                       FontSize="{DynamicResource GlobalFontSize}"
                                       Foreground="{DynamicResource White44}"
                                       Cursor="SizeNWSE"
                                       VerticalAlignment="Bottom"
                                       Margin="8,0,0,0"
                                       MouseLeftButtonDown="ResizeGrip_MouseDown"
                                       ToolTip="Drag to resize"/>
                        </Grid>
                    </Border>

                </StackPanel>
            </ctl:SectionPanel>

            <!-- Right-edge resize strip -->
            <Border Grid.Row="0" Grid.RowSpan="7"
                    Width="5"
                    HorizontalAlignment="Right"
                    Background="{DynamicResource Black01}"
                    Cursor="SizeWE"
                    MouseLeftButtonDown="ResizeRight_MouseDown"/>

            <!-- Bottom-edge resize strip -->
            <Border Grid.Row="6"
                    Height="5"
                    VerticalAlignment="Bottom"
                    Background="{DynamicResource Black01}"
                    Cursor="SizeNS"
