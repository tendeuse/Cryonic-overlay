<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
	<StartupObject>OverlayMVP.Program</StartupObject>
    <!-- Numeric only. The overlay compares this against /version with
         Version.TryParse to decide whether an update exists, so a suffix like
         "-beta" here would make every comparison fail silently. The channel
         name lives in MainViewModel.Channel instead. -->
    <Version>0.7.3</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Barlow, embedded so the cockpit skins look the same on every machine.
         Resource (not Content): the font must live INSIDE the assembly, or a
         pack:// FontFamily URI cannot resolve it and WPF silently falls back
         to the default face with no error.
         SIL Open Font License 1.1 — Fonts\OFL.txt travels with them. -->
    <Resource Include="Fonts\*.ttf" />
    <None Include="Fonts\OFL.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>

    <None Include="Assets\seed_packs.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <Content Include="Assets\clips\*.mp4">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
