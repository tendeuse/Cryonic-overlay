<!-- filename: Views/HelpWindow.xaml -->
<!--
  Built from ctl:WindowShell / ctl:TitleBar / ctl:SectionPanel rather than raw
  Borders, so it inherits whatever chrome the active skin supplies. That makes
  it the first window besides MainWindow to be skinnable in structure and not
  only in colour — and it cost nothing, because the controls already existed.

  Every string comes from Loc. Help is the one screen a user opens BECAUSE they
  are stuck, so meeting them in a language they do not read is the worst place
  to do it.
-->
<Window x:Class="OverlayMVP.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:OverlayMVP.Controls"
        Title="Help"
        Width="520"
        Height="640"
        MinWidth="380"
        MinHeight="300"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="False">

    <ctl:WindowShell Background="{DynamicResource Bg}"
                     BorderBrush="{DynamicResource Border}"
                     BorderThickness="1"
                     CornerRadius="8"
                     Padding="0"
                     TextElement.FontSize="{DynamicResource GlobalFontSize}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <ctl:TitleBar Grid.Row="0"
                          Background="{DynamicResource Onyx}"
                          CornerRadius="8,8,0,0"
                          Padding="10,6"
                          MouseLeftButtonDown="TitleBar_MouseDown"
                          Cursor="SizeAll">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding Loc.HelpTitle}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Amber}"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Content="✕"
                            Click="CloseBtn_Click"
                            Style="{StaticResource SmallBtn}"
                            Background="{DynamicResource Red33}"
                            BorderBrush="{DynamicResource Red}"
                            Foreground="{DynamicResource Red}"/>
                </Grid>
            </ctl:TitleBar>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- ── Hotkeys ─────────────────────────────────────── -->
                    <ctl:SectionPanel Background="{DynamicResource Panel}"
                                      BorderBrush="{DynamicResource Border}"
                                      BorderThickness="0,1,0,1"
                                      Padding="8,6">
                        <ctl:SectionPanel.Header>
                            <TextBlock Text="{Binding Loc.HelpHotkeysHead}"
                                       Style="{StaticResource SectionHeader}"
                                       Margin="0"/>
                        </ctl:SectionPanel.Header>
                        <StackPanel>
                            <TextBlock Text="{Binding Loc.HelpHotkeysIntro}"
                                       Foreground="{DynamicResource TextDim}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <!-- Auto, never a fixed width: the user
                                         chooses the font size, and at anything
                                         above the default a fixed column clips
                                         "Ctrl + Shift + O" mid-word. -->
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Ctrl + Shift + O"
                                           FontWeight="Bold" Foreground="{DynamicResource Accent}"
                                           Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Loc.HelpHotkeyShow}"
                                           TextWrapping="Wrap"/>
                            </Grid>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <!-- Auto, never a fixed width: the user
                                         chooses the font size, and at anything
                                         above the default a fixed column clips
                                         "Ctrl + Shift + O" mid-word. -->
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Ctrl + Shift + C"
                                           FontWeight="Bold" Foreground="{DynamicResource Accent}"
                                           Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Loc.HelpHotkeyClick}"
                                           TextWrapping="Wrap"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <!-- Auto, never a fixed width: the user
                                         chooses the font size, and at anything
                                         above the default a fixed column clips
                                         "Ctrl + Shift + O" mid-word. -->
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Ctrl + Shift + I"
                                           FontWeight="Bold" Foreground="{DynamicResource Accent}"
                                           Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Loc.HelpHotkeyIntel}"
                                           TextWrapping="Wrap"/>
                            </Grid>
                        </StackPanel>
                    </ctl:SectionPanel>

                    <!-- ── Panels ──────────────────────────────────────── -->
                    <ctl:SectionPanel Background="{DynamicResource Panel}"
                                      BorderBrush="{DynamicResource Border}"
                                      BorderThickness="0,0,0,1"
                                      Padding="8,6">
                        <ctl:SectionPanel.Header>
                            <TextBlock Text="{Binding Loc.HelpPanelsHead}"
                                       Style="{StaticResource SectionHeader}"
                                       Margin="0"/>
                        </ctl:SectionPanel.Header>
                        <StackPanel>
                            <TextBlock Text="{Binding Loc.HelpPanelStanding}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding Loc.HelpPanelSession}"  TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding Loc.HelpPanelSkills}"   TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding Loc.HelpPanelOrders}"   TextWrapping="Wrap"/>
                        </StackPanel>
                    </ctl:SectionPanel>

                    <!-- ── Getting started ─────────────────────────────── -->
                    <ctl:SectionPanel Background="{DynamicResource Panel}"
                                      BorderBrush="{DynamicResource Border}"
                                      BorderThickness="0,0,0,1"
                                      Padding="8,6">
                        <ctl:SectionPanel.Header>
                            <TextBlock Text="{Binding Loc.HelpSetupHead}"
                                       Style="{StaticResource SectionHeader}"
                                       Margin="0"/>
                        </ctl:SectionPanel.Header>
                        <StackPanel>
                            <TextBlock Text="{Binding Loc.HelpSetupLink}"   TextWrapping="Wrap" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding Loc.HelpSetupMulti}"  TextWrapping="Wrap" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding Loc.HelpSetupPanels}" TextWrapping="Wrap" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding Loc.HelpSetupSkins}"  TextWrapping="Wrap"/>
                        </StackPanel>
                    </ctl:SectionPanel>

                    <!-- ── Moving and resizing ─────────────────────────── -->
                    <ctl:SectionPanel Background="{DynamicResource Panel}"
                                      BorderBrush="{DynamicResource Border}"
                                      BorderThickness="0,0,0,1"
                                      Padding="8,6">
                        <ctl:SectionPanel.Header>
                            <TextBlock Text="{Binding Loc.HelpMoveHead}"
                                       Style="{StaticResource SectionHeader}"
                                       Margin="0"/>
                        </ctl:SectionPanel.Header>
                        <StackPanel>
                            <TextBlock Text="{Binding Loc.HelpMoveDrag}"  TextWrapping="Wrap" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding Loc.HelpMoveClick}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ctl:SectionPanel>

                    <Border Background="{DynamicResource Obsidian}" Padding="8,8" CornerRadius="0,0,8,8">
                        <Button Content="{Binding Loc.HelpClose}"
                                Click="CloseBtn_Click"
                                Style="{StaticResource IntelBtn}"
                                HorizontalAlignment="Right"
                                Padding="14,5"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </ctl:WindowShell>
</Window>
