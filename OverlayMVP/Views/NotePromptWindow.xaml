<!-- filename: Views/NotePromptWindow.xaml -->
<Window x:Class="OverlayMVP.Views.NotePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mark order complete"
        Width="420" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="False">

    <Border Background="#EE0D1117"
            BorderBrush="#FF1E3148"
            BorderThickness="1"
            CornerRadius="6">
        <StackPanel Margin="0">

            <!-- Title bar -->
            <Border Background="#CC111820"
                    CornerRadius="6,6,0,0"
                    Padding="10,6"
                    MouseLeftButtonDown="TitleBar_MouseDown"
                    Cursor="SizeAll">
                <TextBlock Text="📢  MARK ORDER COMPLETE"
                           FontWeight="Bold"
                           FontSize="{DynamicResource GlobalFontSize}"
                           Foreground="{StaticResource AccentGold}"/>
            </Border>

            <StackPanel Margin="14,12,14,14">
                <TextBlock Text="{Binding OrderTitle, RelativeSource={RelativeSource AncestorType=Window}}"
                           Foreground="{StaticResource TextPrimary}"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>

                <TextBlock Text="Optional note for your CEO — e.g. a killmail link or what you did."
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="{DynamicResource GlobalFontSizeXs}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,6"/>

                <TextBox x:Name="NoteBox"
                         MaxLength="500"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="70"
                         VerticalScrollBarVisibility="Auto"
                         Background="#221E3148"
                         Foreground="{StaticResource TextPrimary}"
                         BorderBrush="{StaticResource Border}"
                         BorderThickness="1"
                         FontFamily="Consolas"
                         FontSize="{DynamicResource GlobalFontSizeSm}"
                         Padding="6,4"
                         CaretBrush="{StaticResource AccentBlue}"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,12,0,0">
                    <Button Content="Cancel"
                            Click="Cancel_Click"
                            Style="{StaticResource SmallBtn}"
                            Background="#33FFFFFF"
                            BorderBrush="{StaticResource Border}"
                            Margin="0,0,8,0"/>
                    <Button Content="✔ Mark complete"
                            Click="Ok_Click"
                            IsDefault="True"
                            Style="{StaticResource SmallBtn}"
                            Background="#3366BB6A"
                            BorderBrush="{StaticResource AccentGreen}"
                            Foreground="{StaticResource AccentGreen}"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
