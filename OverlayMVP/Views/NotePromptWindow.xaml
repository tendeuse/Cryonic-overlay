<!-- filename: Views/NotePromptWindow.xaml -->
<Window x:Class="OverlayMVP.Views.NotePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Loc.NpTitleBar}"
        Width="420" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="False">

    <Border Background="{DynamicResource BgEE}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="1"
            CornerRadius="6">
        <StackPanel Margin="0">

            <!-- Title bar -->
            <Border Background="{DynamicResource Onyx}"
                    CornerRadius="6,6,0,0"
                    Padding="10,6"
                    MouseLeftButtonDown="TitleBar_MouseDown"
                    Cursor="SizeAll">
                <TextBlock Text="{Binding Loc.NpHeading}"
                           FontWeight="Bold"
                           FontSize="{DynamicResource GlobalFontSize}"
                           Foreground="{DynamicResource Amber}"/>
            </Border>

            <StackPanel Margin="14,12,14,14">
                <TextBlock Text="{Binding OrderTitle, RelativeSource={RelativeSource AncestorType=Window}}"
                           Foreground="{DynamicResource Text}"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>

                <TextBlock Text="{Binding Loc.NpHint}"
                           Foreground="{DynamicResource TextDim}"
                           FontSize="{DynamicResource GlobalFontSizeXs}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,6"/>

                <TextBox x:Name="NoteBox"
                         MaxLength="500"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="70"
                         VerticalScrollBarVisibility="Auto"
                         Background="{DynamicResource Border22}"
                         Foreground="{DynamicResource Text}"
                         BorderBrush="{DynamicResource Border}"
                         BorderThickness="1"
                         FontFamily="Consolas"
                         FontSize="{DynamicResource GlobalFontSizeSm}"
                         Padding="6,4"
                         CaretBrush="{DynamicResource Accent}"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,12,0,0">
                    <Button Content="{Binding Loc.NpCancel}"
                            Click="Cancel_Click"
                            Style="{StaticResource SmallBtn}"
                            Background="{DynamicResource White33}"
                            BorderBrush="{DynamicResource Border}"
                            Margin="0,0,8,0"/>
                    <Button Content="{Binding Loc.NpConfirm}"
                            Click="Ok_Click"
                            IsDefault="True"
                            Style="{StaticResource SmallBtn}"
                            Background="{DynamicResource Green33}"
                            BorderBrush="{DynamicResource Green}"
                            Foreground="{DynamicResource Green}"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
