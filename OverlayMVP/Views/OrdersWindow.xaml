<!-- filename: Views/OrdersWindow.xaml -->
<Window x:Class="OverlayMVP.Views.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orders — Cryonic Overlay"
        Width="420" Height="400"
        MinWidth="300" MinHeight="250"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ResizeMode="CanResize">

    <Border Background="#EE0D1117"
            BorderBrush="#FF1E3148"
            BorderThickness="1"
            CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0"
                    Background="#CC111820"
                    CornerRadius="6,6,0,0"
                    Padding="10,6"
                    MouseLeftButtonDown="TitleBar_MouseDown"
                    Cursor="SizeAll">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="📢  ORDERS"
                               FontFamily="Consolas" FontWeight="Bold"
                               FontSize="{DynamicResource GlobalFontSizeSm}"
                               Foreground="#FFFFD54F"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Content="✕"
                            Click="CloseBtn_Click"
                            Style="{StaticResource SmallBtn}"
                            Background="#33EF5350"
                            BorderBrush="#FFEF5350"
                            Foreground="#FFEF5350"/>
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="8">
                <StackPanel>

                    <TextBlock Text="{Binding OrdersStatus}"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="{DynamicResource GlobalFontSizeXs}"
                               Margin="0,0,0,6"/>

                    <ItemsControl ItemsSource="{Binding Orders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#11FFFFFF"
                                        CornerRadius="4"
                                        Padding="8,6"
                                        Margin="0,0,0,6">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Title, Mode=OneWay}"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource AccentGold}"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center"/>
                                            <Border Grid.Column="1"
                                                    Background="#221E3148"
                                                    BorderBrush="{StaticResource Border}"
                                                    BorderThickness="1"
                                                    CornerRadius="3"
                                                    Padding="5,1"
                                                    Margin="6,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TargetScope, Mode=OneWay}"
                                                           FontSize="{DynamicResource GlobalFontSizeXs}"
                                                           Foreground="{StaticResource AccentBlue}"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding Description, Mode=OneWay}"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   FontSize="{DynamicResource GlobalFontSizeSm}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Border>
</Window>
