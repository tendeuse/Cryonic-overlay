<!-- filename: Views/OrdersWindow.xaml -->
<Window x:Class="OverlayMVP.Views.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orders — Cryonic Overlay"
        Width="420" Height="400"
        MinWidth="300" MinHeight="250"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ResizeMode="CanResize">

    <Border Background="{DynamicResource BgEE}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="1"
            CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource Onyx}"
                    CornerRadius="6,6,0,0"
                    Padding="10,6"
                    MouseLeftButtonDown="TitleBar_MouseDown"
                    Cursor="SizeAll">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="📢  ORDERS"
                               FontFamily="Consolas" FontWeight="Bold"
                               FontSize="{DynamicResource GlobalFontSizeSm}"
                               Foreground="{DynamicResource Amber}"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Content="✕"
                            Click="CloseBtn_Click"
                            Style="{StaticResource SmallBtn}"
                            Background="{DynamicResource Red33}"
                            BorderBrush="{DynamicResource Red}"
                            Foreground="{DynamicResource Red}"/>
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="8">
                <StackPanel>

                    <TextBlock Text="{Binding OrdersStatus}"
                               Foreground="{DynamicResource TextDim}"
                               FontSize="{DynamicResource GlobalFontSizeXs}"
                               Margin="0,0,0,6"/>

                    <ItemsControl ItemsSource="{Binding Orders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource White11}"
                                        CornerRadius="4"
                                        Padding="8,6"
                                        Margin="0,0,0,6">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Title, Mode=OneWay}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource Amber}"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center"/>
                                            <Border Grid.Column="1"
                                                    Background="{DynamicResource Border22}"
                                                    BorderBrush="{DynamicResource Border}"
                                                    BorderThickness="1"
                                                    CornerRadius="3"
                                                    Padding="5,1"
                                                    Margin="6,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TargetScope, Mode=OneWay}"
                                                           FontSize="{DynamicResource GlobalFontSizeXs}"
                                                           Foreground="{DynamicResource Accent}"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding Description, Mode=OneWay}"
                                                   Foreground="{DynamicResource TextDim}"
                                                   FontSize="{DynamicResource GlobalFontSizeSm}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"/>

                                        <!-- Reward + slots -->
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding RewardLabel, Mode=OneWay}"
                                                       Foreground="{DynamicResource Amber}"
                                                       FontSize="{DynamicResource GlobalFontSizeXs}"
                                                       Margin="0,0,10,0"
                                                       Visibility="{Binding HasReward, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="{Binding SlotsLabel, Mode=OneWay}"
                                                       Foreground="{DynamicResource TextDim}"
                                                       FontSize="{DynamicResource GlobalFontSizeXs}"/>
                                        </StackPanel>

                                        <!-- Kill bounty -->
                                        <StackPanel Visibility="{Binding IsBounty, Converter={StaticResource BoolToVis}}"
                                                    Margin="0,4,0,0">
                                            <TextBlock Text="{Binding BountyRewardLabel, Mode=OneWay}"
                                                       Foreground="{DynamicResource Amber}"
                                                       FontSize="{DynamicResource GlobalFontSizeXs}"/>
                                            <TextBlock Text="{Binding BountyProgressLabel, Mode=OneWay}"
                                                       Foreground="{DynamicResource Text}"
                                                       FontSize="{DynamicResource GlobalFontSizeXs}"/>
                                            <!-- What actually qualifies for a payout -->
                                            <TextBlock Text="{Binding BountyTargetLabel, Mode=OneWay}"
                                                       Foreground="{DynamicResource Text}"
                                                       FontSize="{DynamicResource GlobalFontSizeXs}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding BountyRulesLabel, Mode=OneWay}"
                                                       Foreground="{DynamicResource TextDim}"
                                                       FontSize="{DynamicResource GlobalFontSizeXs}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding BountyAutoNote, Mode=OneWay}"
                                                       Foreground="{DynamicResource TextDim}"
                                                       FontSize="{DynamicResource GlobalFontSizeXs}"
                                                       Opacity="0.8" TextWrapping="Wrap"/>
                                            <Button Content="Submit kill"
                                                    Style="{StaticResource SmallBtn}"
                                                    Background="{DynamicResource Amber33}"
                                                    BorderBrush="{DynamicResource Amber}"
                                                    HorizontalAlignment="Left"
                                                    Margin="0,4,0,0"
                                                    Command="{Binding DataContext.SubmitKillCommand,
                                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding CanSubmitKill, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>

                                        <!-- Standing goal -->
                                        <StackPanel Visibility="{Binding IsStandingGoal, Converter={StaticResource BoolToVis}}"
                                                    Margin="0,4,0,0">
                                            <TextBlock Text="{Binding StandingGoalLabel, Mode=OneWay}"
                                                       Foreground="{DynamicResource Amber}"
                                                       FontSize="{DynamicResource GlobalFontSizeXs}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding StandingProgressLabel, Mode=OneWay}"
                                                       Foreground="{DynamicResource Text}"
                                                       FontSize="{DynamicResource GlobalFontSizeXs}"/>
                                            <TextBlock Text="{Binding StandingTokenNote, Mode=OneWay}"
                                                       Foreground="{DynamicResource TextDim}"
                                                       FontSize="{DynamicResource GlobalFontSizeXs}"
                                                       Opacity="0.8" TextWrapping="Wrap"/>
                                            <Button Content="Claim standing"
                                                    Style="{StaticResource SmallBtn}"
                                                    Background="{DynamicResource Emerald33}"
                                                    BorderBrush="{DynamicResource Amber}"
                                                    HorizontalAlignment="Left"
                                                    Margin="0,4,0,0"
                                                    Command="{Binding DataContext.ClaimStandingCommand,
                                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding CanClaimStanding, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>

                                        <!-- State + actions -->
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding StateLabel, Mode=OneWay}"
                                                       Foreground="{DynamicResource Green}"
                                                       FontSize="{DynamicResource GlobalFontSizeXs}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,10,0"/>
                                            <Button Content="Join"
                                                    Style="{StaticResource SmallBtn}"
                                                    Background="{DynamicResource Accent33}"
                                                    BorderBrush="{DynamicResource Accent}"
                                                    Margin="0,0,6,0"
                                                    Command="{Binding DataContext.JoinOrderCommand,
                                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding CanJoin, Converter={StaticResource BoolToVis}}"/>
                                            <Button Content="Mark complete"
                                                    Style="{StaticResource SmallBtn}"
                                                    Background="{DynamicResource Green33}"
                                                    BorderBrush="{DynamicResource Green}"
                                                    Margin="0,0,6,0"
                                                    Command="{Binding DataContext.CompleteOrderCommand,
                                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding CanComplete, Converter={StaticResource BoolToVis}}"/>
                                            <Button Content="Leave"
                                                    Style="{StaticResource SmallBtn}"
                                                    Background="{DynamicResource Red33}"
                                                    BorderBrush="{DynamicResource Red}"
                                                    Command="{Binding DataContext.LeaveOrderCommand,
                                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding CanLeave, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Border>
</Window>
