<!-- filename: Views/StandingGuideWindow.xaml -->
<Window x:Class="OverlayMVP.Views.StandingGuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OverlayMVP.Converters"
        Title="{Binding Loc.SgTitleBar}"
        Width="480" Height="650"
        MinWidth="350" MinHeight="400"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ResizeMode="CanResize">

    <Window.Resources>
        <local:ZeroToCollapsedConverter    x:Key="ZeroToCollapsed"/>
        <local:StepStatusEmojiConverter    x:Key="StepStatusEmojiConverter"/>
        <local:StepProgressConverter       x:Key="StepProgressConverter"/>
        <local:StepIsActiveConverter       x:Key="StepIsActive"/>

        <!-- Dark-themed Expander used for each step card -->
        <Style x:Key="StepExpander" TargetType="Expander">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border x:Name="Root"
                                Background="{DynamicResource Bg0A}"
                                BorderBrush="{DynamicResource Border22}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Margin="0,0,0,3">
                            <StackPanel>
                                <!-- Clickable header row -->
                                <ToggleButton
                                    IsChecked="{Binding IsExpanded, Mode=TwoWay,
                                        RelativeSource={RelativeSource TemplatedParent}}"
                                    Padding="7,5"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    HorizontalContentAlignment="Stretch"
                                    Focusable="False"
                                    Cursor="Hand">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}"
                                                    CornerRadius="4,4,0,0">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource White11}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Stretch"/>
                                </ToggleButton>
                                <!-- Expanded body -->
                                <ContentPresenter x:Name="Body"
                                                  Focusable="False"
                                                  Visibility="Collapsed"
                                                  Margin="7,0,7,7"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Accent33}"/>
                                <Setter TargetName="Body" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource BgEE}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="1"
            CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource Onyx}"
                    CornerRadius="6,6,0,0"
                    Padding="10,6"
                    MouseLeftButtonDown="TitleBar_MouseDown"
                    Cursor="SizeAll">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding Loc.SgTitle}"
                               FontFamily="Consolas" FontWeight="Bold"
                               FontSize="{DynamicResource GlobalFontSizeSm}"
                               Foreground="{DynamicResource Amber}"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Content="✕"
                            Click="CloseBtn_Click"
                            Style="{StaticResource SmallBtn}"
                            Background="{DynamicResource Red33}"
                            BorderBrush="{DynamicResource Red}"
                            Foreground="{DynamicResource Red}"/>
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="8">
                <StackPanel>

                    <!-- ESI Standing status bar -->
                    <Border Background="{DynamicResource Bg11}" CornerRadius="3" Padding="6,4" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding StandingsStatus}"
                                       Foreground="{DynamicResource TextDim}"
                                       FontSize="{DynamicResource GlobalFontSizeXs}" VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="⟳ ESI"
                                    Command="{Binding RefreshStandingsCommand}"
                                    Style="{StaticResource SmallBtn}"
                                    Background="{DynamicResource Border22}"
                                    BorderBrush="{DynamicResource Accent}"
                                    ToolTip="{Binding Loc.SgTipRefreshEsi}"/>
                        </Grid>
                    </Border>

                    <!-- Auto-play briefing on standing advance -->
                    <CheckBox Content="{Binding Loc.SgAutoplay}"
                              IsChecked="{Binding AutoplayBriefingOnAdvance}"
                              Foreground="{DynamicResource TextDim}"
                              FontSize="{DynamicResource GlobalFontSizeXs}"
                              Margin="2,0,0,6"
                              ToolTip="{Binding Loc.SgTipAutoplay}"/>

                    <!-- Skill modifiers — auto-loaded from ESI -->
                    <Border Background="{DynamicResource Accent0A}" BorderBrush="{DynamicResource Border22}"
                            BorderThickness="1" CornerRadius="3"
                            Padding="8,5" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Connections -->
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="{Binding Loc.SgSkillConnections}"
                                           Foreground="{DynamicResource Accent}"
                                           FontSize="{DynamicResource GlobalFontSizeXs}"
                                           ToolTip="{Binding Loc.SgTipConnections}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBlock Text="{Binding Loc.SgLevelPrefix}"
                                               Foreground="{DynamicResource TextDim}"
                                               FontSize="{DynamicResource GlobalFontSizeSm}"/>
                                    <TextBlock Text="{Binding ConnectionsSkill}"
                                               Foreground="{DynamicResource Accent}"
                                               FontSize="{DynamicResource GlobalFontSizeSm}"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="/5"
                                               Foreground="{DynamicResource TextDim}"
                                               FontSize="{DynamicResource GlobalFontSizeXs}"
                                               VerticalAlignment="Bottom" Margin="1,0,0,1"/>
                                </StackPanel>
                            </StackPanel>
                            <!-- Diplomacy -->
                            <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                <TextBlock Text="{Binding Loc.SgSkillDiplomacy}"
                                           Foreground="{DynamicResource Amber}"
                                           FontSize="{DynamicResource GlobalFontSizeXs}"
                                           ToolTip="{Binding Loc.SgTipDiplomacy}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBlock Text="{Binding Loc.SgLevelPrefix}"
                                               Foreground="{DynamicResource TextDim}"
                                               FontSize="{DynamicResource GlobalFontSizeSm}"/>
                                    <TextBlock Text="{Binding DiplomacySkill}"
                                               Foreground="{DynamicResource Amber}"
                                               FontSize="{DynamicResource GlobalFontSizeSm}"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="/5"
                                               Foreground="{DynamicResource TextDim}"
                                               FontSize="{DynamicResource GlobalFontSizeXs}"
                                               VerticalAlignment="Bottom" Margin="1,0,0,1"/>
                                </StackPanel>
                            </StackPanel>
                            <!-- Social -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding Loc.SgSkillSocial}"
                                           Foreground="{DynamicResource Green}"
                                           FontSize="{DynamicResource GlobalFontSizeXs}"
                                           ToolTip="{Binding Loc.SgTipSocial}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBlock Text="{Binding Loc.SgLevelPrefix}"
                                               Foreground="{DynamicResource TextDim}"
                                               FontSize="{DynamicResource GlobalFontSizeSm}"/>
                                    <TextBlock Text="{Binding SocialSkill}"
                                               Foreground="{DynamicResource Green}"
                                               FontSize="{DynamicResource GlobalFontSizeSm}"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="/5"
                                               Foreground="{DynamicResource TextDim}"
                                               FontSize="{DynamicResource GlobalFontSizeXs}"
                                               VerticalAlignment="Bottom" Margin="1,0,0,1"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ── Access thresholds ─────────────────────────────── -->
                    <Border Background="{DynamicResource White22}" CornerRadius="4" Padding="10,8" Margin="0,6,0,10">
                        <StackPanel>
                            <TextBlock Text="{Binding Loc.SgAgentAccess}"
                                       Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>

                            <TextBlock Margin="0,0,0,6"
                                       FontSize="{DynamicResource GlobalFontSizeXs}"
                                       Foreground="{DynamicResource TextDim}">
                                <Run Text="{Binding Loc.SgCorpStanding, Mode=OneWay}"/>
                                <Run Text="{Binding CorpStandingLabel, Mode=OneWay}"
                                     Foreground="{DynamicResource Accent}" FontWeight="Bold"/>
                            </TextBlock>

                            <TextBlock Text="{Binding CorpMissionsToNextLabel, Mode=OneWay}"
                                       FontSize="{DynamicResource GlobalFontSizeSm}"
                                       Foreground="{DynamicResource Amber}"
                                       TextWrapping="Wrap" Margin="0,0,0,2"/>

                            <TextBlock Text="{Binding FactionStorylinesToNextLabel, Mode=OneWay}"
                                       FontSize="{DynamicResource GlobalFontSizeSm}"
                                       Foreground="{DynamicResource Text}"
                                       TextWrapping="Wrap" Margin="0,0,0,6"/>

                            <ItemsControl ItemsSource="{Binding StandingProgress}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Label, Mode=OneWay}"
                                                       FontSize="{DynamicResource GlobalFontSizeSm}"
                                                       Foreground="{DynamicResource Text}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Value, StringFormat={}{0:F1}, Mode=OneWay}"
                                                       FontSize="{DynamicResource GlobalFontSizeXs}"
                                                       Foreground="{DynamicResource TextDim}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding StandingCaveatLabel, Mode=OneWay}"
                                       FontSize="{DynamicResource GlobalFontSizeXs}"
                                       Foreground="{DynamicResource TextDim}"
                                       Opacity="0.75" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Faction selector -->
                    <TextBlock Text="{Binding Loc.SgSelectFaction}" Foreground="{DynamicResource TextDim}"
                               FontSize="{DynamicResource GlobalFontSizeXs}" Margin="0,0,0,4"/>
                    <ListBox ItemsSource="{Binding CatalogueFactions}"
                             SelectedItem="{Binding SelectedCatalogueFaction}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             VirtualizingStackPanel.IsVirtualizing="False"
                             PreviewMouseWheel="FactionList_PreviewMouseWheel">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="4,3"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                    BorderThickness="0" CornerRadius="2"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Border22}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DuskBlue}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontFamily="Consolas" FontSize="{DynamicResource GlobalFontSizeSm}" FontWeight="Bold">
                                    <Run Text="{Binding Icon, Mode=OneWay}"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding FactionName, Mode=OneWay}"
                                         Foreground="{Binding Colour, Converter={StaticResource StrBrush}}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Margin="0,10,0,4"
                               FontWeight="Bold"
                               FontSize="{DynamicResource GlobalFontSizeSm}"
                               Foreground="{DynamicResource Amber}"
                               Text="{Binding SelectedCatalogueFaction.FactionName, StringFormat='▼ {0} — GUIDE'}"/>

                    <!-- Tutorial panel (shown when faction is selected) -->
                    <StackPanel Visibility="{Binding SelectedCatalogueFaction,
                                    Converter={StaticResource NullToVisibility}}"
                                Margin="0,8,0,0">

                        <!-- Faction intro -->
                        <Border Background="{DynamicResource Accent1A}" BorderBrush="{DynamicResource Accent22}"
                                BorderThickness="0,0,0,0" CornerRadius="3" Padding="6,5"
                                Margin="0,0,0,6">
                            <TextBlock Text="{Binding SelectedCatalogueFaction.IntroText, Mode=OneWay}"
                                       Foreground="{DynamicResource SteelGrey}" FontSize="{DynamicResource GlobalFontSizeXs}" TextWrapping="Wrap"
                                       LineHeight="14"/>
                        </Border>

                        <!-- Manual standing input (fallback when ESI not linked) -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Loc.SgYourStanding}"
                                       Foreground="{DynamicResource TextDim}"
                                       FontSize="{DynamicResource GlobalFontSizeXs}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1"
                                     x:Name="ManualStandingBox"
                                     Text="{Binding CurrentFactionStanding, Mode=OneWay,
                                            StringFormat={}{0:0.00}}"
                                     Background="{DynamicResource BgFF}"
                                     Foreground="{Binding StandingColour,
                                         Converter={StaticResource StrBrush}}"
                                     BorderBrush="{DynamicResource Border33}" BorderThickness="1"
                                     Padding="4,2" FontSize="{DynamicResource GlobalFontSizeSm}" FontWeight="Bold"
                                     Margin="4,0"/>
                            <Button Grid.Column="2" Content="{Binding Loc.SgBtnSet}"
                                    Click="ManualStandingSet_Click"
                                    Style="{StaticResource SmallBtn}"
                                    Background="{DynamicResource Border22}"
                                    BorderBrush="{DynamicResource Amber}"/>
                        </Grid>

                        <!-- Standing label -->
                        <TextBlock HorizontalAlignment="Center" Margin="0,0,0,8">
                            <Run Text="{Binding Loc.SgStandingPrefix, Mode=OneWay}" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource GlobalFontSizeXs}"/>
                            <Run Text="{Binding StandingLabel, Mode=OneWay}"
                                 Foreground="{Binding StandingColour, Converter={StaticResource StrBrush}}"
                                 FontWeight="Bold" FontSize="{DynamicResource GlobalFontSizeSm}"/>
                            <Run Text=" (" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource GlobalFontSizeXs}"/>
                            <Run Text="{Binding CurrentFactionStanding, Mode=OneWay,
                                        StringFormat={}{0:+0.00;-0.00;0.00}}"
                                 Foreground="{Binding StandingColour, Converter={StaticResource StrBrush}}"
                                 FontSize="{DynamicResource GlobalFontSizeXs}"/>
                            <Run Text=")" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource GlobalFontSizeXs}"/>
                        </TextBlock>

                        <!-- All steps — current one pre-expanded, others collapsed -->
                        <TextBlock Text="{Binding Loc.SgSteps}" FontSize="{DynamicResource GlobalFontSizeXs}" FontWeight="Bold"
                                   Foreground="{DynamicResource TextDim}" Margin="0,0,0,4"/>

                        <ItemsControl ItemsSource="{Binding SelectedCatalogueFaction.Steps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Style="{StaticResource StepExpander}">

                                        <!-- IsExpanded: True for the active step, False for others -->
                                        <Expander.IsExpanded>
                                            <MultiBinding Converter="{StaticResource StepIsActive}" Mode="OneWay">
                                                <Binding Path="DataContext.CurrentFactionStanding"
                                                         RelativeSource="{RelativeSource AncestorType=Window}"
                                                         Mode="OneWay"/>
                                                <Binding Path="." Mode="OneWay"/>
                                            </MultiBinding>
                                        </Expander.IsExpanded>

                                        <!-- Compact header: visible when collapsed too -->
                                        <Expander.Header>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           FontSize="{DynamicResource GlobalFontSizeSm}"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource StepStatusEmojiConverter}" Mode="OneWay">
                                                            <Binding Path="DataContext.CurrentFactionStanding"
                                                                     RelativeSource="{RelativeSource AncestorType=Window}"
                                                                     Mode="OneWay"/>
                                                            <Binding Path="." Mode="OneWay"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <Border Grid.Column="1"
                                                        Background="{Binding LevelColour, Converter={StaticResource StrBrush}}"
                                                        CornerRadius="2" Padding="4,1" Margin="0,0,6,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding LevelLabel, Mode=OneWay}"
                                                               Foreground="{DynamicResource BgFF}"
                                                               FontSize="{DynamicResource GlobalFontSizeXs}"
                                                               FontWeight="Bold"/>
                                                </Border>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding StepLabel, Mode=OneWay}"
                                                           Foreground="{DynamicResource Text}"
                                                           FontWeight="Bold"
                                                           FontSize="{DynamicResource GlobalFontSizeSm}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3"
                                                           Foreground="{DynamicResource TextFaint}"
                                                           FontSize="{DynamicResource GlobalFontSizeXs}"
                                                           VerticalAlignment="Center" Margin="6,0,0,0">
                                                    <Run Text="req "/>
                                                    <Run Text="{Binding StandingRequired, Mode=OneWay, StringFormat={}{0:0.0}}"/>
                                                </TextBlock>
                                            </Grid>
                                        </Expander.Header>

                                        <!-- Full step details (shown when expanded) -->
                                        <StackPanel Margin="0,4,0,0">

                                            <!-- Step header row: emoji + label + level badge + type -->
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           FontSize="{DynamicResource GlobalFontSizeSm}" VerticalAlignment="Center">
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource StepStatusEmojiConverter}"
                                                                      Mode="OneWay">
                                                            <Binding Path="DataContext.CurrentFactionStanding"
                                                                     RelativeSource="{RelativeSource AncestorType=Window}"
                                                                     Mode="OneWay"/>
                                                            <Binding Path="." Mode="OneWay"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding StepLabel, Mode=OneWay}"
                                                           Foreground="{DynamicResource Text}"
                                                           FontWeight="Bold" FontSize="{DynamicResource GlobalFontSizeSm}"/>
                                                <Border Grid.Column="2"
                                                        Background="{Binding LevelColour,
                                                            Converter={StaticResource StrBrush}}"
                                                        CornerRadius="2" Padding="4,1" Margin="4,0,0,0">
                                                    <TextBlock Text="{Binding LevelLabel, Mode=OneWay}"
                                                               Foreground="{DynamicResource BgFF}"
                                                               FontSize="{DynamicResource GlobalFontSizeXs}" FontWeight="Bold"/>
                                                </Border>
                                                <Border Grid.Column="3"
                                                        Background="{DynamicResource Bg11}" BorderBrush="{DynamicResource Border22}"
                                                        BorderThickness="1" CornerRadius="2"
                                                        Padding="4,1" Margin="3,0,0,0">
                                                    <TextBlock Text="{Binding TypeLabel, Mode=OneWay}"
                                                               Foreground="{DynamicResource TextDim}"
                                                               FontSize="{DynamicResource GlobalFontSizeXs}"/>
                                                </Border>
                                            </Grid>

                                            <!-- Standing requirement row -->
                                            <Grid Margin="0,0,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0">
                                                    <Run Text="{Binding Loc.SgRequires, Mode=OneWay}" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource GlobalFontSizeXs}"/>
                                                    <Run Text="{Binding StandingRequired, Mode=OneWay,
                                                                StringFormat={}{0:+0.0;-0.0;0.0}}"
                                                         Foreground="{Binding LevelColour,
                                                             Converter={StaticResource StrBrush}}"
                                                         FontWeight="Bold" FontSize="{DynamicResource GlobalFontSizeXs}"/>
                                                    <Run Text="{Binding Loc.SgGoalArrow, Mode=OneWay}" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource GlobalFontSizeXs}"/>
                                                    <Run Text="{Binding StandingGoal, Mode=OneWay,
                                                                StringFormat={}{0:+0.0;-0.0;0.0}}"
                                                         Foreground="{DynamicResource Amber}" FontWeight="Bold" FontSize="{DynamicResource GlobalFontSizeXs}"/>
                                                </TextBlock>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding GainLabel, Mode=OneWay}"
                                                           Foreground="{DynamicResource Green}" FontSize="{DynamicResource GlobalFontSizeXs}"/>
                                            </Grid>

                                            <!-- Progress bar -->
                                            <ProgressBar Height="4" Margin="0,0,0,5"
                                                         Minimum="0" Maximum="1"
                                                         Foreground="{Binding LevelColour, Converter={StaticResource StrBrush}}"
                                                         Background="{DynamicResource Border22}"
                                                         BorderThickness="0">
                                                <ProgressBar.Value>
                                                    <MultiBinding Converter="{StaticResource StepProgressConverter}"
                                                                  Mode="OneWay">
                                                        <Binding Path="DataContext.CurrentFactionStanding"
                                                                 RelativeSource="{RelativeSource AncestorType=ItemsControl}"
                                                                 Mode="OneWay"/>
                                                        <Binding Path="." Mode="OneWay"/>
                                                    </MultiBinding>
                                                </ProgressBar.Value>
                                            </ProgressBar>

                                            <!-- WHY text -->
                                            <TextBlock Text="{Binding WhyText, Mode=OneWay}"
                                                       Foreground="{DynamicResource SteelGrey}"
                                                       FontSize="{DynamicResource GlobalFontSizeXs}" TextWrapping="Wrap"
                                                       LineHeight="13" Margin="0,0,0,4"/>

                                            <!-- TIP text -->
                                            <Border Background="{DynamicResource Green0A}" CornerRadius="2"
                                                    Padding="5,3" Margin="0,0,0,4"
                                                    Visibility="{Binding TipText,
                                                        Converter={StaticResource NullToVisibility}}">
                                                <TextBlock Text="{Binding TipText, Mode=OneWay}"
                                                           Foreground="{DynamicResource SkyBlue}"
                                                           FontSize="{DynamicResource GlobalFontSizeXs}" TextWrapping="Wrap"
                                                           LineHeight="12"/>
                                            </Border>

                                            <!-- Corporation highlight + Agent / Station -->
                                            <StackPanel Margin="0,0,0,3">
                                                <!-- "Run for" corp -->
                                                <Border Background="{DynamicResource Amber1A}" BorderBrush="{DynamicResource Amber33}"
                                                        BorderThickness="1" CornerRadius="3"
                                                        Padding="6,4" Margin="0,0,0,5"
                                                        Visibility="{Binding HasCorporation, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel>
                                                        <TextBlock>
                                                            <Run Text="{Binding Loc.SgRunFor, Mode=OneWay}" Foreground="{DynamicResource Amber}"
                                                                 FontSize="{DynamicResource GlobalFontSizeXs}" FontWeight="Bold"/>
                                                            <Run Text="{Binding Corporation, Mode=OneWay}"
                                                                 Foreground="{DynamicResource White}"
                                                                 FontSize="{DynamicResource GlobalFontSizeXs}" FontWeight="Bold"/>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding CorpNote, Mode=OneWay}"
                                                                   Foreground="{DynamicResource SteelGrey}"
                                                                   FontSize="{DynamicResource GlobalFontSizeXs}"
                                                                   TextWrapping="Wrap" LineHeight="12"
                                                                   Margin="0,2,0,0"
                                                                   Visibility="{Binding CorpNote, Converter={StaticResource NullToVisibility}}"/>
                                                    </StackPanel>
                                                </Border>
                                                <!-- Ship spec recommendation -->
                                                <Border Background="{DynamicResource Accent0A}" BorderBrush="{DynamicResource Accent22}"
                                                        BorderThickness="1" CornerRadius="3"
                                                        Padding="6,5" Margin="0,0,0,5"
                                                        Visibility="{Binding HasSpec, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel>
                                                        <!-- Ships row — clickable fit buttons -->
                                                        <WrapPanel Margin="0,0,0,3" VerticalAlignment="Center">
                                                            <TextBlock Text="🚀 " Foreground="{DynamicResource Accent}"
                                                                       FontSize="{DynamicResource GlobalFontSizeXs}"
                                                                       VerticalAlignment="Center" Margin="0,0,2,0"/>
                                                            <ItemsControl ItemsSource="{Binding Spec.Ships}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button Content="{Binding}"
                                                                                ToolTip="{Binding Loc.SgTipFit}"
                                                                                Command="{Binding DataContext.OpenShipFitCommand,
                                                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                CommandParameter="{Binding}"
                                                                                Style="{StaticResource SmallBtn}"
                                                                                Background="{DynamicResource Accent22}"
                                                                                BorderBrush="{DynamicResource Accent}"
                                                                                Foreground="{DynamicResource Accent}"
                                                                                Margin="0,0,3,2"
                                                                                Cursor="Hand"/>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </WrapPanel>
                                                        <!-- Stats row: DPS · EHP · Cargo -->
                                                        <WrapPanel Margin="0,0,0,3">
                                                            <!-- DPS -->
                                                            <Border Background="{DynamicResource Green15}" CornerRadius="2" Padding="4,1" Margin="0,0,4,2">
                                                                <TextBlock>
                                                                    <Run Text="⚔ " Foreground="{DynamicResource Green}" FontSize="{DynamicResource GlobalFontSizeXs}"/>
                                                                    <Run Text="{Binding Spec.DpsLabel, Mode=OneWay}"
                                                                         Foreground="{DynamicResource Green}" FontSize="{DynamicResource GlobalFontSizeXs}" FontWeight="Bold"/>
                                                                </TextBlock>
                                                            </Border>
                                                            <!-- EHP -->
                                                            <Border Background="{DynamicResource Accent15}" CornerRadius="2" Padding="4,1" Margin="0,0,4,2">
                                                                <TextBlock>
                                                                    <Run Text="🛡 " Foreground="{DynamicResource Accent}" FontSize="{DynamicResource GlobalFontSizeXs}"/>
                                                                    <Run Text="{Binding Spec.EhpLabel, Mode=OneWay}"
                                                                         Foreground="{DynamicResource Accent}" FontSize="{DynamicResource GlobalFontSizeXs}" FontWeight="Bold"/>
                                                                </TextBlock>
                                                            </Border>
                                                            <!-- Cargo (only shown when needed) -->
                                                            <Border Background="{DynamicResource Amber15}" CornerRadius="2" Padding="4,1" Margin="0,0,4,2"
                                                                    Visibility="{Binding Spec.NeedsCargo, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock>
                                                                    <Run Text="📦 " Foreground="{DynamicResource Amber}" FontSize="{DynamicResource GlobalFontSizeXs}"/>
                                                                    <Run Text="{Binding Spec.CargoLabel, Mode=OneWay}"
                                                                         Foreground="{DynamicResource Amber}" FontSize="{DynamicResource GlobalFontSizeXs}" FontWeight="Bold"/>
                                                                </TextBlock>
                                                            </Border>
                                                        </WrapPanel>
                                                        <!-- Resist profile -->
                                                        <TextBlock Margin="0,0,0,2"
                                                                   Visibility="{Binding Spec.ResistList, Converter={StaticResource NullToVisibility}}">
                                                            <Run Text="{Binding Loc.SgTank, Mode=OneWay}" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource GlobalFontSizeXs}"/>
                                                            <Run Text="{Binding Spec.ResistList, Mode=OneWay}"
                                                                 Foreground="{DynamicResource Red}" FontSize="{DynamicResource GlobalFontSizeXs}" FontWeight="Bold"/>
                                                            <Run Text=" — " Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource GlobalFontSizeXs}"/>
                                                            <Run Text="{Binding Spec.EnemyNote, Mode=OneWay}"
                                                                 Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource GlobalFontSizeXs}"/>
                                                        </TextBlock>
                                                        <!-- Fit note -->
                                                        <TextBlock Text="{Binding Spec.FitNote, Mode=OneWay}"
                                                                   Foreground="{DynamicResource SteelGrey}" FontSize="{DynamicResource GlobalFontSizeXs}"
                                                                   TextWrapping="Wrap" LineHeight="12"
                                                                   Visibility="{Binding Spec.FitNote, Converter={StaticResource NullToVisibility}}"/>
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock>
                                                    <Run Text="{Binding Loc.SgAgentPrefix, Mode=OneWay}" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource GlobalFontSizeXs}"/>
                                                    <Run Text="{Binding Agent, Mode=OneWay}"
                                                         Foreground="{DynamicResource Accent}" FontSize="{DynamicResource GlobalFontSizeXs}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Station, Mode=OneWay}"
                                                           Foreground="{DynamicResource TextFaint}" FontSize="{DynamicResource GlobalFontSizeXs}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Station, Mode=OneWay}"/>
                                                <TextBlock>
                                                    <Run Text="{Binding Loc.SgRegionPrefix, Mode=OneWay}" Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource GlobalFontSizeXs}"/>
                                                    <Run Text="{Binding Region, Mode=OneWay}"
                                                         Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource GlobalFontSizeXs}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- Enemy warnings -->
                                            <ItemsControl ItemsSource="{Binding EnemyWarnings}"
                                                          Visibility="{Binding EnemyWarnings.Count,
                                                              Converter={StaticResource ZeroToCollapsed}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource Red1A}"
                                                                BorderBrush="{Binding Colour,
                                                                    Converter={StaticResource StrBrush}}"
                                                                BorderThickness="0,0,0,1"
                                                                Padding="5,3" Margin="0,2,0,0">
                                                            <TextBlock>
                                                                <Run Text="⚠ " FontSize="{DynamicResource GlobalFontSizeXs}"
                                                                     Foreground="{Binding Colour,
                                                                         Converter={StaticResource StrBrush}}"/>
                                                                <Run Text="{Binding FactionName, Mode=OneWay}"
                                                                     FontWeight="Bold" FontSize="{DynamicResource GlobalFontSizeXs}"
                                                                     Foreground="{Binding Colour,
                                                                         Converter={StaticResource StrBrush}}"/>
                                                                <Run Text=" " FontSize="{DynamicResource GlobalFontSizeXs}"/>
                                                                <Run Text="{Binding StandingLoss, Mode=OneWay,
                                                                            StringFormat={}{0:0.00}}"
                                                                     Foreground="{DynamicResource Red}" FontSize="{DynamicResource GlobalFontSizeXs}"
                                                                     FontWeight="Bold"/>
                                                                <Run Text=" / run — " FontSize="{DynamicResource GlobalFontSizeXs}"
                                                                     Foreground="{DynamicResource TextDim}"/>
                                                                <Run Text="{Binding Note, Mode=OneWay}"
                                                                     Foreground="{DynamicResource TextDim}" FontSize="{DynamicResource GlobalFontSizeXs}"/>
                                                            </TextBlock>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Action buttons -->
                                            <Grid Margin="0,5,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Copy key info to clipboard -->
                                                <Button Grid.Column="0" Content="{Binding Loc.SgBtnCopy}"
                                                        ToolTip="{Binding Loc.SgTipCopy}"
                                                        Command="{Binding DataContext.CopyCurrentStepInfoCommand,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                                        Style="{StaticResource SmallBtn}"
                                                        Background="{DynamicResource Accent22}"
                                                        BorderBrush="{DynamicResource Accent}"
                                                        Foreground="{DynamicResource Accent}"
                                                        Margin="0,0,3,0"/>
                                                <TextBlock Grid.Column="1"/>
                                                <Button Grid.Column="2" Content="{Binding Loc.SgBtnOrder}"
                                                        ToolTip="{Binding Loc.SgTipOrder}"
                                                        Command="{Binding DataContext.BroadcastStepAsOrderCommand,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SmallBtn}"
                                                        Background="{DynamicResource Ivory}"
                                                        BorderBrush="{DynamicResource Amber}"
                                                        Foreground="{DynamicResource Amber}"
                                                        Visibility="{Binding DataContext.IsSuperUser,
                                                            Converter={StaticResource BoolToVis},
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                                        Margin="0,0,3,0"/>
                                                <Button Grid.Column="3" Content="▶ Mission"
                                                        ToolTip="{Binding Loc.SgTipBriefing}"
                                                        Command="{Binding DataContext.PlayBriefingCommand,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SmallBtn}"
                                                        Background="{DynamicResource Green22}"
                                                        BorderBrush="{DynamicResource Green}"
                                                        Foreground="{DynamicResource Green}"/>
                                            </Grid>

                                            <TextBlock Text="{Binding DataContext.OrderBroadcastStatus,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                                       TextWrapping="Wrap"
                                                       FontSize="{DynamicResource GlobalFontSizeXs}"
                                                       Foreground="{DynamicResource Amber}"
                                                       Margin="0,4,0,0"/>

                                        </StackPanel>

                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>


                    </StackPanel><!-- end tutorial panel -->

                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Border>
</Window>
