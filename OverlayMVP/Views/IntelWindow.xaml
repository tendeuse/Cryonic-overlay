<!-- filename: Views/IntelWindow.xaml -->
<Window x:Class="OverlayMVP.Views.IntelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pilot Intel — Cryonic Overlay"
        Width="420" Height="600"
        MinWidth="280" MinHeight="250"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="CanResize">

    <Border Background="#EE0D1117"
            BorderBrush="#FF1E3148"
            BorderThickness="1"
            CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- title bar -->
                <RowDefinition Height="Auto"/>   <!-- search -->
                <RowDefinition Height="Auto"/>   <!-- time range -->
                <RowDefinition Height="*"/>      <!-- result -->
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0"
                    Background="#CC111820"
                    CornerRadius="6,6,0,0"
                    Padding="10,6"
                    MouseLeftButtonDown="TitleBar_MouseDown"
                    MouseMove="TitleBar_MouseMove"
                    MouseLeftButtonUp="TitleBar_MouseUp"
                    Cursor="SizeAll">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="🔍  PILOT INTEL"
                               FontFamily="Consolas" FontWeight="Bold"
                               FontSize="{DynamicResource GlobalFontSizeSm}" Foreground="#FFEF5350"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            x:Name="ClearBtn"
                            Content="Clear"
                            Click="Clear_Click"
                            FontFamily="Consolas" FontSize="{DynamicResource GlobalFontSizeXs}"
                            Background="#22FFFFFF" Foreground="#FF8A99AA"
                            BorderBrush="#FF1E3148" BorderThickness="1"
                            Padding="6,2" Cursor="Hand" Margin="0,0,6,0"/>
                    <Button Grid.Column="2"
                            Content="✕"
                            Click="Close_Click"
                            FontFamily="Consolas" FontSize="{DynamicResource GlobalFontSizeXs}"
                            Background="#33EF5350" Foreground="#FFEF5350"
                            BorderBrush="#FFEF5350" BorderThickness="1"
                            Padding="6,2" Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- Search bar -->
            <Border Grid.Row="1" Background="#CC0D1117" Padding="8,6" BorderBrush="#FF1E3148" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox"
                             Grid.Column="0"
                             Background="#FF111820"
                             Foreground="#FFCCD6F6"
                             BorderBrush="#FF1E3148"
                             BorderThickness="1"
                             FontFamily="Consolas"
                             FontSize="{DynamicResource GlobalFontSizeSm}"
                             Padding="6,4"
                             CaretBrush="#FF4FC3F7"
                             VerticalContentAlignment="Center"
                             KeyDown="SearchBox_KeyDown"/>
                    <Button Grid.Column="1"
                            x:Name="SearchBtn"
                            Content="Search"
                            Click="Search_Click"
                            FontFamily="Consolas" FontSize="{DynamicResource GlobalFontSizeXs}"
                            Background="#33EF5350" Foreground="#FFEF5350"
                            BorderBrush="#FFEF5350" BorderThickness="1"
                            Padding="10,4" Cursor="Hand" Margin="6,0,0,0"/>
                </Grid>
            </Border>

            <!-- Time range selector -->
            <Border Grid.Row="2" Background="#CC0D1117"
                    BorderBrush="#FF1E3148" BorderThickness="0,0,0,1"
                    Padding="8,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Lookback: "
                               Foreground="#FF8A99AA" FontFamily="Consolas"
                               FontSize="{DynamicResource GlobalFontSizeXs}"
                               VerticalAlignment="Center"/>
                    <Slider Grid.Column="1"
                            x:Name="LookbackSlider"
                            Minimum="14" Maximum="365" Value="90"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            VerticalAlignment="Center"
                            ValueChanged="LookbackSlider_ValueChanged"/>
                    <TextBlock Grid.Column="2"
                               x:Name="LookbackLabel"
                               Text="90 days"
                               Foreground="#FF4FC3F7" FontFamily="Consolas"
                               FontSize="{DynamicResource GlobalFontSizeSm}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0" MinWidth="55"/>
                </Grid>
            </Border>

            <!-- Single result panel filling the window -->
            <ContentPresenter Grid.Row="3"
                              x:Name="ResultContainer"/>

        </Grid>
    </Border>
</Window>
