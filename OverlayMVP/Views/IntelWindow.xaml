<!-- filename: Views/IntelWindow.xaml -->
<Window x:Class="OverlayMVP.Views.IntelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Loc.IwTitleBar}"
        Width="420" Height="600"
        MinWidth="280" MinHeight="250"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="CanResize">

    <Border Background="{DynamicResource BgEE}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="1"
            CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- title bar -->
                <RowDefinition Height="Auto"/>   <!-- search -->
                <RowDefinition Height="Auto"/>   <!-- time range -->
                <RowDefinition Height="*"/>      <!-- result -->
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource Onyx}"
                    CornerRadius="6,6,0,0"
                    Padding="10,6"
                    MouseLeftButtonDown="TitleBar_MouseDown"
                    MouseMove="TitleBar_MouseMove"
                    MouseLeftButtonUp="TitleBar_MouseUp"
                    Cursor="SizeAll">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding Loc.IwHeading}"
                               FontFamily="Consolas" FontWeight="Bold"
                               FontSize="{DynamicResource GlobalFontSizeSm}" Foreground="{DynamicResource Red}"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            x:Name="ClearBtn"
                            Content="{Binding Loc.IwClear}"
                            Click="Clear_Click"
                            FontFamily="Consolas" FontSize="{DynamicResource GlobalFontSizeXs}"
                            Background="{DynamicResource White22}" Foreground="{DynamicResource TextDim}"
                            BorderBrush="{DynamicResource Border}" BorderThickness="1"
                            Padding="6,2" Cursor="Hand" Margin="0,0,6,0"/>
                    <Button Grid.Column="2"
                            Content="✕"
                            Click="Close_Click"
                            FontFamily="Consolas" FontSize="{DynamicResource GlobalFontSizeXs}"
                            Background="{DynamicResource Red33}" Foreground="{DynamicResource Red}"
                            BorderBrush="{DynamicResource Red}" BorderThickness="1"
                            Padding="6,2" Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- Search bar -->
            <Border Grid.Row="1" Background="{DynamicResource Bg}" Padding="8,6" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox"
                             Grid.Column="0"
                             Background="{DynamicResource DeepInk}"
                             Foreground="{DynamicResource PaleLavender}"
                             BorderBrush="{DynamicResource Border}"
                             BorderThickness="1"
                             FontFamily="Consolas"
                             FontSize="{DynamicResource GlobalFontSizeSm}"
                             Padding="6,4"
                             CaretBrush="{DynamicResource Accent}"
                             VerticalContentAlignment="Center"
                             KeyDown="SearchBox_KeyDown"/>
                    <Button Grid.Column="1"
                            x:Name="SearchBtn"
                            Content="{Binding Loc.IwSearch}"
                            Click="Search_Click"
                            FontFamily="Consolas" FontSize="{DynamicResource GlobalFontSizeXs}"
                            Background="{DynamicResource Red33}" Foreground="{DynamicResource Red}"
                            BorderBrush="{DynamicResource Red}" BorderThickness="1"
                            Padding="10,4" Cursor="Hand" Margin="6,0,0,0"/>
                </Grid>
            </Border>

            <!-- Time range selector -->
            <Border Grid.Row="2" Background="{DynamicResource Bg}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                    Padding="8,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Loc.IwLookback}"
                               Foreground="{DynamicResource TextDim}" FontFamily="Consolas"
                               FontSize="{DynamicResource GlobalFontSizeXs}"
                               VerticalAlignment="Center"/>
                    <Slider Grid.Column="1"
                            x:Name="LookbackSlider"
                            Minimum="14" Maximum="365" Value="90"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            VerticalAlignment="Center"
                            ValueChanged="LookbackSlider_ValueChanged"/>
                    <TextBlock Grid.Column="2"
                               x:Name="LookbackLabel"
                               Text="{Binding Loc.IwDays90}"
                               Foreground="{DynamicResource Accent}" FontFamily="Consolas"
                               FontSize="{DynamicResource GlobalFontSizeSm}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0" MinWidth="55"/>
                </Grid>
            </Border>

            <!-- Single result panel filling the window -->
            <ContentPresenter Grid.Row="3"
                              x:Name="ResultContainer"/>

        </Grid>
    </Border>
</Window>
