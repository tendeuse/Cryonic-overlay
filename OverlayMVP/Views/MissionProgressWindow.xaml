<!-- filename: Views/MissionProgressWindow.xaml -->
<Window x:Class="OverlayMVP.Views.MissionProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OverlayMVP.Converters"
        Title="Mission Progress — Cryonic Overlay"
        Width="420" Height="500"
        MinWidth="300" MinHeight="300"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ResizeMode="CanResize">

    <Window.Resources>
        <local:ZeroToCollapsedConverter x:Key="ZeroToCollapsed"/>
        <local:ThresholdStatusConverter x:Key="ThresholdStatus"/>
    </Window.Resources>

    <Border Background="#EE0D1117"
            BorderBrush="#FF1E3148"
            BorderThickness="1"
            CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0"
                    Background="#CC111820"
                    CornerRadius="6,6,0,0"
                    Padding="10,6"
                    MouseLeftButtonDown="TitleBar_MouseDown"
                    Cursor="SizeAll">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="📊  MISSION PROGRESS"
                               FontFamily="Consolas" FontWeight="Bold"
                               FontSize="{DynamicResource GlobalFontSizeSm}"
                               Foreground="#FF66BB6A"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Content="✕"
                            Click="CloseBtn_Click"
                            Style="{StaticResource SmallBtn}"
                            Background="#33EF5350"
                            BorderBrush="#FFEF5350"
                            Foreground="#FFEF5350"/>
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="8">
                <StackPanel>

                    <!-- Header: session stats -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="⚡ MISSION PROGRESS"
                                   Foreground="{StaticResource AccentGold}"
                                   FontFamily="Consolas" FontWeight="Bold"
                                   FontSize="{DynamicResource GlobalFontSizeSm}"/>
                        <!-- Session AP badge -->
                        <Border Grid.Column="1"
                                Background="#22FFD54F" BorderBrush="{StaticResource AccentGold}"
                                BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,6,0"
                                Visibility="{Binding SessionMissionCount, Converter={StaticResource ZeroToCollapsed}}">
                            <TextBlock FontSize="{DynamicResource GlobalFontSizeXs}" FontFamily="Consolas">
                                <Run Text="{Binding SessionAP, Mode=OneWay}" Foreground="{StaticResource AccentGold}" FontWeight="Bold"/>
                                <Run Text=" AP" Foreground="{StaticResource TextSecondary}"/>
                            </TextBlock>
                        </Border>
                        <!-- Mission count badge -->
                        <Border Grid.Column="2"
                                Background="#224FC3F7" BorderBrush="{StaticResource AccentBlue}"
                                BorderThickness="1" CornerRadius="3" Padding="6,2"
                                Visibility="{Binding SessionMissionCount, Converter={StaticResource ZeroToCollapsed}}">
                            <TextBlock FontSize="{DynamicResource GlobalFontSizeXs}" FontFamily="Consolas">
                                <Run Text="{Binding SessionMissionCount, Mode=OneWay}" Foreground="{StaticResource AccentBlue}" FontWeight="Bold"/>
                                <Run Text=" missions" Foreground="{StaticResource TextSecondary}"/>
                            </TextBlock>
                        </Border>
                    </Grid>

                    <!-- Active mission banner -->
                    <Border Background="#1AFFD54F" BorderBrush="#44FFD54F"
                            BorderThickness="1" CornerRadius="3" Padding="6,4" Margin="0,0,0,6"
                            Visibility="{Binding ActiveMissionName, Converter={StaticResource NullToVisibility}}">
                        <TextBlock FontFamily="Consolas" FontSize="{DynamicResource GlobalFontSizeXs}">
                            <Run Text="📋 " Foreground="{StaticResource AccentGold}"/>
                            <Run Text="{Binding ActiveMissionName, Mode=OneWay}"
                                 Foreground="{StaticResource TextPrimary}" FontWeight="Bold"/>
                        </TextBlock>
                    </Border>

                    <!-- Next threshold progress bar -->
                    <Border Background="#110D1117" CornerRadius="3" Padding="6,5" Margin="0,0,0,4"
                            Visibility="{Binding SelectedCatalogueFaction, Converter={StaticResource NullToVisibility}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding NextThresholdLabel}"
                                           Foreground="{StaticResource AccentGold}"
                                           FontFamily="Consolas" FontWeight="Bold"
                                           FontSize="{DynamicResource GlobalFontSizeXs}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding MissionsToNextLabel}"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="{DynamicResource GlobalFontSizeXs}"/>
                            </Grid>
                            <ProgressBar Height="6" Minimum="0" Maximum="1"
                                         Value="{Binding NextThresholdProgress, Mode=OneWay}"
                                         Background="#221E3148"
                                         BorderThickness="0">
                                <ProgressBar.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FFFFD54F" Offset="0"/>
                                        <GradientStop Color="#FF2ECC71" Offset="1"/>
                                    </LinearGradientBrush>
                                </ProgressBar.Foreground>
                            </ProgressBar>
                        </StackPanel>
                    </Border>

                    <!-- All thresholds checklist -->
                    <ItemsControl ItemsSource="{Binding StandingProgress}"
                                  Visibility="{Binding StandingProgress.Count, Converter={StaticResource ZeroToCollapsed}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               FontSize="{DynamicResource GlobalFontSizeXs}"
                                               VerticalAlignment="Center">
                                        <Run Text="{Binding IsUnlocked, Converter={StaticResource ThresholdStatus}, Mode=OneWay}"/>
                                    </TextBlock>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontSize="{DynamicResource GlobalFontSizeXs}">
                                            <Run Text="{Binding Label, Mode=OneWay}"
                                                 FontWeight="Bold"
                                                 Foreground="{StaticResource TextPrimary}"/>
                                            <Run Text=" — " Foreground="{StaticResource TextSecondary}"/>
                                            <Run Text="{Binding Value, Mode=OneWay, StringFormat={}{0:F1}}"
                                                 Foreground="{StaticResource AccentGold}"/>
                                        </TextBlock>
                                        <ProgressBar Height="3" Minimum="0" Maximum="1"
                                                     Value="{Binding ProgressToThis, Mode=OneWay}"
                                                     Background="#221E3148" BorderThickness="0"
                                                     Foreground="#FF4FC3F7"
                                                     Visibility="{Binding IsNext, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding MissionsLabel}"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="{DynamicResource GlobalFontSizeXs}"
                                               Margin="6,0,0,0" VerticalAlignment="Center"
                                               Visibility="{Binding IsNext, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- LP/ISK estimates -->
                    <Border Background="#110D1117" CornerRadius="3" Padding="6,5" Margin="0,6,0,4">
                        <StackPanel>
                            <TextBlock Text="LP REWARDS BY MISSION LEVEL"
                                       Foreground="{StaticResource AccentBlue}"
                                       FontFamily="Consolas" FontWeight="Bold"
                                       FontSize="{DynamicResource GlobalFontSizeXs}"
                                       Margin="0,0,0,4"/>
                            <ItemsControl ItemsSource="{Binding LpEstimates}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   FontFamily="Consolas"
                                                   FontSize="{DynamicResource GlobalFontSizeXs}"
                                                   Margin="0,1"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Recent missions log -->
                    <StackPanel Visibility="{Binding MissionHistory.Count, Converter={StaticResource ZeroToCollapsed}}">
                        <TextBlock Text="RECENT MISSIONS"
                                   Foreground="{StaticResource AccentBlue}"
                                   FontFamily="Consolas" FontWeight="Bold"
                                   FontSize="{DynamicResource GlobalFontSizeXs}"
                                   Margin="0,0,0,4"/>
                        <ItemsControl ItemsSource="{Binding MissionHistory}" MaxHeight="120">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding MissionName}"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   FontSize="{DynamicResource GlobalFontSizeXs}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1"
                                                   FontSize="{DynamicResource GlobalFontSizeXs}"
                                                   Foreground="{StaticResource AccentGreen}"
                                                   Margin="6,0,0,0">
                                            <Run Text="+"/><Run Text="{Binding StandingGain, Mode=OneWay, StringFormat={}{0:F3}}"/>
                                        </TextBlock>
                                        <Border Grid.Column="2"
                                                Background="#22FFD54F" CornerRadius="2"
                                                Padding="4,1" Margin="4,0,0,0">
                                            <TextBlock Text="+50 AP"
                                                       Foreground="{StaticResource AccentGold}"
                                                       FontSize="{DynamicResource GlobalFontSizeXs}"
                                                       FontFamily="Consolas"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Mission status line -->
                    <TextBlock Text="{Binding MissionStatus}"
                               Foreground="{StaticResource AccentGold}"
                               FontFamily="Consolas"
                               FontSize="{DynamicResource GlobalFontSizeXs}"
                               TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding MissionStatus, Converter={StaticResource NullToVisibility}}"/>

                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Border>
</Window>
