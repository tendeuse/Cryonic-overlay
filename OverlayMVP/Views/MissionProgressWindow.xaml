<!-- filename: Views/MissionProgressWindow.xaml -->
<Window x:Class="OverlayMVP.Views.MissionProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OverlayMVP.Converters"
        Title="{Binding Loc.MpTitleBar}"
        Width="420" Height="500"
        MinWidth="300" MinHeight="300"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ResizeMode="CanResize">

    <Window.Resources>
        <local:ZeroToCollapsedConverter x:Key="ZeroToCollapsed"/>
    </Window.Resources>

    <Border Background="{DynamicResource BgEE}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="1"
            CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource Onyx}"
                    CornerRadius="6,6,0,0"
                    Padding="10,6"
                    MouseLeftButtonDown="TitleBar_MouseDown"
                    Cursor="SizeAll">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding Loc.MpHeading}"
                               FontFamily="Consolas" FontWeight="Bold"
                               FontSize="{DynamicResource GlobalFontSizeSm}"
                               Foreground="{DynamicResource Green}"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Content="✕"
                            Click="CloseBtn_Click"
                            Style="{StaticResource SmallBtn}"
                            Background="{DynamicResource Red33}"
                            BorderBrush="{DynamicResource Red}"
                            Foreground="{DynamicResource Red}"/>
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="8">
                <StackPanel Margin="10,8">

                    <!-- Header line: playtime + reset countdown -->
                    <TextBlock Margin="0,0,0,10"
                               FontSize="{DynamicResource GlobalFontSizeXs}"
                               Foreground="{DynamicResource TextDim}">
                        <Run Text="{Binding Loc.MpPlayed, Mode=OneWay}"/>
                        <Run Text="{Binding Session.PlayedLabel, Mode=OneWay}"
                             Foreground="{DynamicResource Accent}"/>
                        <Run Text="  ·  "/>
                        <Run Text="{Binding Session.ResetsInLabel, Mode=OneWay}"/>
                    </TextBlock>

                    <!-- Re-link prompt (only when a character lacks the new scopes) -->
                    <Border Background="{DynamicResource Red33}" CornerRadius="3" Padding="8,5" Margin="0,0,0,10"
                            Visibility="{Binding Session.RelinkPrompt, Converter={StaticResource NullToVisibility}}">
                        <TextBlock Text="{Binding Session.RelinkPrompt, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   FontSize="{DynamicResource GlobalFontSizeXs}"
                                   Foreground="{DynamicResource Text}"/>
                    </Border>

                    <!-- ISK -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Loc.MpIsk}" FontSize="{DynamicResource GlobalFontSizeXs}"
                                       Foreground="{DynamicResource TextDim}"/>
                            <TextBlock Text="{Binding Session.IskTodayLabel, Mode=OneWay}"
                                       FontWeight="Bold" Foreground="{DynamicResource Amber}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" VerticalAlignment="Bottom"
                                   Text="{Binding Session.IskPerHourLabel, Mode=OneWay}"
                                   FontSize="{DynamicResource GlobalFontSizeXs}"
                                   Foreground="{DynamicResource TextDim}"/>
                    </Grid>

                    <!-- LP -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Loc.MpLp}" FontSize="{DynamicResource GlobalFontSizeXs}"
                                       Foreground="{DynamicResource TextDim}"/>
                            <TextBlock Text="{Binding Session.LpTodayLabel, Mode=OneWay}"
                                       FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" VerticalAlignment="Bottom"
                                   Text="{Binding Session.LpPerHourLabel, Mode=OneWay}"
                                   FontSize="{DynamicResource GlobalFontSizeXs}"
                                   Foreground="{DynamicResource TextDim}"/>
                    </Grid>

                    <!-- Kills -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Loc.MpKills}" FontSize="{DynamicResource GlobalFontSizeXs}"
                                       Foreground="{DynamicResource TextDim}"/>
                            <TextBlock Text="{Binding Session.KillsToday, Mode=OneWay}"
                                       FontWeight="Bold" Foreground="{DynamicResource Red}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" VerticalAlignment="Bottom"
                                   Text="{Binding Session.KillsPerHourLabel, Mode=OneWay}"
                                   FontSize="{DynamicResource GlobalFontSizeXs}"
                                   Foreground="{DynamicResource TextDim}"/>
                    </Grid>

                    <!-- Mining -->
                    <TextBlock Text="{Binding Loc.MpMined}" Style="{StaticResource SectionHeader}" Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding Loc.MpLedgerLag}"
                               FontSize="{DynamicResource GlobalFontSizeXs}"
                               Foreground="{DynamicResource TextDim}"
                               Opacity="0.7" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding Session.MinedToday}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding OreName}"
                                               Foreground="{DynamicResource Text}"
                                               FontSize="{DynamicResource GlobalFontSizeSm}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding UnitsLabel}"
                                               Foreground="{DynamicResource Amber}"
                                               FontSize="{DynamicResource GlobalFontSizeSm}"
                                               Margin="8,0,0,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding PerHourLabel}"
                                               Foreground="{DynamicResource TextDim}"
                                               FontSize="{DynamicResource GlobalFontSizeXs}"
                                               Margin="8,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Loc.MpNoMining}"
                               FontStyle="Italic"
                               FontSize="{DynamicResource GlobalFontSizeXs}"
                               Foreground="{DynamicResource TextDim}"
                               Visibility="{Binding Session.MinedToday.Count, Converter={StaticResource ZeroToCollapsed}}"/>
                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Border>
</Window>
