<!-- filename: Views/SkillPlanWindow.xaml -->
<Window x:Class="OverlayMVP.Views.SkillPlanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Loc.SpTitleBar}"
        Width="420" Height="600"
        MinWidth="300" MinHeight="350"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ResizeMode="CanResize">

    <Border Background="{DynamicResource BgEE}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="1"
            CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource Onyx}"
                    CornerRadius="6,6,0,0"
                    Padding="10,6"
                    MouseLeftButtonDown="TitleBar_MouseDown"
                    Cursor="SizeAll">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding Loc.SpHeading}"
                               FontFamily="Consolas" FontWeight="Bold"
                               FontSize="{DynamicResource GlobalFontSizeSm}"
                               Foreground="{DynamicResource Accent}"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Content="✕"
                            Click="CloseBtn_Click"
                            Style="{StaticResource SmallBtn}"
                            Background="{DynamicResource Red33}"
                            BorderBrush="{DynamicResource Red}"
                            Foreground="{DynamicResource Red}"/>
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="8">
                <StackPanel>

                    <!-- Header -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Loc.SpHeadingAlt}"
                                           Foreground="{DynamicResource Accent}"
                                           FontFamily="Consolas"
                                           FontWeight="Bold"
                                           FontSize="{DynamicResource GlobalFontSizeSm}"
                                           VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource Border22}" CornerRadius="3"
                                        Margin="6,0,0,0" Padding="4,1"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AccountTypeLabel}"
                                               FontFamily="Consolas"
                                               FontSize="{DynamicResource GlobalFontSizeXs}"
                                               Foreground="{DynamicResource Amber}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding SkillPlanTitle}"
                                       Foreground="{DynamicResource TextDim}"
                                       FontFamily="Consolas"
                                       FontSize="{DynamicResource GlobalFontSizeXs}"
                                       Visibility="{Binding SkillPlanTitle, Converter={StaticResource NullToVisibility}}"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="{Binding CopySkillPlanLabel}"
                                Command="{Binding CopySkillPlanCommand}"
                                Style="{StaticResource SmallBtn}"
                                Margin="0,0,4,0"
                                ToolTip="{Binding Loc.SpTipCopy}"/>
                        <Button Grid.Column="2" Content="⟳"
                                Command="{Binding RefreshSkillPlanCommand}"
                                Style="{StaticResource SmallBtn}"
                                ToolTip="{Binding Loc.SpTipReload}"/>
                    </Grid>

                    <!-- Faction selector -->
                    <ComboBox ItemsSource="{Binding FactionKeys}"
                              SelectedItem="{Binding FactionFocus, Mode=TwoWay}"
                              Margin="0,0,0,6"/>

                    <!-- Ships + notes -->
                    <TextBlock Text="{Binding SkillPlanShips}"
                               Foreground="{DynamicResource Accent}"
                               FontSize="{DynamicResource GlobalFontSizeXs}"
                               Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding SkillPlanNotes}"
                               Foreground="{DynamicResource TextDim}"
                               FontSize="{DynamicResource GlobalFontSizeXs}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,6"/>

                    <!-- Progress summary -->
                    <Border Background="{DynamicResource Bg11}" CornerRadius="3" Padding="6,4" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding SkillPlanStatus}"
                                       Foreground="{DynamicResource Amber}"
                                       FontSize="{DynamicResource GlobalFontSizeXs}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       FontSize="{DynamicResource GlobalFontSizeXs}"
                                       Foreground="{DynamicResource TextDim}"
                                       VerticalAlignment="Center">
                                <Run Text="{Binding SkillPlanDone, Mode=OneWay}"/>
                                <Run Text="/"/>
                                <Run Text="{Binding SkillPlanTotal, Mode=OneWay}"/>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Skill list -->
                    <ItemsControl ItemsSource="{Binding CurrentSkillPlan}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Row outline border -->
                                <Border Margin="0,2,0,0"
                                        Background="{DynamicResource White0D}"
                                        BorderBrush="{DynamicResource White33}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="5,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="62"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Status emoji -->
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding StatusEmoji}"
                                                   FontSize="{DynamicResource GlobalFontSizeXs}"
                                                   VerticalAlignment="Center"/>
                                        <!-- Skill name + category -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SkillName}"
                                                       FontSize="{DynamicResource GlobalFontSizeXs}"
                                                       Foreground="{DynamicResource Text}"
                                                       ToolTip="{Binding WhyText}"/>
                                            <TextBlock Text="{Binding Category}"
                                                       FontSize="{DynamicResource GlobalFontSizeXs}"
                                                       Foreground="{DynamicResource TextDim}"/>
                                        </StackPanel>
                                        <!-- Level badge with outline -->
                                        <Border Grid.Column="2"
                                                Background="{DynamicResource Accent1A}"
                                                BorderBrush="{DynamicResource Accent66}"
                                                BorderThickness="1"
                                                CornerRadius="3"
                                                Padding="6,2"
                                                Margin="6,0,6,0"
                                                VerticalAlignment="Center">
                                            <Border.ToolTip>
                                                <ToolTip>
                                                    <StackPanel>
                                                        <TextBlock>
                                                            <Run Text="{Binding Loc.SpSkillId, Mode=OneWay}" Foreground="{DynamicResource SteelGrey}"/>
                                                            <Run Text="{Binding SkillId, Mode=OneWay}" Foreground="{DynamicResource White}" FontWeight="Bold"/>
                                                        </TextBlock>
                                                        <TextBlock>
                                                            <Run Text="{Binding Loc.SpActiveLevel, Mode=OneWay}" Foreground="{DynamicResource SteelGrey}"/>
                                                            <Run Text="{Binding TrainedLevel, Mode=OneWay}" Foreground="{DynamicResource Accent}" FontWeight="Bold"/>
                                                            <Run Text="{Binding Loc.SpMatchesSheet, Mode=OneWay}" Foreground="{DynamicResource SlateGray}" FontSize="9"/>
                                                        </TextBlock>
                                                        <TextBlock>
                                                            <Run Text="{Binding Loc.SpTarget, Mode=OneWay}" Foreground="{DynamicResource SteelGrey}"/>
                                                            <Run Text="{Binding EffectiveTarget, Mode=OneWay}" Foreground="{DynamicResource Amber}" FontWeight="Bold"/>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding WhyText, Mode=OneWay}"
                                                                   Foreground="{DynamicResource SteelGrey}"
                                                                   FontStyle="Italic"
                                                                   MaxWidth="260"
                                                                   TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </ToolTip>
                                            </Border.ToolTip>
                                            <TextBlock Text="{Binding LevelText}"
                                                       FontSize="{DynamicResource GlobalFontSizeXs}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource Accent}"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <!-- Mini progress bar -->
                                        <ProgressBar Grid.Column="3"
                                                     Height="5"
                                                     VerticalAlignment="Center"
                                                     Minimum="0"
                                                     Maximum="{Binding EffectiveTarget}"
                                                     Value="{Binding TrainedLevel, Mode=OneWay}"
                                                     Background="{DynamicResource Border22}"
                                                     Foreground="{DynamicResource Accent}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Border>
</Window>
