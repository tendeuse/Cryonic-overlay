<!-- filename: Views/SettingsWindow.xaml -->
<Window x:Class="OverlayMVP.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Loc.SetWindowTitle}"
        Width="520" Height="600"
        MinWidth="420" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{DynamicResource Surface}"
        Foreground="{DynamicResource White}"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PaleLavender}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="12"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background"   Value="{DynamicResource BgFF}"/>
            <Setter Property="Foreground"   Value="{DynamicResource PaleLavender}"/>
            <Setter Property="BorderBrush"  Value="{DynamicResource SteelBlue}"/>
            <Setter Property="Padding"      Value="6,5"/>
            <Setter Property="FontFamily"   Value="Consolas"/>
            <Setter Property="FontSize"     Value="12"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background"   Value="{DynamicResource TwilightBlue}"/>
            <Setter Property="Foreground"   Value="{DynamicResource PaleLavender}"/>
            <Setter Property="BorderBrush"  Value="{DynamicResource SteelBlue}"/>
            <Setter Property="Padding"      Value="12,6"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="FontFamily"   Value="Segoe UI"/>
            <Setter Property="FontSize"     Value="12"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource PaleLavender}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="12"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- heading -->
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>  <!-- API URL -->
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>  <!-- pair code -->
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>  <!-- faction -->
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>  <!-- EVE link -->
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>  <!-- font size -->
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>  <!-- features heading -->
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>  <!-- features checkboxes -->
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>  <!-- status -->
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>  <!-- buttons -->
            <RowDefinition Height="8"/>
        </Grid.RowDefinitions>

        <!-- Heading -->
        <TextBlock Grid.Row="0"
                   Text="{Binding Loc.SetTitle}"
                   FontSize="18" FontWeight="Bold"
                   Foreground="{DynamicResource Cyan}"/>

        <!-- Faction Focus + Account Type -->
        <StackPanel Grid.Row="6">
            <TextBlock Text="{Binding Loc.SetFactionFocus}" Opacity="0.8" Margin="0,0,0,5"/>
            <ComboBox x:Name="FactionBox" SelectedValuePath="Tag">
                <!-- Empire -->
                <ComboBoxItem Content="{Binding Loc.FacCaldari}"                  Tag="CALDARI"/>
                <ComboBoxItem Content="{Binding Loc.FacGallente}"            Tag="GALLENTE"/>
                <ComboBoxItem Content="{Binding Loc.FacAmarr}"                   Tag="AMARR"/>
                <ComboBoxItem Content="{Binding Loc.FacMinmatar}"              Tag="MINMATAR"/>
                <!-- Neutral / special -->
                <ComboBoxItem Content="{Binding Loc.FacSoe}"                 Tag="SOE"/>
                <ComboBoxItem Content="{Binding Loc.FacConcord}"               Tag="CONCORD"/>
                <ComboBoxItem Content="{Binding Loc.FacOre}"                            Tag="ORE"/>
                <ComboBoxItem Content="{Binding Loc.FacEdencom}"                        Tag="EDENCOM"/>
                <ComboBoxItem Content="{Binding Loc.FacTriglavian}"          Tag="TRIGLAVIAN"/>
                <!-- Pirate factions -->
                <ComboBoxItem Content="{Binding Loc.FacGuristas}"               Tag="GURISTAS"/>
                <ComboBoxItem Content="{Binding Loc.FacAngels}"                   Tag="ANGELS"/>
                <ComboBoxItem Content="{Binding Loc.FacBlood}"                  Tag="BLOOD"/>
                <ComboBoxItem Content="{Binding Loc.FacSerpentis}"          Tag="SERPENTIS"/>
                <ComboBoxItem Content="{Binding Loc.FacSansha}"                Tag="SANSHA"/>
                <ComboBoxItem Content="{Binding Loc.FacMordus}"         Tag="MORDUS"/>
                <!-- Other (unique ships open to all) -->
                <ComboBoxItem Content="{Binding Loc.FacSoct}"   Tag="SOCT"/>
            </ComboBox>
            <TextBlock Text="{Binding Loc.SetAccountType}" Opacity="0.8" Margin="0,10,0,5"/>
            <ComboBox x:Name="AlphaBox" SelectedValuePath="Tag">
                <ComboBoxItem Content="{Binding Loc.SetAlpha}" Tag="ALPHA"/>
                <ComboBoxItem Content="{Binding Loc.SetOmega}"    Tag="OMEGA"/>
            </ComboBox>
            <TextBlock Text="{Binding Loc.SetAutoDetected}"
                       Foreground="{DynamicResource SlateNavy}" FontSize="10" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- EVE Characters (multi-account) -->
        <StackPanel Grid.Row="8">
            <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Loc.SetEveChars}" Opacity="0.8" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="{Binding Loc.SetAddChar}"
                        x:Name="LinkEveBtn"
                        Click="LinkEve_Click"
                        Background="{DynamicResource DeepTeal}"
                        BorderBrush="{DynamicResource Cyan}"
                        Foreground="{DynamicResource Cyan}"/>
            </Grid>
            <!-- Linked characters list -->
            <ItemsControl x:Name="CharacterList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource BgFF}" BorderBrush="{DynamicResource SteelBlue}"
                                BorderThickness="1" CornerRadius="3"
                                Padding="10,6" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="●" FontSize="10"
                                           Foreground="{DynamicResource MintGreen}" VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding CharacterName}"
                                           FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource PaleLavender}"/>
                                <Button Grid.Column="2" Content="{Binding Loc.SetSetActive}"
                                        Tag="{Binding}"
                                        Click="SetActive_Click"
                                        Margin="0,0,6,0"
                                        Padding="8,3" FontSize="10"/>
                                <Button Grid.Column="3" Content="✕"
                                        Tag="{Binding}"
                                        Click="UnlinkChar_Click"
                                        Background="{DynamicResource Red33}"
                                        BorderBrush="{DynamicResource Red}"
                                        Foreground="{DynamicResource Red}"
                                        Padding="8,3" FontSize="10"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="EveStatusLabel"
                       Text="{Binding Loc.SetNoChars}"
                       Foreground="{DynamicResource TextDim}" FontSize="11" Margin="0,2,0,0"/>
            <TextBlock Text="{Binding Loc.SetTokensLocal}"
                       Foreground="{DynamicResource SlateNavy}" FontSize="10" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Font Size -->
        <StackPanel Grid.Row="10">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <TextBlock Text="{Binding Loc.SetFontSize}" Opacity="0.8"/>
                <TextBlock Text="{Binding Loc.SetAppliesOnSave}" Foreground="{DynamicResource Cyan}" FontSize="11"/>
            </StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <Slider x:Name="FontSizeSlider"
                        Minimum="8" Maximum="18" TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        SmallChange="1" LargeChange="2"
                        ValueChanged="FontSizeSlider_Changed"
                        VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           x:Name="FontSizeLabel"
                           TextAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="13" FontWeight="Bold"
                           Foreground="{DynamicResource Cyan}"/>
            </Grid>
            <WrapPanel Margin="0,8,0,0">
                <Button Content="{Binding Loc.SetFontSmall}"   Tag="9"  Click="FontPreset_Click" Margin="0,0,6,0" FontSize="10"/>
                <Button Content="{Binding Loc.SetFontNormal}" Tag="11" Click="FontPreset_Click" Margin="0,0,6,0" FontSize="11"/>
                <Button Content="{Binding Loc.SetFontLarge}"  Tag="13" Click="FontPreset_Click" Margin="0,0,6,0" FontSize="13"/>
                <Button Content="{Binding Loc.SetFontXl}"     Tag="15" Click="FontPreset_Click" FontSize="15"/>
            </WrapPanel>

            <!-- ── Skin ──────────────────────────────────────────────────
                 Only skins this pilot is entitled to are listed. The overlay
                 is fully usable on the default skin and always will be:
                 CCP's licence forbids paywalling features, so skins gate
                 appearance and nothing else. -->
            <StackPanel Orientation="Horizontal" Margin="0,14,0,5">
                <TextBlock Text="{Binding Loc.SetSkin}" Opacity="0.8"/>
                <TextBlock Text="{Binding Loc.SetAppliesNow}" Foreground="{DynamicResource Cyan}" FontSize="11"/>
            </StackPanel>
            <ComboBox x:Name="SkinBox"
                      DisplayMemberPath="Display"
                      SelectionChanged="SkinBox_SelectionChanged"/>
            <TextBlock x:Name="SkinHint"
                       FontSize="11"
                       Opacity="0.7"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Features -->
        <StackPanel Grid.Row="12">
            <TextBlock Text="{Binding Loc.SetFeatures}" Opacity="0.7" FontWeight="Bold" FontSize="10"
                       Foreground="{DynamicResource Accent}" Margin="0,0,0,6"/>
            <WrapPanel>
                <CheckBox x:Name="ChkMultibox"        Content="{Binding Loc.SetFeatInstances}"       Margin="0,0,14,5"/>
                <CheckBox x:Name="ChkIntelAlerts"     Content="{Binding Loc.SetFeatIntel}"     Margin="0,0,14,5"/>
                <CheckBox x:Name="ChkPilotStatus"     Content="{Binding Loc.SetFeatPilot}"           Margin="0,0,14,5"/>
                <CheckBox x:Name="ChkStandingGuide"   Content="{Binding Loc.SetFeatStanding}"         Margin="0,0,14,5"/>
                <CheckBox x:Name="ChkMissionProgress" Content="{Binding Loc.SetFeatMission}"       Margin="0,0,14,5"/>
                <CheckBox x:Name="ChkSkillPlan"       Content="{Binding Loc.SetFeatSkill}"             Margin="0,0,14,5"/>
                <CheckBox x:Name="ChkPilotIntelBtn"   Content="{Binding Loc.SetFeatPilotIntel}"  Margin="0,0,14,5"/>
                <CheckBox x:Name="ChkSystemInfoBtn"   Content="{Binding Loc.SetFeatDotlan}" Margin="0,0,14,5"/>
            </WrapPanel>
        </StackPanel>

        <!-- Status -->
        <TextBlock Grid.Row="16"
                   x:Name="StatusLabel"
                   Text=""
                   TextWrapping="Wrap"
                   FontSize="11"
                   Foreground="{DynamicResource PaleCyan}"/>

        <!-- Buttons -->
        <WrapPanel Grid.Row="18" HorizontalAlignment="Right">
            <Button Content="{Binding Loc.SetCancel}"
                    Click="Cancel_Click"
                    Margin="0,0,6,0"/>
            <Button Content="{Binding Loc.SetSave}"
                    Click="SaveOnly_Click"
                    Margin="0,0,6,0"/>
            <!-- Primary action: the panel toggles only take effect once this
                 window closes, so this is the sequence you actually want. -->
            <Button Content="{Binding Loc.SetSaveClose}"
                    Click="SaveClose_Click"
                    IsDefault="True"
                    Background="{DynamicResource DeepTeal}"
                    BorderBrush="{DynamicResource Cyan}"
                    Foreground="{DynamicResource Cyan}"/>
        </WrapPanel>

    </Grid>
    </ScrollViewer>
</Window>
