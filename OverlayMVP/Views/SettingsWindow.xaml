<!-- filename: Views/SettingsWindow.xaml -->
<Window x:Class="OverlayMVP.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings — Cryonic Overlay"
        Width="520" Height="600"
        MinWidth="420" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#FF0A1A2F"
        Foreground="White"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFCCD6F6"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="12"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background"   Value="#FF0D1117"/>
            <Setter Property="Foreground"   Value="#FFCCD6F6"/>
            <Setter Property="BorderBrush"  Value="#FF1A3A50"/>
            <Setter Property="Padding"      Value="6,5"/>
            <Setter Property="FontFamily"   Value="Consolas"/>
            <Setter Property="FontSize"     Value="12"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background"   Value="#FF0D2137"/>
            <Setter Property="Foreground"   Value="#FFCCD6F6"/>
            <Setter Property="BorderBrush"  Value="#FF1A3A50"/>
            <Setter Property="Padding"      Value="12,6"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="FontFamily"   Value="Segoe UI"/>
            <Setter Property="FontSize"     Value="12"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFCCD6F6"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="12"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- heading -->
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>  <!-- API URL -->
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>  <!-- pair code -->
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>  <!-- faction -->
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>  <!-- EVE client ID -->
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>  <!-- EVE link -->
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>  <!-- font size -->
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>  <!-- features heading -->
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>  <!-- features checkboxes -->
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>  <!-- status -->
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>  <!-- buttons -->
            <RowDefinition Height="8"/>
        </Grid.RowDefinitions>

        <!-- Heading -->
        <TextBlock Grid.Row="0"
                   Text="⚙  Settings"
                   FontSize="18" FontWeight="Bold"
                   Foreground="#FF00B4D4"/>

        <!-- Faction Focus + Account Type -->
        <StackPanel Grid.Row="6">
            <TextBlock Text="Faction Focus" Opacity="0.8" Margin="0,0,0,5"/>
            <ComboBox x:Name="FactionBox" SelectedValuePath="Tag">
                <!-- Empire -->
                <ComboBoxItem Content="Caldari State"                  Tag="CALDARI"/>
                <ComboBoxItem Content="Gallente Federation"            Tag="GALLENTE"/>
                <ComboBoxItem Content="Amarr Empire"                   Tag="AMARR"/>
                <ComboBoxItem Content="Minmatar Republic"              Tag="MINMATAR"/>
                <!-- Neutral / special -->
                <ComboBoxItem Content="Sisters of EVE"                 Tag="SOE"/>
                <ComboBoxItem Content="CONCORD Assembly"               Tag="CONCORD"/>
                <ComboBoxItem Content="ORE"                            Tag="ORE"/>
                <ComboBoxItem Content="EDENCOM"                        Tag="EDENCOM"/>
                <ComboBoxItem Content="Triglavian Collective"          Tag="TRIGLAVIAN"/>
                <!-- Pirate factions -->
                <ComboBoxItem Content="Guristas Pirates"               Tag="GURISTAS"/>
                <ComboBoxItem Content="Angel Cartel"                   Tag="ANGELS"/>
                <ComboBoxItem Content="Blood Raiders"                  Tag="BLOOD"/>
                <ComboBoxItem Content="Serpentis Corporation"          Tag="SERPENTIS"/>
                <ComboBoxItem Content="Sansha's Nation"                Tag="SANSHA"/>
                <ComboBoxItem Content="Mordu's Legion Command"         Tag="MORDUS"/>
                <!-- Other (unique ships open to all) -->
                <ComboBoxItem Content="Society of Conscious Thought"   Tag="SOCT"/>
            </ComboBox>
            <TextBlock Text="Account Type" Opacity="0.8" Margin="0,10,0,5"/>
            <ComboBox x:Name="AlphaBox" SelectedValuePath="Tag">
                <ComboBoxItem Content="Alpha clone  (skill caps apply)" Tag="ALPHA"/>
                <ComboBoxItem Content="Omega clone  (no skill caps)"    Tag="OMEGA"/>
            </ComboBox>
            <TextBlock Text="Auto-detected when you refresh the skill plan via ESI."
                       Foreground="#FF445566" FontSize="10" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- EVE Client ID -->
        <StackPanel Grid.Row="8">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <TextBlock Text="EVE App Client ID" Opacity="0.8"/>
                <TextBlock Text="  (developers.eveonline.com — Callback: http://localhost:4914)"
                           Foreground="#FF00B4D4" FontSize="10"/>
            </StackPanel>
            <TextBox x:Name="ClientIdBox" FontFamily="Consolas"/>
        </StackPanel>

        <!-- EVE Characters (multi-account) -->
        <StackPanel Grid.Row="10">
            <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="EVE Characters (ESI)" Opacity="0.8" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="+ Add Character"
                        x:Name="LinkEveBtn"
                        Click="LinkEve_Click"
                        Background="#FF003D5C"
                        BorderBrush="#FF00B4D4"
                        Foreground="#FF00B4D4"/>
            </Grid>
            <!-- Linked characters list -->
            <ItemsControl x:Name="CharacterList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#FF0D1117" BorderBrush="#FF1A3A50"
                                BorderThickness="1" CornerRadius="3"
                                Padding="10,6" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="●" FontSize="10"
                                           Foreground="#FF2ECC71" VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding CharacterName}"
                                           FontSize="12" VerticalAlignment="Center"
                                           Foreground="#FFCCD6F6"/>
                                <Button Grid.Column="2" Content="Set Active"
                                        Tag="{Binding}"
                                        Click="SetActive_Click"
                                        Margin="0,0,6,0"
                                        Padding="8,3" FontSize="10"/>
                                <Button Grid.Column="3" Content="✕"
                                        Tag="{Binding}"
                                        Click="UnlinkChar_Click"
                                        Background="#33EF5350"
                                        BorderBrush="#FFEF5350"
                                        Foreground="#FFEF5350"
                                        Padding="8,3" FontSize="10"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="EveStatusLabel"
                       Text="No characters linked."
                       Foreground="#FF8A99AA" FontSize="11" Margin="0,2,0,0"/>
            <TextBlock Text="Tokens stored locally — never sent to the server."
                       Foreground="#FF445566" FontSize="10" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Font Size -->
        <StackPanel Grid.Row="12">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <TextBlock Text="Font Size" Opacity="0.8"/>
                <TextBlock Text="  (restart required)" Foreground="#FF00B4D4" FontSize="11"/>
            </StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <Slider x:Name="FontSizeSlider"
                        Minimum="8" Maximum="18" TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        SmallChange="1" LargeChange="2"
                        ValueChanged="FontSizeSlider_Changed"
                        VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           x:Name="FontSizeLabel"
                           TextAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="13" FontWeight="Bold"
                           Foreground="#FF00B4D4"/>
            </Grid>
            <WrapPanel Margin="0,8,0,0">
                <Button Content="Small (9)"   Tag="9"  Click="FontPreset_Click" Margin="0,0,6,0" FontSize="10"/>
                <Button Content="Normal (11)" Tag="11" Click="FontPreset_Click" Margin="0,0,6,0" FontSize="11"/>
                <Button Content="Large (13)"  Tag="13" Click="FontPreset_Click" Margin="0,0,6,0" FontSize="13"/>
                <Button Content="XL (15)"     Tag="15" Click="FontPreset_Click" FontSize="15"/>
            </WrapPanel>
        </StackPanel>

        <!-- Features -->
        <StackPanel Grid.Row="14">
            <TextBlock Text="FEATURES" Opacity="0.7" FontWeight="Bold" FontSize="10"
                       Foreground="#FF4FC3F7" Margin="0,0,0,6"/>
            <WrapPanel>
                <CheckBox x:Name="ChkMultibox"        Content="Active Instances"       Margin="0,0,14,5"/>
                <CheckBox x:Name="ChkIntelAlerts"     Content="Intel &amp; Alerts"     Margin="0,0,14,5"/>
                <CheckBox x:Name="ChkPilotStatus"     Content="Pilot Status"           Margin="0,0,14,5"/>
                <CheckBox x:Name="ChkActiveMissions"  Content="Active Missions"        Margin="0,0,14,5"/>
                <CheckBox x:Name="ChkStandingGuide"   Content="Standing Guide"         Margin="0,0,14,5"/>
                <CheckBox x:Name="ChkMissionProgress" Content="Mission Progress"       Margin="0,0,14,5"/>
                <CheckBox x:Name="ChkSkillPlan"       Content="Skill Plan"             Margin="0,0,14,5"/>
                <CheckBox x:Name="ChkPilotIntelBtn"   Content="&#x1F50D; Pilot Intel"  Margin="0,0,14,5"/>
                <CheckBox x:Name="ChkSystemInfoBtn"   Content="&#x1F30D; Dotlan / System Info" Margin="0,0,14,5"/>
            </WrapPanel>
        </StackPanel>

        <!-- Status -->
        <TextBlock Grid.Row="18"
                   x:Name="StatusLabel"
                   Text=""
                   TextWrapping="Wrap"
                   FontSize="11"
                   Foreground="#FF9AD1FF"/>

        <!-- Buttons -->
        <WrapPanel Grid.Row="20" HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Click="Cancel_Click"
                    Margin="0,0,6,0"/>
            <Button Content="Save"
                    Click="SaveOnly_Click"
                    Background="#FF003D5C"
                    BorderBrush="#FF00B4D4"
                    Foreground="#FF00B4D4"/>
        </WrapPanel>

    </Grid>
    </ScrollViewer>
</Window>
