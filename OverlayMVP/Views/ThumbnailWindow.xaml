<!-- filename: Views/ThumbnailWindow.xaml -->
<!-- Floating, resizable, always-on-top window that shows a single DWM thumbnail.
     Drag from title bar to reposition. Resize from any edge/corner.
     Click ✕ to close (re-attaches thumbnail to the main overlay). -->
<Window x:Class="OverlayMVP.Views.ThumbnailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Loc.TwTitleBar}"
        Width="280" Height="185"
        MinWidth="140" MinHeight="100"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False">

    <Window.Resources>
        <!-- Resize grip thumb style -->
        <Style x:Key="ResizeThumb" TargetType="Thumb">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="Cursor"           Value="SizeNWSE"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource BorderStrong}"
            BorderThickness="1"
            CornerRadius="4"
            Background="{DynamicResource Well}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="22"/>   <!-- title bar -->
                <RowDefinition Height="*"/>    <!-- thumbnail area -->
            </Grid.RowDefinitions>

            <!-- ── Title bar ───────────────────────────────────────── -->
            <Border Grid.Row="0"
                    Background="{DynamicResource Well}"
                    CornerRadius="4,4,0,0"
                    MouseLeftButtonDown="TitleBar_MouseDown"
                    MouseMove="TitleBar_MouseMove"
                    MouseLeftButtonUp="TitleBar_MouseUp"
                    Cursor="SizeAll">
                <Grid Margin="6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               x:Name="TitleLabel"
                               Text="{Binding Loc.TwDefaultLabel}"
                               FontFamily="Consolas"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Amber}"
                               VerticalAlignment="Center"/>

                    <!-- Re-attach and close.
                         Background="Transparent" is REQUIRED, not decoration: a
                         TextBlock with a null background hit-tests only the ink
                         of the glyph itself, so the padding around these would
                         not be clickable and the target would stay as small as
                         the character. Transparent is a brush, so the whole
                         padded box responds. -->

                    <!-- Re-attach button -->
                    <TextBlock Grid.Column="1"
                               Text="⤡"
                               FontSize="10"
                               Foreground="{DynamicResource Accent}"
                               ToolTip="{Binding Loc.TwTipReattach}"
                               Cursor="Hand"
                               Background="Transparent"
                               Padding="5,3"
                               Margin="0,0,2,0"
                               VerticalAlignment="Center"
                               MouseLeftButtonDown="ReAttach_Click"/>

                    <!-- Close button -->
                    <TextBlock Grid.Column="2"
                               Text="✕"
                               FontSize="9"
                               Foreground="{DynamicResource Red}"
                               ToolTip="{Binding Loc.TwTipClose}"
                               Cursor="Hand"
                               Background="Transparent"
                               Padding="5,3"
                               VerticalAlignment="Center"
                               MouseLeftButtonDown="Close_Click"/>
                </Grid>
            </Border>

            <!-- ── DWM thumbnail host ───────────────────────────────── -->
            <!-- Click = switch focus to this EVE window without activating us -->
            <Border Grid.Row="1"
                    x:Name="ThumbnailHost"
                    Background="{DynamicResource Abyss}"
                    CornerRadius="0,0,4,4"
                    Cursor="Hand"
                    ToolTip="{Binding Loc.TwTipSwitch}"
                    MouseLeftButtonDown="ThumbnailHost_Click"/>

            <!-- ── Resize grip (bottom-right corner) ───────────────── -->
            <Thumb Grid.Row="1"
                   Width="12" Height="12"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Cursor="SizeNWSE"
                   DragDelta="ResizeGrip_DragDelta"
                   Opacity="0.6">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <TextBlock Text="◢"
                                   FontSize="10"
                                   Foreground="{DynamicResource BorderStrong}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom"/>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</Window>
