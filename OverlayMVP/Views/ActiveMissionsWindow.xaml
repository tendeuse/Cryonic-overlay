<!-- filename: Views/ActiveMissionsWindow.xaml -->
<Window x:Class="OverlayMVP.Views.ActiveMissionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Active Missions — Cryonic Overlay"
        Width="420" Height="400"
        MinWidth="300" MinHeight="250"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ResizeMode="CanResize">

    <Border Background="#EE0D1117"
            BorderBrush="#FF1E3148"
            BorderThickness="1"
            CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0"
                    Background="#CC111820"
                    CornerRadius="6,6,0,0"
                    Padding="10,6"
                    MouseLeftButtonDown="TitleBar_MouseDown"
                    Cursor="SizeAll">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="🎯  ACTIVE MISSIONS"
                               FontFamily="Consolas" FontWeight="Bold"
                               FontSize="{DynamicResource GlobalFontSizeSm}"
                               Foreground="#FFFFD54F"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Content="✕"
                            Click="CloseBtn_Click"
                            Style="{StaticResource SmallBtn}"
                            Background="#33EF5350"
                            BorderBrush="#FFEF5350"
                            Foreground="#FFEF5350"/>
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="8">
                <StackPanel>

                    <TextBlock Text="{Binding Loc.ActiveMissions}" Style="{StaticResource SectionHeader}"/>
                    <ItemsControl ItemsSource="{Binding Missions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock>
                                            <Run Text="{Binding StatusEmoji, Mode=OneWay}"/>
                                            <Run Text=" "/>
                                            <Run Text="{Binding Title, Mode=OneWay}" FontWeight="Bold"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding AssignedTo}"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   FontSize="{DynamicResource GlobalFontSizeXs}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="{Binding Loc.Assign, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Command="{Binding DataContext.AssignMissionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding MissionId}"
                                            Style="{StaticResource SmallBtn}"
                                            Background="#330099CC"
                                            BorderBrush="{StaticResource AccentBlue}"
                                            Margin="0,0,4,0"/>
                                    <Button Grid.Column="2"
                                            Content="{Binding Loc.Complete, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Command="{Binding DataContext.CompleteMissionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding MissionId}"
                                            Style="{StaticResource SmallBtn}"
                                            Background="#3366BB6A"
                                            BorderBrush="{StaticResource AccentGreen}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Border>
</Window>
