<!-- filename: Views/PilotStatusWindow.xaml -->
<Window x:Class="OverlayMVP.Views.PilotStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pilot Status — Cryonic Overlay"
        Width="420" Height="500"
        MinWidth="300" MinHeight="300"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ResizeMode="CanResize">

    <Border Background="#EE0D1117"
            BorderBrush="#FF1E3148"
            BorderThickness="1"
            CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0"
                    Background="#CC111820"
                    CornerRadius="6,6,0,0"
                    Padding="10,6"
                    MouseLeftButtonDown="TitleBar_MouseDown"
                    Cursor="SizeAll">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="👤  PILOT STATUS"
                               FontFamily="Consolas" FontWeight="Bold"
                               FontSize="{DynamicResource GlobalFontSizeSm}"
                               Foreground="#FF4FC3F7"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Content="✕"
                            Click="CloseBtn_Click"
                            Style="{StaticResource SmallBtn}"
                            Background="#33EF5350"
                            BorderBrush="#FFEF5350"
                            Foreground="#FFEF5350"/>
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="8">
                <StackPanel>

                    <!-- Header + ESI character switcher -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Loc.PilotStatus}"
                                   Style="{StaticResource SectionHeader}" Margin="0"/>
                        <Button Grid.Column="1"
                                Content="⟳"
                                Command="{Binding RefreshStandingsCommand}"
                                Style="{StaticResource SmallBtn}"
                                ToolTip="Refresh ESI standings"
                                Visibility="{Binding EveLinked, Converter={StaticResource BoolToVis}}"/>
                    </Grid>

                    <!-- ESI character selector -->
                    <Border Background="#11FFFFFF" CornerRadius="3" Padding="6,4" Margin="0,0,0,6"
                            Visibility="{Binding EveLinked, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ESI: "
                                       Foreground="#FF4FC3F7"
                                       FontSize="{DynamicResource GlobalFontSizeSm}"
                                       VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding LinkedCharacters}"
                                      SelectedItem="{Binding ActiveCharacter, Mode=TwoWay}"
                                      FontSize="{DynamicResource GlobalFontSizeSm}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CharacterName}"
                                                   FontFamily="Consolas"
                                                   FontSize="{DynamicResource GlobalFontSizeSm}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding ConnectionStatus}"
                               Foreground="#FF8A99AA"
                               FontSize="{DynamicResource GlobalFontSizeXs}"
                               Margin="0,0,0,6"/>

                    <!-- Locally detected pilots from EVE window titles -->
                    <ItemsControl ItemsSource="{Binding EveWindows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="4,2"
                                        Margin="0,1"
                                        CornerRadius="2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding ActiveIndicator, Mode=OneWay}"
                                                   Foreground="#FFFFD54F"
                                                   FontSize="{DynamicResource GlobalFontSize}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DisplayLabel, Mode=OneWay}"
                                                   Foreground="#FFE8EDF2"
                                                   FontWeight="Bold"
                                                   FontSize="{DynamicResource GlobalFontSize}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- API character data (ship/system) when available -->
                    <StackPanel Margin="0,4,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="{Binding ShipType}"
                                           Foreground="#FF4FC3F7"
                                           FontSize="{DynamicResource GlobalFontSizeSm}"/>
                                <TextBlock Text="{Binding Corporation}"
                                           Foreground="#FF8A99AA"
                                           FontSize="{DynamicResource GlobalFontSizeXs}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding SolarSystem}"
                                           Foreground="#FFE8EDF2"
                                           FontWeight="Bold"
                                           FontSize="{DynamicResource GlobalFontSizeSm}"/>
                                <TextBlock Text="{Binding SecurityStatus}"
                                           Foreground="{Binding SecurityColour, Converter={StaticResource StrBrush}}"
                                           FontSize="{DynamicResource GlobalFontSizeXs}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Border>
</Window>
