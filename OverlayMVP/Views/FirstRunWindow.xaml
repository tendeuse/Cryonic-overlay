<Window x:Class="OverlayMVP.Views.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="First Run Setup"
        Width="520" Height="420"
        WindowStartupLocation="CenterScreen"
        Background="#FF0A1A2F"
        Foreground="White">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Text="ARC Mission Overlay â€” First Run"
               FontSize="20"
               FontWeight="Bold"
               Margin="0,0,0,12"/>

    <StackPanel Grid.Row="1" Margin="0,6,0,6">
      <TextBlock Text="API Base URL (Railway domain)" Opacity="0.85"/>
      <TextBox Text="{Binding ApiBaseUrl}" Margin="0,6,0,12"/>

      <TextBlock Text="Overlay API Key (X-Overlay-Key)" Opacity="0.85"/>
      <PasswordBox x:Name="ApiKeyBox" Margin="0,6,0,12"/>

      <TextBlock Text="Account Type" Opacity="0.85"/>
      <ComboBox SelectedValue="{Binding AlphaOmega}" SelectedValuePath="Tag" Margin="0,6,0,12">
        <ComboBoxItem Content="Alpha" Tag="ALPHA"/>
        <ComboBoxItem Content="Omega" Tag="OMEGA"/>
      </ComboBox>

      <TextBlock Text="Faction Focus (can be changed later)" Opacity="0.85"/>
      <ComboBox SelectedValue="{Binding FactionFocus}" SelectedValuePath="Tag" Margin="0,6,0,12">
        <ComboBoxItem Content="Caldari" Tag="CALDARI"/>
        <ComboBoxItem Content="ORE" Tag="ORE"/>
        <ComboBoxItem Content="CONCORD" Tag="CONCORD"/>
        <ComboBoxItem Content="EDENCOM" Tag="EDENCOM"/>
        <ComboBoxItem Content="Sisters of EVE" Tag="SOE"/>
      </ComboBox>

      <TextBlock Text="{Binding Status}" Foreground="#FF9AD1FF" Margin="0,8,0,0" TextWrapping="Wrap"/>
    </StackPanel>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Save &amp; Launch" Width="140" Click="SaveAndLaunch_Click"/>
    </StackPanel>
  </Grid>
</Window>
