<!-- filename: Views/BriefingWindow.xaml -->
<Window x:Class="OverlayMVP.Views.BriefingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Incoming Transmission"
        Width="470" Height="640"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource GunMetal}"
        Topmost="True"
        ShowActivated="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" Background="{DynamicResource Charcoal}"
                MouseLeftButtonDown="TitleBar_MouseDown" Cursor="SizeAll">
            <Grid Margin="12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="◈" FontSize="13" Foreground="{DynamicResource Accent}"
                               VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock x:Name="HeaderText"
                               Text="INCOMING TRANSMISSION"
                               Foreground="{DynamicResource Text}" FontSize="12" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Content="✕"
                        Click="CloseButton_Click"
                        Width="22" Height="22"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource TextFaint}" FontSize="11" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Video (click to toggle play/pause) -->
        <Border Grid.Row="1" Background="Black" MouseLeftButtonDown="Video_MouseDown">
            <MediaElement x:Name="Player"
                          LoadedBehavior="Manual"
                          UnloadedBehavior="Stop"
                          ScrubbingEnabled="True"
                          Stretch="Uniform"
                          MediaOpened="Player_MediaOpened"
                          MediaEnded="Player_MediaEnded"
                          MediaFailed="Player_MediaFailed"/>
        </Border>

        <!-- Transport controls -->
        <Border Grid.Row="2" Background="{DynamicResource Charcoal}" Padding="12,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Seek bar + time + volume -->
                <Grid Grid.Row="0" Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider Grid.Column="0" x:Name="SeekBar"
                            Minimum="0" Maximum="1" Value="0"
                            IsMoveToPointEnabled="True"
                            SmallChange="1" LargeChange="5"
                            VerticalAlignment="Center"
                            Thumb.DragStarted="SeekBar_DragStarted"
                            Thumb.DragCompleted="SeekBar_DragCompleted"
                            ValueChanged="SeekBar_ValueChanged"/>
                    <TextBlock Grid.Column="1" x:Name="TimeText" Text="0:00 / 0:00"
                               Foreground="{DynamicResource TextDim}" FontSize="11"
                               Margin="9,0,0,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="VolumeIcon" Text="🔊" FontSize="12"
                                   Foreground="{DynamicResource TextDim}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <Slider x:Name="VolumeSlider" Width="68"
                                Minimum="0" Maximum="1" Value="1"
                                IsMoveToPointEnabled="True"
                                VerticalAlignment="Center"
                                ValueChanged="VolumeSlider_ValueChanged"/>
                    </StackPanel>
                </Grid>

                <!-- Buttons -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="PlayPauseBtn" Content="⏸ Pause"
                            Click="PlayPause_Click"
                            Width="90" Padding="0,4" Margin="0,0,8,0"
                            Background="{DynamicResource Accent22}" BorderBrush="{DynamicResource Accent88}"
                            Foreground="{DynamicResource Accent}" Cursor="Hand" FontSize="12"/>
                    <Button Content="⟳ Restart"
                            Click="ReplayButton_Click"
                            Padding="12,4" Margin="0,0,8,0"
                            Background="{DynamicResource Green22}" BorderBrush="{DynamicResource Green88}"
                            Foreground="{DynamicResource Green}" Cursor="Hand" FontSize="12"/>
                    <Button Content="Close"
                            Click="CloseButton_Click"
                            Padding="12,4"
                            Background="{DynamicResource Gray22}" BorderBrush="{DynamicResource Gray88}"
                            Foreground="{DynamicResource SteelGrey}" Cursor="Hand" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
