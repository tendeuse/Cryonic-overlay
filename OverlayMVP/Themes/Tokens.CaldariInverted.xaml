<!-- filename: Themes/Tokens.Default.xaml -->
<!--
  The default theme's colours. This is the file a skin replaces.

  Names come from Themes/design-reference/*.css so the CSS skins and this XAML
  share one vocabulary (cx-text-dim -> TextDim). VALUES are today's overlay
  colours, not the reference's — this theme must look exactly like the app
  always has.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Bg"      Color="#CC151719"/>   <!-- was BgPanel -->
    <SolidColorBrush x:Key="Panel"   Color="#8823282B"/>   <!-- was BgCard -->
    <SolidColorBrush x:Key="Well"    Color="#EE111315"/>   <!-- was BgMultibox -->

    <!-- Borders -->
    <SolidColorBrush x:Key="Border"  Color="#FF353C41"/>

    <!-- Text -->
    <SolidColorBrush x:Key="Text"    Color="#FFE6ECF2"/>   <!-- was TextPrimary -->
    <SolidColorBrush x:Key="TextDim" Color="#FF9FB0C0"/>   <!-- was TextSecondary -->

    <!-- Accents -->
    <SolidColorBrush x:Key="Accent"  Color="#FF466EA1"/>   <!-- was AccentBlue -->
    <SolidColorBrush x:Key="Amber"   Color="#FFC9A23E"/>   <!-- was AccentGold -->
    <SolidColorBrush x:Key="Red"     Color="#FFC9402E"/>   <!-- was AccentRed -->
    <SolidColorBrush x:Key="Green"   Color="#FF2E9A84"/>   <!-- was AccentGreen -->

    <!-- Task 3: five smallest windows -->
    <SolidColorBrush x:Key="Surface"      Color="#FF1F2225"/>   <!-- FirstRunWindow background -->
    <SolidColorBrush x:Key="PaleCyan"     Color="#FF74A4C4"/>   <!-- FirstRunWindow status text -->
    <SolidColorBrush x:Key="BgEE"         Color="#EE151719"/>   <!-- Bg, alpha EE -->
    <SolidColorBrush x:Key="Border44"     Color="#44353C41"/>   <!-- Border, alpha 44 -->
    <SolidColorBrush x:Key="DeepNavy"     Color="#CC1F2225"/>   <!-- ShipFitWindow title bar -->
    <SolidColorBrush x:Key="TextFaint"    Color="#FF6C8199"/>   <!-- ShipFitWindow close button -->
    <SolidColorBrush x:Key="Onyx"         Color="#CC1F2225"/>   <!-- NotePrompt/MissionProgress title bar -->
    <SolidColorBrush x:Key="Border22"     Color="#22353C41"/>   <!-- Border, alpha 22 -->
    <SolidColorBrush x:Key="White33"      Color="#33FFFFFF"/>   <!-- NotePromptWindow Cancel button -->
    <SolidColorBrush x:Key="Green33"      Color="#332E9A84"/>   <!-- Green, alpha 33 -->
    <SolidColorBrush x:Key="Red33"        Color="#33C9402E"/>   <!-- Red, alpha 33 -->
    <SolidColorBrush x:Key="Abyss"        Color="#FF0B0C0D"/>   <!-- ThumbnailWindow thumbnail host -->
    <SolidColorBrush x:Key="BorderStrong" Color="#FF40484F"/>   <!-- ThumbnailWindow BorderClr (hoisted) -->

    <!-- Task 4: mid-size windows -->
    <SolidColorBrush x:Key="GunMetal"     Color="#111315"/>     <!-- BriefingWindow window background -->
    <SolidColorBrush x:Key="Charcoal"     Color="#23282B"/>     <!-- BriefingWindow title bar / transport bar -->
    <SolidColorBrush x:Key="Accent22"     Color="#22466EA1"/>   <!-- Accent, alpha 22 -->
    <SolidColorBrush x:Key="Accent88"     Color="#88466EA1"/>   <!-- Accent, alpha 88 -->
    <SolidColorBrush x:Key="Green22"      Color="#222E9A84"/>   <!-- Green, alpha 22 -->
    <SolidColorBrush x:Key="Green88"      Color="#882E9A84"/>   <!-- Green, alpha 88 -->
    <SolidColorBrush x:Key="Gray22"       Color="#22466EA1"/>   <!-- Gray, alpha 22 -->
    <SolidColorBrush x:Key="Gray88"       Color="#88466EA1"/>   <!-- Gray, alpha 88 -->
    <SolidColorBrush x:Key="SteelGrey"    Color="#FF9FB0C0"/>   <!-- BriefingWindow Close button text -->
    <SolidColorBrush x:Key="White11"      Color="#11FFFFFF"/>   <!-- White, alpha 11 -->
    <SolidColorBrush x:Key="Amber33"      Color="#33C9A23E"/>   <!-- Amber, alpha 33 -->
    <SolidColorBrush x:Key="Emerald33"    Color="#332E9A84"/>   <!-- Emerald, alpha 33 -->
    <SolidColorBrush x:Key="Accent33"     Color="#33466EA1"/>   <!-- Accent, alpha 33 -->
    <SolidColorBrush x:Key="White22"      Color="#22FFFFFF"/>   <!-- White, alpha 22 -->
    <SolidColorBrush x:Key="DeepInk"      Color="#FF16181A"/>   <!-- IntelWindow search box background -->
    <SolidColorBrush x:Key="PaleLavender" Color="#FFE6ECF2"/>   <!-- IntelWindow search box text -->

    <!-- Task 5: SkillPlan, MainWindow, Settings -->
    <SolidColorBrush x:Key="BgFF"         Color="#FF151719"/>   <!-- Bg, alpha FF -->
    <SolidColorBrush x:Key="Bg11"         Color="#11151719"/>   <!-- Bg, alpha 11 -->
    <SolidColorBrush x:Key="BgDD"         Color="#DD151719"/>   <!-- Bg, alpha DD -->
    <SolidColorBrush x:Key="BorderCC"     Color="#CC353C41"/>   <!-- Border, alpha CC -->
    <SolidColorBrush x:Key="SteelBlue"    Color="#FF40484F"/>   <!-- MainWindow/SettingsWindow border colour -->
    <SolidColorBrush x:Key="White"        Color="#FFFFFFFF"/>   <!-- base white -->
    <SolidColorBrush x:Key="Black"        Color="#FF000000"/>   <!-- base black -->
    <SolidColorBrush x:Key="White0D"      Color="#0DFFFFFF"/>   <!-- White, alpha 0D -->
    <SolidColorBrush x:Key="White44"      Color="#44FFFFFF"/>   <!-- White, alpha 44 -->
    <SolidColorBrush x:Key="Accent1A"     Color="#1A466EA1"/>   <!-- Accent, alpha 1A -->
    <SolidColorBrush x:Key="Accent66"     Color="#66466EA1"/>   <!-- Accent, alpha 66 -->
    <SolidColorBrush x:Key="Amber22"      Color="#22C9A23E"/>   <!-- Amber, alpha 22 -->
    <SolidColorBrush x:Key="Orange"       Color="#FFC97C2E"/>   <!-- MainWindow PIRATES report button -->
    <SolidColorBrush x:Key="Orange33"     Color="#33C97C2E"/>   <!-- Orange, alpha 33 -->
    <SolidColorBrush x:Key="SlateGray"    Color="#FF6C8199"/>   <!-- SkillPlanWindow tooltip note text -->
    <SolidColorBrush x:Key="AquaBlue"     Color="#226D91BF"/>   <!-- MainWindow multibox card hover highlight -->
    <SolidColorBrush x:Key="Graphite"     Color="#CC1A1D20"/>   <!-- MainWindow panel launcher background -->
    <SolidColorBrush x:Key="Obsidian"     Color="#CC111315"/>   <!-- MainWindow footer background -->
    <SolidColorBrush x:Key="InkBlue"      Color="#CC181B1D"/>   <!-- MainWindow sponsor banner background -->
    <SolidColorBrush x:Key="Black01"      Color="#01000000"/>   <!-- MainWindow resize-strip hit-test regions -->
    <SolidColorBrush x:Key="TwilightBlue" Color="#FF3C444A"/>   <!-- SettingsWindow default button background -->
    <SolidColorBrush x:Key="Cyan"         Color="#FF6ED3F0"/>   <!-- SettingsWindow accent cyan -->
    <SolidColorBrush x:Key="DeepTeal"     Color="#FF1E3A34"/>   <!-- SettingsWindow primary button background -->
    <SolidColorBrush x:Key="MintGreen"    Color="#FF7FD8C4"/>   <!-- SettingsWindow linked-character bullet -->
    <SolidColorBrush x:Key="SlateNavy"    Color="#FF566B81"/>   <!-- SettingsWindow faint hint text -->

    <!-- Task 7: StandingGuideWindow -->
    <SolidColorBrush x:Key="Bg0A"         Color="#0A151719"/>   <!-- Bg, alpha 0A -->
    <SolidColorBrush x:Key="Accent0A"     Color="#0A466EA1"/>   <!-- Accent, alpha 0A -->
    <SolidColorBrush x:Key="DuskBlue"     Color="#3340484F"/>   <!-- StandingGuideWindow faction ListBoxItem selected background -->
    <SolidColorBrush x:Key="Border33"     Color="#33353C41"/>   <!-- Border, alpha 33 -->
    <SolidColorBrush x:Key="Green0A"      Color="#0A2E9A84"/>   <!-- Green, alpha 0A -->
    <SolidColorBrush x:Key="SkyBlue"      Color="#FF6ED3F0"/>   <!-- StandingGuideWindow TIP text -->
    <SolidColorBrush x:Key="Amber1A"      Color="#1AC9A23E"/>   <!-- Amber, alpha 1A -->
    <SolidColorBrush x:Key="Green15"      Color="#152E9A84"/>   <!-- Green, alpha 15 -->
    <SolidColorBrush x:Key="Accent15"     Color="#15466EA1"/>   <!-- Accent, alpha 15 -->
    <SolidColorBrush x:Key="Amber15"      Color="#15C9A23E"/>   <!-- Amber, alpha 15 -->
    <SolidColorBrush x:Key="Red1A"        Color="#1AC9402E"/>   <!-- Red, alpha 1A -->
    <SolidColorBrush x:Key="Ivory"        Color="#22F0D68A"/>   <!-- StandingGuideWindow Order button background -->

    <!-- Shared control styles (Styles.Default.xaml) -->
    <SolidColorBrush x:Key="ComboBg" Color="#FF16181A"/>   <!-- ComboBox face -->
    <SolidColorBrush x:Key="ComboBorder" Color="#FF40484F"/>   <!-- ComboBox / ToolTip border -->
    <SolidColorBrush x:Key="ComboItemBg" Color="#FF23282B"/>   <!-- ComboBox item background -->
    <SolidColorBrush x:Key="ComboHover" Color="#FF2B3034"/>   <!-- ComboBox item hover -->
    <SolidColorBrush x:Key="ComboSelect" Color="#FF353C41"/>   <!-- ComboBox item selected -->
    <SolidColorBrush x:Key="IceBlue" Color="#FF6ED3F0"/>   <!-- ComboBox selected text -->
    <SolidColorBrush x:Key="ComboEdge" Color="#FF3C444A"/>   <!-- ComboBox drop-down edge -->
    <SolidColorBrush x:Key="Indigo44" Color="#4440484F"/>   <!-- ComboBox popup shadow -->


    <!-- Role marker. ThemeManager swaps dictionaries by this, not by
         guessing from the keys they contain. -->
    <sys:String x:Key="__SkinDictionaryRole"
                xmlns:sys="clr-namespace:System;assembly=mscorlib">Tokens</sys:String>

    <!-- Skin-specific tokens. No counterpart in the default theme: these
         exist only for skins whose component layer draws things the
         default one does not (key bevels, glass, hazard striping). -->
    <SolidColorBrush x:Key="AccentKeyHi"  Color="#FF466EA1"/>
    <SolidColorBrush x:Key="AccentKeyLo"  Color="#FF335075"/>
    <SolidColorBrush x:Key="AmberKeyHi"   Color="#FF4A3D1F"/>
    <SolidColorBrush x:Key="AmberKeyLo"   Color="#FF382E15"/>
    <SolidColorBrush x:Key="GlassBorder"  Color="#FF0A0C0D"/>
    <SolidColorBrush x:Key="GlassBottom"  Color="#FF0A0B0C"/>
    <SolidColorBrush x:Key="GlassGlowTop" Color="#FF46AAE6"/>
    <SolidColorBrush x:Key="GlassText"    Color="#FF74A4C4"/>
    <SolidColorBrush x:Key="GlassTextHi"  Color="#FF6ED3F0"/>
    <SolidColorBrush x:Key="GlassTop"     Color="#FF121517"/>
    <SolidColorBrush x:Key="GreenKeyHi"   Color="#FF1E3A34"/>
    <SolidColorBrush x:Key="GreenKeyLo"   Color="#FF152A26"/>
    <SolidColorBrush x:Key="HazardA"      Color="#FFC9A23E"/>
    <SolidColorBrush x:Key="HazardB"      Color="#FF0E1620"/>
    <SolidColorBrush x:Key="KeyBorder"    Color="#FF262B2E"/>
    <SolidColorBrush x:Key="KeyEdge"      Color="#FF16181A"/>
    <SolidColorBrush x:Key="KeyHi"        Color="#FF515B63"/>
    <SolidColorBrush x:Key="KeyLip"       Color="#FF8FA0B0"/>
    <SolidColorBrush x:Key="KeyLo"        Color="#FF3C444A"/>
    <SolidColorBrush x:Key="RedKeyHi"     Color="#FF442426"/>
    <SolidColorBrush x:Key="RedKeyLo"     Color="#FF33191B"/>

    <LinearGradientBrush x:Key="KeyFace" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF515B63"/>
        <GradientStop Offset="1" Color="#FF3C444A"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentKeyFace" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF466EA1"/>
        <GradientStop Offset="1" Color="#FF335075"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AmberKeyFace" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF4A3D1F"/>
        <GradientStop Offset="1" Color="#FF382E15"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="RedKeyFace" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF442426"/>
        <GradientStop Offset="1" Color="#FF33191B"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GreenKeyFace" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF1E3A34"/>
        <GradientStop Offset="1" Color="#FF152A26"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassFace" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF121517"/>
        <GradientStop Offset="1" Color="#FF0A0B0C"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PlateFace" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF23282B"/>
        <GradientStop Offset="1" Color="#FF151719"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="KeySheen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#26FFFFFF"/>
        <GradientStop Offset="1" Color="#00FFFFFF"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="KeySheenLit" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#40FFFFFF"/>
        <GradientStop Offset="1" Color="#00FFFFFF"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PlateSheen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#0DFFFFFF"/>
        <GradientStop Offset="1" Color="#00FFFFFF"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassGlow" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#1F46AAE6"/>
        <GradientStop Offset="1" Color="#0046AAE6"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassBezel" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#80000000"/>
        <GradientStop Offset="1" Color="#00000000"/>
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="GlassAqua" Center="0.5,-0.55" GradientOrigin="0.5,-0.55" RadiusX="1.5" RadiusY="1.15">
        <GradientStop Offset="0" Color="#47FFFFFF"/>
        <GradientStop Offset="0.55" Color="#2BFFFFFF"/>
        <GradientStop Offset="0.7" Color="#1CFFFFFF"/>
        <GradientStop Offset="0.72" Color="#00FFFFFF"/>
        <GradientStop Offset="1" Color="#00FFFFFF"/>
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="GlassBounce" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#0046AAE6"/>
        <GradientStop Offset="1" Color="#3346AAE6"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassField" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#4D000000"/>
        <GradientStop Offset="1" Color="#4D000000"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassFieldEdge" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#4046AAE6"/>
        <GradientStop Offset="1" Color="#2646AAE6"/>
    </LinearGradientBrush>
</ResourceDictionary>
