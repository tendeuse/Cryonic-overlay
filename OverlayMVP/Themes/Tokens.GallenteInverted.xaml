<!-- filename: Themes/Tokens.Default.xaml -->
<!--
  The default theme's colours. This is the file a skin replaces.

  Names come from Themes/design-reference/*.css so the CSS skins and this XAML
  share one vocabulary (cx-text-dim -> TextDim). VALUES are today's overlay
  colours, not the reference's — this theme must look exactly like the app
  always has.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Bg"      Color="#CC0C1913"/>   <!-- was BgPanel -->
    <SolidColorBrush x:Key="Panel"   Color="#8814291F"/>   <!-- was BgCard -->
    <SolidColorBrush x:Key="Well"    Color="#EE09130E"/>   <!-- was BgMultibox -->

    <!-- Borders -->
    <SolidColorBrush x:Key="Border"  Color="#FF254B38"/>

    <!-- Text -->
    <SolidColorBrush x:Key="Text"    Color="#FFE4EDE6"/>   <!-- was TextPrimary -->
    <SolidColorBrush x:Key="TextDim" Color="#FF9DB3A5"/>   <!-- was TextSecondary -->

    <!-- Accents -->
    <SolidColorBrush x:Key="Accent"  Color="#FF5C9683"/>   <!-- was AccentBlue -->
    <SolidColorBrush x:Key="Amber"   Color="#FFC9A23E"/>   <!-- was AccentGold -->
    <SolidColorBrush x:Key="Red"     Color="#FFC9402E"/>   <!-- was AccentRed -->
    <SolidColorBrush x:Key="Green"   Color="#FF3E9A5D"/>   <!-- was AccentGreen -->

    <!-- Task 3: five smallest windows -->
    <SolidColorBrush x:Key="Surface"      Color="#FF11231A"/>   <!-- FirstRunWindow background -->
    <SolidColorBrush x:Key="PaleCyan"     Color="#FF8FC79B"/>   <!-- FirstRunWindow status text -->
    <SolidColorBrush x:Key="BgEE"         Color="#EE0C1913"/>   <!-- Bg, alpha EE -->
    <SolidColorBrush x:Key="Border44"     Color="#44254B38"/>   <!-- Border, alpha 44 -->
    <SolidColorBrush x:Key="DeepNavy"     Color="#CC11231A"/>   <!-- ShipFitWindow title bar -->
    <SolidColorBrush x:Key="TextFaint"    Color="#FF6C8177"/>   <!-- ShipFitWindow close button -->
    <SolidColorBrush x:Key="Onyx"         Color="#CC11231A"/>   <!-- NotePrompt/MissionProgress title bar -->
    <SolidColorBrush x:Key="Border22"     Color="#22254B38"/>   <!-- Border, alpha 22 -->
    <SolidColorBrush x:Key="White33"      Color="#33FFFFFF"/>   <!-- NotePromptWindow Cancel button -->
    <SolidColorBrush x:Key="Green33"      Color="#333E9A5D"/>   <!-- Green, alpha 33 -->
    <SolidColorBrush x:Key="Red33"        Color="#33C9402E"/>   <!-- Red, alpha 33 -->
    <SolidColorBrush x:Key="Abyss"        Color="#FF060D0A"/>   <!-- ThumbnailWindow thumbnail host -->
    <SolidColorBrush x:Key="BorderStrong" Color="#FF2F6149"/>   <!-- ThumbnailWindow BorderClr (hoisted) -->

    <!-- Task 4: mid-size windows -->
    <SolidColorBrush x:Key="GunMetal"     Color="#09130E"/>     <!-- BriefingWindow window background -->
    <SolidColorBrush x:Key="Charcoal"     Color="#14291F"/>     <!-- BriefingWindow title bar / transport bar -->
    <SolidColorBrush x:Key="Accent22"     Color="#225C9683"/>   <!-- Accent, alpha 22 -->
    <SolidColorBrush x:Key="Accent88"     Color="#885C9683"/>   <!-- Accent, alpha 88 -->
    <SolidColorBrush x:Key="Green22"      Color="#223E9A5D"/>   <!-- Green, alpha 22 -->
    <SolidColorBrush x:Key="Green88"      Color="#883E9A5D"/>   <!-- Green, alpha 88 -->
    <SolidColorBrush x:Key="Gray22"       Color="#225C9683"/>   <!-- Gray, alpha 22 -->
    <SolidColorBrush x:Key="Gray88"       Color="#885C9683"/>   <!-- Gray, alpha 88 -->
    <SolidColorBrush x:Key="SteelGrey"    Color="#FF9DB3A5"/>   <!-- BriefingWindow Close button text -->
    <SolidColorBrush x:Key="White11"      Color="#11FFFFFF"/>   <!-- White, alpha 11 -->
    <SolidColorBrush x:Key="Amber33"      Color="#33C9A23E"/>   <!-- Amber, alpha 33 -->
    <SolidColorBrush x:Key="Emerald33"    Color="#333E8A5D"/>   <!-- Emerald, alpha 33 -->
    <SolidColorBrush x:Key="Accent33"     Color="#335C9683"/>   <!-- Accent, alpha 33 -->
    <SolidColorBrush x:Key="White22"      Color="#22FFFFFF"/>   <!-- White, alpha 22 -->
    <SolidColorBrush x:Key="DeepInk"      Color="#FF0E1C15"/>   <!-- IntelWindow search box background -->
    <SolidColorBrush x:Key="PaleLavender" Color="#FFE4EDE6"/>   <!-- IntelWindow search box text -->

    <!-- Task 5: SkillPlan, MainWindow, Settings -->
    <SolidColorBrush x:Key="BgFF"         Color="#FF0C1913"/>   <!-- Bg, alpha FF -->
    <SolidColorBrush x:Key="Bg11"         Color="#110C1913"/>   <!-- Bg, alpha 11 -->
    <SolidColorBrush x:Key="BgDD"         Color="#DD0C1913"/>   <!-- Bg, alpha DD -->
    <SolidColorBrush x:Key="BorderCC"     Color="#CC254B38"/>   <!-- Border, alpha CC -->
    <SolidColorBrush x:Key="SteelBlue"    Color="#FF2F6149"/>   <!-- MainWindow/SettingsWindow border colour -->
    <SolidColorBrush x:Key="White"        Color="#FFFFFFFF"/>   <!-- base white -->
    <SolidColorBrush x:Key="Black"        Color="#FF000000"/>   <!-- base black -->
    <SolidColorBrush x:Key="White0D"      Color="#0DFFFFFF"/>   <!-- White, alpha 0D -->
    <SolidColorBrush x:Key="White44"      Color="#44FFFFFF"/>   <!-- White, alpha 44 -->
    <SolidColorBrush x:Key="Accent1A"     Color="#1A5C9683"/>   <!-- Accent, alpha 1A -->
    <SolidColorBrush x:Key="Accent66"     Color="#665C9683"/>   <!-- Accent, alpha 66 -->
    <SolidColorBrush x:Key="Amber22"      Color="#22C9A23E"/>   <!-- Amber, alpha 22 -->
    <SolidColorBrush x:Key="Orange"       Color="#FFD08A3C"/>   <!-- MainWindow PIRATES report button -->
    <SolidColorBrush x:Key="Orange33"     Color="#33D08A3C"/>   <!-- Orange, alpha 33 -->
    <SolidColorBrush x:Key="SlateGray"    Color="#FF6C8177"/>   <!-- SkillPlanWindow tooltip note text -->
    <SolidColorBrush x:Key="AquaBlue"     Color="#22609F8A"/>   <!-- MainWindow multibox card hover highlight -->
    <SolidColorBrush x:Key="Graphite"     Color="#CC0F1F17"/>   <!-- MainWindow panel launcher background -->
    <SolidColorBrush x:Key="Obsidian"     Color="#CC09130E"/>   <!-- MainWindow footer background -->
    <SolidColorBrush x:Key="InkBlue"      Color="#CC0D1B14"/>   <!-- MainWindow sponsor banner background -->
    <SolidColorBrush x:Key="Black01"      Color="#01000000"/>   <!-- MainWindow resize-strip hit-test regions -->
    <SolidColorBrush x:Key="TwilightBlue" Color="#FF172E23"/>   <!-- SettingsWindow default button background -->
    <SolidColorBrush x:Key="Cyan"         Color="#FF7FD8AE"/>   <!-- SettingsWindow accent cyan -->
    <SolidColorBrush x:Key="DeepTeal"     Color="#FF1E3A2E"/>   <!-- SettingsWindow primary button background -->
    <SolidColorBrush x:Key="MintGreen"    Color="#FF8FC79B"/>   <!-- SettingsWindow linked-character bullet -->
    <SolidColorBrush x:Key="SlateNavy"    Color="#FF56675E"/>   <!-- SettingsWindow faint hint text -->

    <!-- Task 7: StandingGuideWindow -->
    <SolidColorBrush x:Key="Bg0A"         Color="#0A0C1913"/>   <!-- Bg, alpha 0A -->
    <SolidColorBrush x:Key="Accent0A"     Color="#0A5C9683"/>   <!-- Accent, alpha 0A -->
    <SolidColorBrush x:Key="DuskBlue"     Color="#332F6149"/>   <!-- StandingGuideWindow faction ListBoxItem selected background -->
    <SolidColorBrush x:Key="Border33"     Color="#33254B38"/>   <!-- Border, alpha 33 -->
    <SolidColorBrush x:Key="Green0A"      Color="#0A3E9A5D"/>   <!-- Green, alpha 0A -->
    <SolidColorBrush x:Key="SkyBlue"      Color="#FF7FD8AE"/>   <!-- StandingGuideWindow TIP text -->
    <SolidColorBrush x:Key="Amber1A"      Color="#1AC9A23E"/>   <!-- Amber, alpha 1A -->
    <SolidColorBrush x:Key="Green15"      Color="#153E9A5D"/>   <!-- Green, alpha 15 -->
    <SolidColorBrush x:Key="Accent15"     Color="#155C9683"/>   <!-- Accent, alpha 15 -->
    <SolidColorBrush x:Key="Amber15"      Color="#15C9A23E"/>   <!-- Amber, alpha 15 -->
    <SolidColorBrush x:Key="Red1A"        Color="#1AC9402E"/>   <!-- Red, alpha 1A -->
    <SolidColorBrush x:Key="Ivory"        Color="#22E8D08A"/>   <!-- StandingGuideWindow Order button background -->

    <!-- Shared control styles (Styles.Default.xaml) -->
    <SolidColorBrush x:Key="ComboBg" Color="#FF0F1F17"/>   <!-- ComboBox face -->
    <SolidColorBrush x:Key="ComboBorder" Color="#FF2F6149"/>   <!-- ComboBox / ToolTip border -->
    <SolidColorBrush x:Key="ComboItemBg" Color="#FF172E23"/>   <!-- ComboBox item background -->
    <SolidColorBrush x:Key="ComboHover" Color="#FF1D3B2C"/>   <!-- ComboBox item hover -->
    <SolidColorBrush x:Key="ComboSelect" Color="#FF254B38"/>   <!-- ComboBox item selected -->
    <SolidColorBrush x:Key="IceBlue" Color="#FF7FD8AE"/>   <!-- ComboBox selected text -->
    <SolidColorBrush x:Key="ComboEdge" Color="#FF2F6149"/>   <!-- ComboBox drop-down edge -->
    <SolidColorBrush x:Key="Indigo44" Color="#442F6149"/>   <!-- ComboBox popup shadow -->


    <!-- Role marker. ThemeManager swaps dictionaries by this, not by
         guessing from the keys they contain. -->
    <sys:String x:Key="__SkinDictionaryRole"
                xmlns:sys="clr-namespace:System;assembly=mscorlib">Tokens</sys:String>

    <!-- Skin-specific tokens. No counterpart in the default theme: these
         exist only for skins whose component layer draws things the
         default one does not (key bevels, glass, hazard striping). -->
    <SolidColorBrush x:Key="AccentKeyHi"  Color="#FF5C9683"/>
    <SolidColorBrush x:Key="AccentKeyLo"  Color="#FF426D5F"/>
    <SolidColorBrush x:Key="AmberKeyHi"   Color="#FF4A3D1F"/>
    <SolidColorBrush x:Key="AmberKeyLo"   Color="#FF382E15"/>
    <SolidColorBrush x:Key="GlassBorder"  Color="#FF070F0B"/>
    <SolidColorBrush x:Key="GlassBottom"  Color="#FF070D0A"/>
    <SolidColorBrush x:Key="GlassGlowTop" Color="#FF46B98A"/>
    <SolidColorBrush x:Key="GlassText"    Color="#FF7FB39A"/>
    <SolidColorBrush x:Key="GlassTextHi"  Color="#FF7FD8AE"/>
    <SolidColorBrush x:Key="GlassTop"     Color="#FF0C1812"/>
    <SolidColorBrush x:Key="GreenKeyHi"   Color="#FF1E3A2C"/>
    <SolidColorBrush x:Key="GreenKeyLo"   Color="#FF152A20"/>
    <SolidColorBrush x:Key="HazardA"      Color="#FFC9A23E"/>
    <SolidColorBrush x:Key="HazardB"      Color="#FF0E1714"/>
    <SolidColorBrush x:Key="KeyBorder"    Color="#FF2F6149"/>
    <SolidColorBrush x:Key="KeyEdge"      Color="#FF0E1C15"/>
    <SolidColorBrush x:Key="KeyHi"        Color="#FF214332"/>
    <SolidColorBrush x:Key="KeyLip"       Color="#FF7E9A88"/>
    <SolidColorBrush x:Key="KeyLo"        Color="#FF183225"/>
    <SolidColorBrush x:Key="RedKeyHi"     Color="#FF442426"/>
    <SolidColorBrush x:Key="RedKeyLo"     Color="#FF33191B"/>

    <LinearGradientBrush x:Key="KeyFace" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF214332"/>
        <GradientStop Offset="1" Color="#FF183225"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentKeyFace" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF5C9683"/>
        <GradientStop Offset="1" Color="#FF426D5F"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AmberKeyFace" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF4A3D1F"/>
        <GradientStop Offset="1" Color="#FF382E15"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="RedKeyFace" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF442426"/>
        <GradientStop Offset="1" Color="#FF33191B"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GreenKeyFace" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF1E3A2C"/>
        <GradientStop Offset="1" Color="#FF152A20"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassFace" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF0C1812"/>
        <GradientStop Offset="1" Color="#FF070D0A"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PlateFace" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF14291F"/>
        <GradientStop Offset="1" Color="#FF0C1913"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="KeySheen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#26FFFFFF"/>
        <GradientStop Offset="1" Color="#00FFFFFF"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="KeySheenLit" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#40FFFFFF"/>
        <GradientStop Offset="1" Color="#00FFFFFF"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PlateSheen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#0DFFFFFF"/>
        <GradientStop Offset="1" Color="#00FFFFFF"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassGlow" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#1F46B98A"/>
        <GradientStop Offset="1" Color="#0046B98A"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassBezel" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#80000000"/>
        <GradientStop Offset="1" Color="#00000000"/>
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="GlassAqua" Center="0.5,-0.55" GradientOrigin="0.5,-0.55" RadiusX="1.5" RadiusY="1.15">
        <GradientStop Offset="0" Color="#47FFFFFF"/>
        <GradientStop Offset="0.55" Color="#2BFFFFFF"/>
        <GradientStop Offset="0.7" Color="#1CFFFFFF"/>
        <GradientStop Offset="0.72" Color="#00FFFFFF"/>
        <GradientStop Offset="1" Color="#00FFFFFF"/>
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="GlassBounce" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#0046B98A"/>
        <GradientStop Offset="1" Color="#3346B98A"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassField" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#4D000000"/>
        <GradientStop Offset="1" Color="#4D000000"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassFieldEdge" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#4046B98A"/>
        <GradientStop Offset="1" Color="#2646B98A"/>
    </LinearGradientBrush>
</ResourceDictionary>
