<!-- filename: Themes/Styles.Default.xaml -->
<!--
  The default theme's control styles, moved unchanged from App.xaml.

  Kept separate from Tokens.Default.xaml because the three cockpit skins share
  ONE component layer and differ only in colour ("the markup / class names never
  change between skins" — design-reference header). Splitting means those skins
  reuse a single styles file over three token files instead of duplicating it.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="clr-namespace:OverlayMVP.Controls">

        <!-- ══════════════════════════════════════════════════════════════════
             ComboBox — application-wide dark high-contrast style.
             Full ControlTemplate required: without it the popup always renders
             with the system (light) theme regardless of Background/Foreground.
             ══════════════════════════════════════════════════════════════════ -->

        <!-- Drop-down list item -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background"  Value="{DynamicResource ComboBg}"/>
            <Setter Property="Foreground"  Value="{DynamicResource Text}"/>
            <Setter Property="FontFamily"  Value="Consolas"/>
            <Setter Property="FontSize"    Value="{DynamicResource GlobalFontSize}"/>
            <Setter Property="Padding"     Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ComboHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ComboSelect}"/>
                                <Setter Property="Foreground" Value="{DynamicResource IceBlue}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected"   Value="True"/>
                                    <Condition Property="IsMouseOver"  Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ComboEdge}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The collapsed box + the popup together -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground"           Value="{DynamicResource Text}"/>
            <Setter Property="FontFamily"           Value="Consolas"/>
            <Setter Property="FontSize"             Value="{DynamicResource GlobalFontSize}"/>
            <Setter Property="MinHeight"            Value="26"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- Collapsed toggle-button shell -->
                            <ToggleButton x:Name="ToggleButton"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Shell"
                                                Background="{DynamicResource ComboBg}"
                                                BorderBrush="{DynamicResource ComboBorder}"
                                                BorderThickness="1"
                                                CornerRadius="3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="22"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Selected value label -->
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding RelativeSource={RelativeSource AncestorType=ComboBox},
                                                                          Path=SelectionBoxItem}"
                                                           Foreground="{DynamicResource Text}"
                                                           FontFamily="Consolas"
                                                           FontSize="{DynamicResource GlobalFontSize}"
                                                           Margin="8,4,4,4"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <!-- Chevron separator + arrow -->
                                                <Border Grid.Column="1"
                                                        BorderBrush="{DynamicResource ComboBorder}"
                                                        BorderThickness="1,0,0,0">
                                                    <TextBlock Text="▾"
                                                               Foreground="{DynamicResource Accent}"
                                                               FontSize="{DynamicResource GlobalFontSizeSm}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                <Setter TargetName="Shell" Property="Background"  Value="{DynamicResource ComboItemBg}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                <Setter TargetName="Shell" Property="Background"  Value="{DynamicResource ComboItemBg}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- Dropdown popup -->
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDown"
                                        Background="{DynamicResource ComboBg}"
                                        BorderBrush="{DynamicResource ComboBorder}"
                                        BorderThickness="1"
                                        CornerRadius="0,0,3,3"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Base text ──────────────────────────────────────────────────── -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily"  Value="Consolas"/>
            <Setter Property="Foreground"  Value="{DynamicResource Text}"/>
            <Setter Property="FontSize"    Value="{DynamicResource GlobalFontSize}"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontFamily"  Value="Consolas"/>
            <Setter Property="FontWeight"  Value="Bold"/>
            <Setter Property="FontSize"    Value="{DynamicResource GlobalFontSizeSm}"/>
            <Setter Property="Foreground"  Value="{DynamicResource Accent}"/>
            <Setter Property="Margin"      Value="0,0,0,4"/>
        </Style>

        <!-- ── Intel badge button (base for SmallBtn) ────────────────────── -->
        <Style x:Key="IntelBtn" TargetType="Button">
            <Setter Property="FontFamily"        Value="Consolas"/>
            <Setter Property="FontSize"          Value="{DynamicResource GlobalFontSizeSm}"/>
            <Setter Property="FontWeight"        Value="Bold"/>
            <Setter Property="Foreground"        Value="{DynamicResource Accent}"/>
            <Setter Property="Background"        Value="{DynamicResource Border22}"/>
            <Setter Property="BorderBrush"       Value="{DynamicResource Indigo44}"/>
            <Setter Property="BorderThickness"   Value="1"/>
            <Setter Property="Padding"           Value="8,4"/>
            <Setter Property="Cursor"            Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Launcher key ───────────────────────────────────────────────
             The full-width keys in the panel launcher row.

             Exists so a skin can change how BIG a launcher key is, not only
             what colour it is. These three values used to sit on each button
             in MainWindow.xaml, where a style cannot override them — so a
             cockpit skin could restyle a key's surface but never its
             proportions, which is half of what makes a key look physical.

             Values are exactly what the instances carried, so the default
             renders identically. -->
        <Style x:Key="LauncherBtn" TargetType="Button" BasedOn="{StaticResource IntelBtn}">
            <Setter Property="Padding"             Value="10,5"/>
            <Setter Property="Margin"              Value="0,2"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <!-- ── Status key ─────────────────────────────────────────────────
             The intel report buttons (GATE CAMP, PIRATES, ROAMING).

             Adds nothing to IntelBtn here — the default draws them exactly as
             it always has. It exists so a skin can tell a REPORT key apart
             from a launcher key, which share IntelBtn and would otherwise be
             indistinguishable to the styles layer. Each instance already
             carries its own BorderBrush (red, orange, amber); a skin can read
             that as an indicator colour. -->
        <Style x:Key="StatusKey" TargetType="Button" BasedOn="{StaticResource IntelBtn}"/>

        <!-- ── Small action button ────────────────────────────────────────── -->
        <Style x:Key="SmallBtn" TargetType="Button" BasedOn="{StaticResource IntelBtn}">
            <Setter Property="FontSize"    Value="{DynamicResource GlobalFontSizeXs}"/>
            <Setter Property="Padding"     Value="6,2"/>
        </Style>

        <!-- ── ToolTip (dark theme) ───────────────────────────────────────
             Without this, tooltips use WPF's pale default background while
             inheriting the app's near-white foreground — unreadable. -->
        <Style TargetType="ToolTip">
            <Setter Property="Background"      Value="{DynamicResource BgFF}"/>
            <Setter Property="Foreground"      Value="{DynamicResource Text}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource Accent}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="8,5"/>
            <Setter Property="FontSize"        Value="{DynamicResource GlobalFontSizeXs}"/>
            <Setter Property="HasDropShadow"   Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          SectionPanel default look: reproduces today's <Border><StackPanel> exactly.
          Background/BorderBrush/BorderThickness/Padding are TemplateBound so each
          usage keeps its own values — row 2 is Well/SteelBlue/0,0,0,1 while rows 3
          and 4 are Panel/Border/0,1,0,1, and merging them would be a visual change.
          CornerRadius is TemplateBound too but has no Setter here — its DP default
          is 0, matching rows 2/3/4 (square corners); the footer sets 0,0,8,8 on the
          instance.
        -->
        <Style TargetType="{x:Type ctl:SectionPanel}">
            <Setter Property="Background"      Value="{DynamicResource Panel}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="0,1,0,1"/>
            <Setter Property="Padding"         Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ctl:SectionPanel}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel>
                                <!-- Header row. Collapses entirely when no Header is
                                     set, so the footer can use the same control.

                                     THE GAP UNDER THE HEADER BELONGS HERE, not to the
                                     content a window passes in. That is the whole point
                                     of the refactor: a skin replaces this template and
                                     gets to choose the spacing. If instead each window
                                     supplied its own margin, the values would sit in
                                     MainWindow.xaml where no skin can reach them, and a
                                     skin that changed this gap would leave every header
                                     accessory misaligned by the difference.

                                     So both slots must contribute ZERO margin of their
                                     own. Header content is styled with SectionHeader,
                                     which carries Margin="0,0,0,4" for the other windows
                                     that use it standalone. Inside a SectionPanel that
                                     must be overridden with Margin="0", or it stacks with
                                     this one and doubles the gap to 8px. -->
                                <Grid x:Name="HeaderRow" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      ContentSource="Header"
                                                      VerticalAlignment="Center"/>
                                    <ContentPresenter Grid.Column="1"
                                                      Content="{TemplateBinding HeaderAccessory}"
                                                      VerticalAlignment="Center"/>
                                </Grid>
                                <!-- Section controls. The default draws them
                                     inline, immediately above the content,
                                     which is where they sat before the slot
                                     existed. Collapsed when unset. -->
                                <ContentPresenter x:Name="ToolbarHost"
                                                  Content="{TemplateBinding Toolbar}"/>
                                <ContentPresenter/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Toolbar" Value="{x:Null}">
                                <Setter TargetName="ToolbarHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="Header" Value="{x:Null}">
                                <Setter TargetName="HeaderRow" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          WindowShell default look: today's outer Border, verbatim.

          TextElement.FontSize is deliberately NOT set here. It is a user
          setting (SettingsWindow writes it, App.xaml.cs pushes it into
          Application.Current.Resources at startup), not chrome, so it lives
          on the ctl:WindowShell instance in MainWindow.xaml instead — the
          same place today's outer Border sets it. A skin that supplies its
          own WindowShell template cannot silently reset it by omission.
        -->
        <Style TargetType="{x:Type ctl:WindowShell}">
            <Setter Property="Background"      Value="{DynamicResource Bg}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ctl:WindowShell}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TitleBar default look: today's row-0 Border, verbatim. -->
        <Style TargetType="{x:Type ctl:TitleBar}">
            <Setter Property="Background"      Value="{DynamicResource Onyx}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius"    Value="8,8,0,0"/>
            <Setter Property="Padding"         Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ctl:TitleBar}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


    <!-- Role marker. ThemeManager swaps dictionaries by this, not by
         guessing from the keys they contain. -->
    <sys:String x:Key="__SkinDictionaryRole"
                xmlns:sys="clr-namespace:System;assembly=mscorlib">Styles</sys:String>
</ResourceDictionary>
