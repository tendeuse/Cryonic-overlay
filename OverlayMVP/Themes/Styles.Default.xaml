<!-- filename: Themes/Styles.Default.xaml -->
<!--
  The default theme's control styles, moved unchanged from App.xaml.

  Kept separate from Tokens.Default.xaml because the three cockpit skins share
  ONE component layer and differ only in colour ("the markup / class names never
  change between skins" — design-reference header). Splitting means those skins
  reuse a single styles file over three token files instead of duplicating it.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="clr-namespace:OverlayMVP.Controls">

        <!-- ══════════════════════════════════════════════════════════════════
             ComboBox — application-wide dark high-contrast style.
             Full ControlTemplate required: without it the popup always renders
             with the system (light) theme regardless of Background/Foreground.
             ══════════════════════════════════════════════════════════════════ -->

        <!-- Drop-down list item -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background"  Value="{DynamicResource ComboBg}"/>
            <Setter Property="Foreground"  Value="{DynamicResource Text}"/>
            <Setter Property="FontFamily"  Value="Consolas"/>
            <Setter Property="FontSize"    Value="{DynamicResource GlobalFontSize}"/>
            <Setter Property="Padding"     Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ComboHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ComboSelect}"/>
                                <Setter Property="Foreground" Value="{DynamicResource IceBlue}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected"   Value="True"/>
                                    <Condition Property="IsMouseOver"  Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ComboEdge}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The collapsed box + the popup together -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground"           Value="{DynamicResource Text}"/>
            <Setter Property="FontFamily"           Value="Consolas"/>
            <Setter Property="FontSize"             Value="{DynamicResource GlobalFontSize}"/>
            <Setter Property="MinHeight"            Value="26"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- Collapsed toggle-button shell -->
                            <ToggleButton x:Name="ToggleButton"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Shell"
                                                Background="{DynamicResource ComboBg}"
                                                BorderBrush="{DynamicResource ComboBorder}"
                                                BorderThickness="1"
                                                CornerRadius="3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="22"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Selected value label -->
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding RelativeSource={RelativeSource AncestorType=ComboBox},
                                                                          Path=SelectionBoxItem}"
                                                           Foreground="{DynamicResource Text}"
                                                           FontFamily="Consolas"
                                                           FontSize="{DynamicResource GlobalFontSize}"
                                                           Margin="8,4,4,4"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <!-- Chevron separator + arrow -->
                                                <Border Grid.Column="1"
                                                        BorderBrush="{DynamicResource ComboBorder}"
                                                        BorderThickness="1,0,0,0">
                                                    <TextBlock Text="▾"
                                                               Foreground="{DynamicResource Accent}"
                                                               FontSize="{DynamicResource GlobalFontSizeSm}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                <Setter TargetName="Shell" Property="Background"  Value="{DynamicResource ComboItemBg}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                <Setter TargetName="Shell" Property="Background"  Value="{DynamicResource ComboItemBg}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- Dropdown popup -->
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDown"
                                        Background="{DynamicResource ComboBg}"
                                        BorderBrush="{DynamicResource ComboBorder}"
                                        BorderThickness="1"
                                        CornerRadius="0,0,3,3"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Base text ──────────────────────────────────────────────────── -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily"  Value="Consolas"/>
            <Setter Property="Foreground"  Value="{DynamicResource Text}"/>
            <Setter Property="FontSize"    Value="{DynamicResource GlobalFontSize}"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontFamily"  Value="Consolas"/>
            <Setter Property="FontWeight"  Value="Bold"/>
            <Setter Property="FontSize"    Value="{DynamicResource GlobalFontSizeSm}"/>
            <Setter Property="Foreground"  Value="{DynamicResource Accent}"/>
            <Setter Property="Margin"      Value="0,0,0,4"/>
        </Style>

        <!-- ── Intel badge button (base for SmallBtn) ────────────────────── -->
        <Style x:Key="IntelBtn" TargetType="Button">
            <Setter Property="FontFamily"        Value="Consolas"/>
            <Setter Property="FontSize"          Value="{DynamicResource GlobalFontSizeSm}"/>
            <Setter Property="FontWeight"        Value="Bold"/>
            <Setter Property="Foreground"        Value="{DynamicResource Accent}"/>
            <Setter Property="Background"        Value="{DynamicResource Border22}"/>
            <Setter Property="BorderBrush"       Value="{DynamicResource Indigo44}"/>
            <Setter Property="BorderThickness"   Value="1"/>
            <Setter Property="Padding"           Value="8,4"/>
            <Setter Property="Cursor"            Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Small action button ────────────────────────────────────────── -->
        <Style x:Key="SmallBtn" TargetType="Button" BasedOn="{StaticResource IntelBtn}">
            <Setter Property="FontSize"    Value="{DynamicResource GlobalFontSizeXs}"/>
            <Setter Property="Padding"     Value="6,2"/>
        </Style>

        <!-- ── ToolTip (dark theme) ───────────────────────────────────────
             Without this, tooltips use WPF's pale default background while
             inheriting the app's near-white foreground — unreadable. -->
        <Style TargetType="ToolTip">
            <Setter Property="Background"      Value="{DynamicResource BgFF}"/>
            <Setter Property="Foreground"      Value="{DynamicResource Text}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource Accent}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="8,5"/>
            <Setter Property="FontSize"        Value="{DynamicResource GlobalFontSizeXs}"/>
            <Setter Property="HasDropShadow"   Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          SectionPanel default look: reproduces today's <Border><StackPanel> exactly.
          Background/BorderBrush/BorderThickness/Padding are TemplateBound so each
          usage keeps its own values — row 2 is Well/SteelBlue/0,0,0,1 while rows 3
          and 4 are Panel/Border/0,1,0,1, and merging them would be a visual change.
        -->
        <Style TargetType="{x:Type ctl:SectionPanel}">
            <Setter Property="Background"      Value="{DynamicResource Panel}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="0,1,0,1"/>
            <Setter Property="Padding"         Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ctl:SectionPanel}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel>
                                <!-- Header row. Collapses entirely when no Header is
                                     set, so the footer can use the same control. No
                                     margin here: the header content (a TextBlock
                                     styled with SectionHeader, or a Grid built to
                                     match it) already carries its own bottom margin.
                                     Adding one here doubled the gap under row 2's
                                     plain text header (0,0,0,4 template plus 0,0,0,4
                                     from the SectionHeader style = 8px, not 4px). -->
                                <Grid x:Name="HeaderRow">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      ContentSource="Header"
                                                      VerticalAlignment="Center"/>
                                    <ContentPresenter Grid.Column="1"
                                                      Content="{TemplateBinding HeaderAccessory}"
                                                      VerticalAlignment="Center"/>
                                </Grid>
                                <ContentPresenter/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Header" Value="{x:Null}">
                                <Setter TargetName="HeaderRow" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

</ResourceDictionary>
