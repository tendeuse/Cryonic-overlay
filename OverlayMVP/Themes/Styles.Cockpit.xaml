<!-- filename: Themes/Styles.Cockpit.xaml -->
<!--
  The cockpit component layer, shared by all three cockpit skins.

  Derived from Styles.Default.xaml and deliberately kept key-for-key identical
  to it. A skin's styles dictionary REPLACES the default one wholesale, so any
  x:Key present there and missing here renders that control with no style at
  all — WPF raises nothing, the control simply loses its appearance. Starting
  from a copy makes that impossible by construction; tools/skin-check.mjs keeps
  it true.

  What differs from the default is treatment, not structure: keys have a bevel
  and travel, sections carry a gold top rule, wells read as glass. The three
  cockpit token files supply the colours ("the markup / class names never change
  between skins" — design-reference header), so this file is written once.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="clr-namespace:OverlayMVP.Controls">

        <!-- ══════════════════════════════════════════════════════════════════
             TYPEFACES
             Barlow, embedded in the assembly (see OverlayMVP.csproj). The
             console legend look depends on condensed caps far more than on
             any colour, so this is skin data, not decoration.

             The "#Barlow Condensed" suffix is the font's INTERNAL family name,
             not a filename — WPF looks the family up inside the resource
             folder. Get it wrong and there is no error: WPF quietly renders
             the fallback, which is why the trailing Consolas is spelled out
             rather than left to chance.

             StaticResource, not Dynamic: a skin's typeface cannot change
             while that skin is applied, and it keeps these out of the
             colour-token namespace that skin-check verifies.
             ══════════════════════════════════════════════════════════════════ -->
        <FontFamily x:Key="HeadFont">pack://application:,,,/Fonts/#Barlow Condensed, Consolas</FontFamily>
        <FontFamily x:Key="BodyFont">pack://application:,,,/Fonts/#Barlow, Consolas</FontFamily>

        <!-- ══════════════════════════════════════════════════════════════════
             CONSOLE MATERIALS
             Patterns rather than colours, so they live here and not in a
             palette: a scanline is black regardless of what colour the skin
             paints its glass, and hazard striping is diagonal in every skin
             that has it. Only their COLOURS come from tokens.
             ══════════════════════════════════════════════════════════════════ -->

        <!-- CRT scanlines. Tiled 3px: one dark row, two clear. Laid over glass
             at low opacity so text stays readable. -->
        <DrawingBrush x:Key="Scanlines" TileMode="Tile"
                      Viewport="0,0,2,2" ViewportUnits="Absolute"
                      Opacity="1.0">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="#59000000">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,2,1"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- Hazard striping: 45° brass and dark, the way a real panel marks a
             caution strip. -->
        <DrawingBrush x:Key="HazardStripe" TileMode="Tile"
                      Viewport="0,0,14,14" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="{DynamicResource HazardB}">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,14,14"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="{DynamicResource HazardA}">
                        <GeometryDrawing.Geometry>
                            <PathGeometry Figures="M0,14 L14,0 L14,7 L7,14 Z"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="{DynamicResource HazardA}">
                        <GeometryDrawing.Geometry>
                            <PathGeometry Figures="M0,7 L7,0 L0,0 Z"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- ══════════════════════════════════════════════════════════════════
             ComboBox — application-wide dark high-contrast style.
             Full ControlTemplate required: without it the popup always renders
             with the system (light) theme regardless of Background/Foreground.
             ══════════════════════════════════════════════════════════════════ -->

        <!-- Drop-down list item -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background"  Value="{DynamicResource ComboBg}"/>
            <Setter Property="Foreground"  Value="{DynamicResource Text}"/>
            <Setter Property="FontFamily"  Value="{StaticResource BodyFont}"/>
            <Setter Property="FontSize"    Value="{DynamicResource GlobalFontSize}"/>
            <Setter Property="Padding"     Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ComboHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ComboSelect}"/>
                                <Setter Property="Foreground" Value="{DynamicResource IceBlue}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected"   Value="True"/>
                                    <Condition Property="IsMouseOver"  Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ComboEdge}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The collapsed box + the popup together -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground"           Value="{DynamicResource Text}"/>
            <Setter Property="FontFamily"           Value="{StaticResource BodyFont}"/>
            <Setter Property="FontSize"             Value="{DynamicResource GlobalFontSize}"/>
            <Setter Property="MinHeight"            Value="26"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- Collapsed toggle-button shell -->
                            <ToggleButton x:Name="ToggleButton"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Shell"
                                                Background="{DynamicResource ComboBg}"
                                                BorderBrush="{DynamicResource ComboBorder}"
                                                BorderThickness="1"
                                                CornerRadius="3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="22"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Selected value label -->
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding RelativeSource={RelativeSource AncestorType=ComboBox},
                                                                          Path=SelectionBoxItem}"
                                                           Foreground="{DynamicResource Text}"
                                                           FontFamily="{StaticResource BodyFont}"
                                                           FontSize="{DynamicResource GlobalFontSize}"
                                                           Margin="8,4,4,4"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <!-- Chevron separator + arrow -->
                                                <Border Grid.Column="1"
                                                        BorderBrush="{DynamicResource ComboBorder}"
                                                        BorderThickness="1,0,0,0">
                                                    <TextBlock Text="▾"
                                                               Foreground="{DynamicResource Accent}"
                                                               FontSize="{DynamicResource GlobalFontSizeSm}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                <Setter TargetName="Shell" Property="Background"  Value="{DynamicResource ComboItemBg}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                <Setter TargetName="Shell" Property="Background"  Value="{DynamicResource ComboItemBg}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- Dropdown popup -->
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDown"
                                        Background="{DynamicResource ComboBg}"
                                        BorderBrush="{DynamicResource ComboBorder}"
                                        BorderThickness="1"
                                        CornerRadius="0,0,3,3"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Base text ──────────────────────────────────────────────────── -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily"  Value="{StaticResource BodyFont}"/>
            <Setter Property="Foreground"  Value="{DynamicResource Text}"/>
            <Setter Property="FontSize"    Value="{DynamicResource GlobalFontSize}"/>
        </Style>
        <!-- Instrument label: wide-tracked brass lettering, the way a physical
             console legends its panels. Gold rather than the accent colour
             because in this skin grey IS the accent and gold carries emphasis. -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontFamily"  Value="{StaticResource HeadFont}"/>
            <Setter Property="FontWeight"  Value="Bold"/>
            <Setter Property="FontSize"    Value="{DynamicResource GlobalFontSizeSm}"/>
            <Setter Property="Foreground"  Value="{DynamicResource Amber}"/>
            <Setter Property="Margin"      Value="0,0,0,4"/>
            <!-- Tracking is what separates a legend from a caption. WPF has no
                 letter-spacing, so this is the closest equivalent. -->
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>

        <!-- ── Physical key (base for SmallBtn) ──────────────────────────────
             A moulded key sitting in a recess, not a flat rectangle.

             The FACE keeps TemplateBinding Background on purpose. The app
             colour-codes its buttons — red for close, amber for alerts, accent
             for tools — and a fixed key colour here would throw all of that
             away. Depth comes from the sheen and the edge instead, so a key is
             physical AND still carries its meaning.

             TRAVEL: the face normally floats 2px above the bottom of the
             recess. Pressed, that margin moves to the top and the face drops
             into the edge — the whole key visibly sinks, rather than dimming.
             ────────────────────────────────────────────────────────────────── -->
        <Style x:Key="IntelBtn" TargetType="Button">
            <Setter Property="FontFamily"        Value="{StaticResource HeadFont}"/>
            <Setter Property="FontSize"          Value="{DynamicResource GlobalFontSizeSm}"/>
            <Setter Property="FontWeight"        Value="Bold"/>
            <Setter Property="Foreground"        Value="{DynamicResource Accent}"/>
            <Setter Property="Background"        Value="{DynamicResource KeyFace}"/>
            <Setter Property="BorderBrush"       Value="{DynamicResource KeyBorder}"/>
            <Setter Property="BorderThickness"   Value="1"/>
            <Setter Property="Padding"           Value="8,4"/>
            <Setter Property="Cursor"            Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- The moulded base the key is seated in. Only
                                 its bottom 3px show; that sliver is the whole
                                 illusion of thickness. -->
                            <Border x:Name="Edge"
                                    Background="{DynamicResource KeyEdge}"
                                    CornerRadius="4"/>

                            <Border x:Name="Face"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"
                                    Margin="0,0,0,3">
                                <Grid>
                                    <!-- Specular sheen across the crown. -->
                                    <Border x:Name="Sheen"
                                            Background="{DynamicResource KeySheen}"
                                            CornerRadius="3"/>
                                    <!-- The lit top lip. One pixel of bright
                                         edge is what separates a moulded key
                                         from a rounded rectangle. -->
                                    <Border x:Name="Lip"
                                            Height="1"
                                            VerticalAlignment="Top"
                                            Margin="3,1,3,0"
                                            Background="{DynamicResource KeyLip}"/>
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Margin="{TemplateBinding Padding}"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Sheen" Property="Background"
                                        Value="{DynamicResource KeySheenLit}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <!-- Full travel: the crown drops the whole 3px
                                     into the base, the lip rolls out of sight
                                     and the sheen dulls. The key is DOWN, not
                                     merely darker. -->
                                <Setter TargetName="Face"  Property="Margin"     Value="0,3,0,0"/>
                                <Setter TargetName="Sheen" Property="Opacity"    Value="0.25"/>
                                <Setter TargetName="Lip"   Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter TargetName="Sheen" Property="Opacity"    Value="0"/>
                                <Setter TargetName="Lip"   Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Launcher key ───────────────────────────────────────────────
             A console key is a big thing you hit with a gloved hand. The
             default's 10,5 is a web button; this is hardware. Made possible
             by lifting these values off the instances in MainWindow.xaml,
             where no skin could reach them. -->
        <Style x:Key="LauncherBtn" TargetType="Button" BasedOn="{StaticResource IntelBtn}">
            <Setter Property="Padding"             Value="12,7"/>
            <Setter Property="Margin"              Value="0,3"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <!-- ── Status key ─────────────────────────────────────────────────
             A report key with an indicator lamp, the way a console marks a
             switch that raises an alarm.

             The lamp colour is the button's own BorderBrush. Each instance
             already carries a distinct one — red for GATE CAMP, orange for
             PIRATES, amber for ROAMING — so the lamp is correct per button
             without the skin knowing any of them by name.

             This is why StatusKey exists as a separate style: launcher keys
             share IntelBtn, and their BorderBrush is the dark key surround.
             A lamp painted with that would read as a drilled hole. -->
        <Style x:Key="StatusKey" TargetType="Button" BasedOn="{StaticResource IntelBtn}">
            <!-- Tighter than IntelBtn horizontally: the lamp costs width, and
                 without this the three report keys wrap to a second row and
                 push the footer off the bottom of the window. -->
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Edge"
                                    Background="{DynamicResource KeyEdge}"
                                    CornerRadius="4"/>
                            <Border x:Name="Face"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Margin="0,0,0,3">
                                <Grid>
                                    <Border x:Name="Sheen"
                                            Background="{DynamicResource KeySheen}"
                                            CornerRadius="3"/>
                                    <Border x:Name="Lip"
                                            Height="1" VerticalAlignment="Top"
                                            Margin="3,1,3,0"
                                            Background="{DynamicResource KeyLip}"/>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Margin="{TemplateBinding Padding}">
                                        <!-- The lamp. Glow ring behind a solid
                                             core, so it reads as lit rather
                                             than printed. -->
                                        <Grid Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center">
                                            <Ellipse Fill="{TemplateBinding BorderBrush}" Opacity="0.35"/>
                                            <Ellipse Fill="{TemplateBinding BorderBrush}" Margin="2"/>
                                        </Grid>
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Sheen" Property="Background" Value="{DynamicResource KeySheenLit}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face"  Property="Margin"     Value="0,3,0,0"/>
                                <Setter TargetName="Sheen" Property="Opacity"    Value="0.25"/>
                                <Setter TargetName="Lip"   Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter TargetName="Lip"   Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Small action button ────────────────────────────────────────── -->
        <Style x:Key="SmallBtn" TargetType="Button" BasedOn="{StaticResource IntelBtn}">
            <Setter Property="FontSize"    Value="{DynamicResource GlobalFontSizeXs}"/>
            <Setter Property="Padding"     Value="6,2"/>
        </Style>

        <!-- ── ToolTip (dark theme) ───────────────────────────────────────
             Without this, tooltips use WPF's pale default background while
             inheriting the app's near-white foreground — unreadable. -->
        <Style TargetType="ToolTip">
            <Setter Property="Background"      Value="{DynamicResource BgFF}"/>
            <Setter Property="Foreground"      Value="{DynamicResource Text}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource Accent}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="8,5"/>
            <Setter Property="FontSize"        Value="{DynamicResource GlobalFontSizeXs}"/>
            <Setter Property="HasDropShadow"   Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          SectionPanel default look: reproduces today's <Border><StackPanel> exactly.
          Background/BorderBrush/BorderThickness/Padding are TemplateBound so each
          usage keeps its own values — row 2 is Well/SteelBlue/0,0,0,1 while rows 3
          and 4 are Panel/Border/0,1,0,1, and merging them would be a visual change.
          CornerRadius is TemplateBound too but has no Setter here — its DP default
          is 0, matching rows 2/3/4 (square corners); the footer sets 0,0,8,8 on the
          instance.
        -->
        <Style TargetType="{x:Type ctl:SectionPanel}">
            <Setter Property="Background"      Value="{DynamicResource Panel}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="0,1,0,1"/>
            <Setter Property="Padding"         Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ctl:SectionPanel}">
                      <Grid>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                          <Grid>
                            <!-- Plate lighting. A panel is a sheet of metal lit
                                 from above, so the top edge catches and the rest
                                 falls away. Behind the content, never over it. -->
                            <Border Background="{DynamicResource PlateSheen}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Margin="-8,-6,-8,-6"/>
                            <StackPanel>
                                <!-- Header row. Collapses entirely when no Header is
                                     set, so the footer can use the same control.

                                     THE GAP UNDER THE HEADER BELONGS HERE, not to the
                                     content a window passes in. That is the whole point
                                     of the refactor: a skin replaces this template and
                                     gets to choose the spacing. If instead each window
                                     supplied its own margin, the values would sit in
                                     MainWindow.xaml where no skin can reach them, and a
                                     skin that changed this gap would leave every header
                                     accessory misaligned by the difference.

                                     So both slots must contribute ZERO margin of their
                                     own. Header content is styled with SectionHeader,
                                     which carries Margin="0,0,0,4" for the other windows
                                     that use it standalone. Inside a SectionPanel that
                                     must be overridden with Margin="0", or it stacks with
                                     this one and doubles the gap to 8px. -->
                                <Grid x:Name="HeaderRow" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      ContentSource="Header"
                                                      VerticalAlignment="Center"/>
                                    <ContentPresenter Grid.Column="1"
                                                      Content="{TemplateBinding HeaderAccessory}"
                                                      VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Gold rule under the header. This is the
                                     cockpit's signature: every instrument
                                     block is ruled off in brass. It is
                                     DECORATION SUPPLIED BY THE TEMPLATE, not
                                     content — no window knows it exists, so
                                     adding a sixth section gets it free. -->
                                <Border x:Name="HeaderRule"
                                        Height="1"
                                        Margin="0,0,0,6"
                                        Background="{DynamicResource Amber}"
                                        Opacity="0.55"/>

                                <!-- THE GLASS READOUT.
                                     A headed section is an instrument that
                                     displays something, so its content sits
                                     behind glass: recessed, darker than the
                                     plate around it, edge-lit, scanlined.

                                     Keyed off Header rather than off any
                                     particular section, because the template
                                     styles a CATEGORY. A sixth section added
                                     tomorrow gets its screen for free, and the
                                     button rows and footer — which display
                                     nothing and are headerless — correctly
                                     stay bare plate. -->
                                <Border x:Name="Glass"
                                        Background="{DynamicResource GlassFace}"
                                        BorderBrush="{DynamicResource GlassBorder}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="9,8">
                                    <Border.Resources>
                                        <!-- Text ON the readout takes the
                                             readout's colour. A lit screen
                                             does not print in the same ink as
                                             the panel around it, and that
                                             difference is a large part of why
                                             the reference looks like a display.

                                             Scoped to this Border, so it
                                             reaches only what is presented
                                             inside the glass. An explicit
                                             Foreground on any TextBlock still
                                             wins, which is deliberate: the
                                             status colours (red alerts, green
                                             security) must not be flattened
                                             into one colour. -->
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Foreground" Value="{DynamicResource GlassText}"/>
                                        </Style>
                                    </Border.Resources>
                                    <Grid>
                                        <!-- BEZEL SHADOW, beneath the content.
                                             Glass sits DOWN in the plate, and
                                             what says so is a hard shadow
                                             along the top inside edge where
                                             the surround overhangs it. Without
                                             this the screen reads as a darker
                                             rectangle painted on, rather than
                                             a panel cut into the console. -->
                                        <Border x:Name="Bezel"
                                                Background="{DynamicResource GlassBezel}"
                                                CornerRadius="4"
                                                IsHitTestVisible="False"
                                                Margin="-9,-8,-9,-8"/>

                                        <ContentPresenter/>
                                        <!-- Over the content, not under it:
                                             scanlines fall ON the display.
                                             Hit-testing off so the glass never
                                             swallows a click. -->
                                        <Border x:Name="Scan"
                                                Background="{StaticResource Scanlines}"
                                                CornerRadius="4"
                                                IsHitTestVisible="False"
                                                Margin="-9,-8,-9,-8"/>
                                        <!-- Inner top glow: light entering the
                                             screen from the bezel above. -->
                                        <Border x:Name="Glow"
                                                Background="{DynamicResource GlassGlow}"
                                                CornerRadius="4"
                                                IsHitTestVisible="False"
                                                Margin="-9,-8,-9,-8"/>

                                        <!-- NO SPECULAR HERE, DELIBERATELY.
                                             This is a CRT readout, not a
                                             window pane. The reference carries
                                             no highlight at all: its glassiness
                                             comes from scanlines over a flat,
                                             very dark surface. Every highlight
                                             tried here read as a smudge ON the
                                             screen rather than a reflection off
                                             it, because a lit display does not
                                             reflect much; it emits. -->

                                        <!-- The lit top rim: light catching the
                                             cut edge of the bezel. -->
                                        <Border x:Name="Rim"
                                                Height="1"
                                                VerticalAlignment="Top"
                                                Margin="-8,-8,-8,0"
                                                Background="{DynamicResource White22}"
                                                IsHitTestVisible="False"/>

                                        <!-- HUD REGISTRATION BRACKETS.
                                             Corner ticks framing the readout,
                                             the same vocabulary the control
                                             panel already uses (its "tick"
                                             custom property). Each is an L:
                                             two borders drawn, two at zero.

                                             Generic to any glass screen, so
                                             a section added later is framed
                                             without the skin being touched. -->
                                        <Grid x:Name="Ticks"
                                              IsHitTestVisible="False"
                                              Margin="-5,-4,-5,-4">
                                            <Border Width="9" Height="9"
                                                    HorizontalAlignment="Left"  VerticalAlignment="Top"
                                                    BorderBrush="{DynamicResource Amber}" BorderThickness="1,1,0,0"
                                                    Opacity="0.55"/>
                                            <Border Width="9" Height="9"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    BorderBrush="{DynamicResource Amber}" BorderThickness="0,1,1,0"
                                                    Opacity="0.55"/>
                                            <Border Width="9" Height="9"
                                                    HorizontalAlignment="Left"  VerticalAlignment="Bottom"
                                                    BorderBrush="{DynamicResource Amber}" BorderThickness="1,0,0,1"
                                                    Opacity="0.55"/>
                                            <Border Width="9" Height="9"
                                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                    BorderBrush="{DynamicResource Amber}" BorderThickness="0,0,1,1"
                                                    Opacity="0.55"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </StackPanel>
                          </Grid>
                        </Border>
                      </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Header" Value="{x:Null}">
                                <!-- Headerless sections (the footer, the panel
                                     launcher) get neither the header row nor
                                     its rule — a rule with nothing above it
                                     would read as a stray divider — and no
                                     glass, because they display nothing. -->
                                <Setter TargetName="HeaderRow"  Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="HeaderRule" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Glass" Property="Background"      Value="Transparent"/>
                                <Setter TargetName="Glass" Property="BorderThickness" Value="0"/>
                                <Setter TargetName="Glass" Property="Padding"         Value="0"/>
                                <Setter TargetName="Scan"  Property="Visibility"      Value="Collapsed"/>
                                <Setter TargetName="Glow"  Property="Visibility"      Value="Collapsed"/>
                                <Setter TargetName="Bezel" Property="Visibility"      Value="Collapsed"/>
                                <Setter TargetName="Rim"    Property="Visibility"     Value="Collapsed"/>
                                <Setter TargetName="Ticks" Property="Visibility"      Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          WindowShell default look: today's outer Border, verbatim.

          TextElement.FontSize is deliberately NOT set here. It is a user
          setting (SettingsWindow writes it, App.xaml.cs pushes it into
          Application.Current.Resources at startup), not chrome, so it lives
          on the ctl:WindowShell instance in MainWindow.xaml instead — the
          same place today's outer Border sets it. A skin that supplies its
          own WindowShell template cannot silently reset it by omission.
        -->
        <Style TargetType="{x:Type ctl:WindowShell}">
            <Setter Property="Background"      Value="{DynamicResource Bg}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ctl:WindowShell}">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>

                            <!-- CORNER BOLTS.
                                 The panel is fastened to the hull at four
                                 points. Purely template decoration — no window
                                 knows these exist, and no window has to.

                                 Drawn OVER the content, since a bolt head
                                 stands proud of the plate it fixes. Hit-testing
                                 is off so a bolt can never eat a click meant
                                 for the title bar or a resize edge. -->
                            <Grid IsHitTestVisible="False" Margin="5">
                                <Ellipse Width="7" Height="7" HorizontalAlignment="Left"  VerticalAlignment="Top"
                                         Fill="{DynamicResource Amber}" Opacity="0.85"/>
                                <Ellipse Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Top"
                                         Fill="{DynamicResource Amber}" Opacity="0.85"/>
                                <Ellipse Width="7" Height="7" HorizontalAlignment="Left"  VerticalAlignment="Bottom"
                                         Fill="{DynamicResource Amber}" Opacity="0.85"/>
                                <Ellipse Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                         Fill="{DynamicResource Amber}" Opacity="0.85"/>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TitleBar default look: today's row-0 Border, verbatim. -->
        <Style TargetType="{x:Type ctl:TitleBar}">
            <Setter Property="Background"      Value="{DynamicResource Onyx}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius"    Value="8,8,0,0"/>
            <Setter Property="Padding"         Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ctl:TitleBar}">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <!-- Brand plate lighting, behind the bar's
                                         own content. -->
                                    <Border Background="{DynamicResource PlateSheen}"
                                            CornerRadius="{TemplateBinding CornerRadius}"
                                            Margin="-10,-6,-10,-6"/>
                                    <ContentPresenter/>
                                </Grid>
                            </Border>

                            <!-- CAUTION STRIP.
                                 Every console has one. Sits along the bottom
                                 edge of the brand bar, where the mockup puts
                                 it, and is template decoration alone — the
                                 window neither supplies it nor knows of it.
                                 Hit-testing off: this strip lies over the
                                 draggable title bar and must not steal the
                                 drag. -->
                            <Border Height="4"
                                    VerticalAlignment="Bottom"
                                    Background="{StaticResource HazardStripe}"
                                    IsHitTestVisible="False"
                                    Opacity="0.9"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


    <!-- Role marker. ThemeManager swaps dictionaries by this, not by
         guessing from the keys they contain. -->
    <sys:String x:Key="__SkinDictionaryRole"
                xmlns:sys="clr-namespace:System;assembly=mscorlib">Styles</sys:String>
</ResourceDictionary>
