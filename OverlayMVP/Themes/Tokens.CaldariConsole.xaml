<!-- filename: Themes/Tokens.Default.xaml -->
<!--
  The default theme's colours. This is the file a skin replaces.

  Names come from Themes/design-reference/*.css so the CSS skins and this XAML
  share one vocabulary (cx-text-dim -> TextDim). VALUES are today's overlay
  colours, not the reference's — this theme must look exactly like the app
  always has.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Bg"      Color="#CC12161B"/>   <!-- was BgPanel -->
    <SolidColorBrush x:Key="Panel"   Color="#881E2630"/>   <!-- was BgCard -->
    <SolidColorBrush x:Key="Well"    Color="#EE0D141C"/>   <!-- was BgMultibox -->

    <!-- Borders -->
    <SolidColorBrush x:Key="Border"  Color="#FF2F3D4C"/>

    <!-- Text -->
    <SolidColorBrush x:Key="Text"    Color="#FFD9E2EC"/>   <!-- was TextPrimary -->
    <SolidColorBrush x:Key="TextDim" Color="#FF9FB0C0"/>   <!-- was TextSecondary -->

    <!-- Accents -->
    <SolidColorBrush x:Key="Accent"  Color="#FF3F7297"/>   <!-- was AccentBlue -->
    <SolidColorBrush x:Key="Amber"   Color="#FFD9A03C"/>   <!-- was AccentGold -->
    <SolidColorBrush x:Key="Red"     Color="#FFC9402E"/>   <!-- was AccentRed -->
    <SolidColorBrush x:Key="Green"   Color="#FF2E9A8E"/>   <!-- was AccentGreen -->

    <!-- Task 3: five smallest windows -->
    <SolidColorBrush x:Key="Surface"      Color="#FF1A2028"/>   <!-- FirstRunWindow background -->
    <SolidColorBrush x:Key="PaleCyan"     Color="#FF74A4C4"/>   <!-- FirstRunWindow status text -->
    <SolidColorBrush x:Key="BgEE"         Color="#EE12161B"/>   <!-- Bg, alpha EE -->
    <SolidColorBrush x:Key="Border44"     Color="#442F3D4C"/>   <!-- Border, alpha 44 -->
    <SolidColorBrush x:Key="DeepNavy"     Color="#CC1A2028"/>   <!-- ShipFitWindow title bar -->
    <SolidColorBrush x:Key="TextFaint"    Color="#FF647486"/>   <!-- ShipFitWindow close button -->
    <SolidColorBrush x:Key="Onyx"         Color="#CC1A2028"/>   <!-- NotePrompt/MissionProgress title bar -->
    <SolidColorBrush x:Key="Border22"     Color="#222F3D4C"/>   <!-- Border, alpha 22 -->
    <SolidColorBrush x:Key="White33"      Color="#33FFFFFF"/>   <!-- NotePromptWindow Cancel button -->
    <SolidColorBrush x:Key="Green33"      Color="#332E9A8E"/>   <!-- Green, alpha 33 -->
    <SolidColorBrush x:Key="Red33"        Color="#33C9402E"/>   <!-- Red, alpha 33 -->
    <SolidColorBrush x:Key="Abyss"        Color="#FF050B13"/>   <!-- ThumbnailWindow thumbnail host -->
    <SolidColorBrush x:Key="BorderStrong" Color="#FF3D4C5F"/>   <!-- ThumbnailWindow BorderClr (hoisted) -->

    <!-- Task 4: mid-size windows -->
    <SolidColorBrush x:Key="GunMetal"     Color="#0D141C"/>     <!-- BriefingWindow window background -->
    <SolidColorBrush x:Key="Charcoal"     Color="#1E2630"/>     <!-- BriefingWindow title bar / transport bar -->
    <SolidColorBrush x:Key="Accent22"     Color="#223F7297"/>   <!-- Accent, alpha 22 -->
    <SolidColorBrush x:Key="Accent88"     Color="#883F7297"/>   <!-- Accent, alpha 88 -->
    <SolidColorBrush x:Key="Green22"      Color="#222E9A8E"/>   <!-- Green, alpha 22 -->
    <SolidColorBrush x:Key="Green88"      Color="#882E9A8E"/>   <!-- Green, alpha 88 -->
    <SolidColorBrush x:Key="Gray22"       Color="#223F7297"/>   <!-- Gray, alpha 22 -->
    <SolidColorBrush x:Key="Gray88"       Color="#883F7297"/>   <!-- Gray, alpha 88 -->
    <SolidColorBrush x:Key="SteelGrey"    Color="#FF9FB0C0"/>   <!-- BriefingWindow Close button text -->
    <SolidColorBrush x:Key="White11"      Color="#11FFFFFF"/>   <!-- White, alpha 11 -->
    <SolidColorBrush x:Key="Amber33"      Color="#33D9A03C"/>   <!-- Amber, alpha 33 -->
    <SolidColorBrush x:Key="Emerald33"    Color="#332E9A8E"/>   <!-- Emerald, alpha 33 -->
    <SolidColorBrush x:Key="Accent33"     Color="#333F7297"/>   <!-- Accent, alpha 33 -->
    <SolidColorBrush x:Key="White22"      Color="#22FFFFFF"/>   <!-- White, alpha 22 -->
    <SolidColorBrush x:Key="DeepInk"      Color="#FF0A0E15"/>   <!-- IntelWindow search box background -->
    <SolidColorBrush x:Key="PaleLavender" Color="#FFD9E2EC"/>   <!-- IntelWindow search box text -->

    <!-- Task 5: SkillPlan, MainWindow, Settings -->
    <SolidColorBrush x:Key="BgFF"         Color="#FF12161B"/>   <!-- Bg, alpha FF -->
    <SolidColorBrush x:Key="Bg11"         Color="#1112161B"/>   <!-- Bg, alpha 11 -->
    <SolidColorBrush x:Key="BgDD"         Color="#DD12161B"/>   <!-- Bg, alpha DD -->
    <SolidColorBrush x:Key="BorderCC"     Color="#CC2F3D4C"/>   <!-- Border, alpha CC -->
    <SolidColorBrush x:Key="SteelBlue"    Color="#FF3D4C5F"/>   <!-- MainWindow/SettingsWindow border colour -->
    <SolidColorBrush x:Key="White"        Color="#FFFFFFFF"/>   <!-- base white -->
    <SolidColorBrush x:Key="Black"        Color="#FF000000"/>   <!-- base black -->
    <SolidColorBrush x:Key="White0D"      Color="#0DFFFFFF"/>   <!-- White, alpha 0D -->
    <SolidColorBrush x:Key="White44"      Color="#44FFFFFF"/>   <!-- White, alpha 44 -->
    <SolidColorBrush x:Key="Accent1A"     Color="#1A3F7297"/>   <!-- Accent, alpha 1A -->
    <SolidColorBrush x:Key="Accent66"     Color="#663F7297"/>   <!-- Accent, alpha 66 -->
    <SolidColorBrush x:Key="Amber22"      Color="#22D9A03C"/>   <!-- Amber, alpha 22 -->
    <SolidColorBrush x:Key="Orange"       Color="#FFE09A52"/>   <!-- MainWindow PIRATES report button -->
    <SolidColorBrush x:Key="Orange33"     Color="#33E09A52"/>   <!-- Orange, alpha 33 -->
    <SolidColorBrush x:Key="SlateGray"    Color="#FF647486"/>   <!-- SkillPlanWindow tooltip note text -->
    <SolidColorBrush x:Key="AquaBlue"     Color="#2246AAE6"/>   <!-- MainWindow multibox card hover highlight -->
    <SolidColorBrush x:Key="Graphite"     Color="#CC161C24"/>   <!-- MainWindow panel launcher background -->
    <SolidColorBrush x:Key="Obsidian"     Color="#CC0D141C"/>   <!-- MainWindow footer background -->
    <SolidColorBrush x:Key="InkBlue"      Color="#CC141B24"/>   <!-- MainWindow sponsor banner background -->
    <SolidColorBrush x:Key="Black01"      Color="#01000000"/>   <!-- MainWindow resize-strip hit-test regions -->
    <SolidColorBrush x:Key="TwilightBlue" Color="#FF181F2B"/>   <!-- SettingsWindow default button background -->
    <SolidColorBrush x:Key="Cyan"         Color="#FF6ED3F0"/>   <!-- SettingsWindow accent cyan -->
    <SolidColorBrush x:Key="DeepTeal"     Color="#FF1E3438"/>   <!-- SettingsWindow primary button background -->
    <SolidColorBrush x:Key="MintGreen"    Color="#FF7FD8D0"/>   <!-- SettingsWindow linked-character bullet -->
    <SolidColorBrush x:Key="SlateNavy"    Color="#FF556777"/>   <!-- SettingsWindow faint hint text -->

    <!-- Task 7: StandingGuideWindow -->
    <SolidColorBrush x:Key="Bg0A"         Color="#0A12161B"/>   <!-- Bg, alpha 0A -->
    <SolidColorBrush x:Key="Accent0A"     Color="#0A3F7297"/>   <!-- Accent, alpha 0A -->
    <SolidColorBrush x:Key="DuskBlue"     Color="#333D4C5F"/>   <!-- StandingGuideWindow faction ListBoxItem selected background -->
    <SolidColorBrush x:Key="Border33"     Color="#332F3D4C"/>   <!-- Border, alpha 33 -->
    <SolidColorBrush x:Key="Green0A"      Color="#0A2E9A8E"/>   <!-- Green, alpha 0A -->
    <SolidColorBrush x:Key="SkyBlue"      Color="#FF6ED3F0"/>   <!-- StandingGuideWindow TIP text -->
    <SolidColorBrush x:Key="Amber1A"      Color="#1AD9A03C"/>   <!-- Amber, alpha 1A -->
    <SolidColorBrush x:Key="Green15"      Color="#152E9A8E"/>   <!-- Green, alpha 15 -->
    <SolidColorBrush x:Key="Accent15"     Color="#153F7297"/>   <!-- Accent, alpha 15 -->
    <SolidColorBrush x:Key="Amber15"      Color="#15D9A03C"/>   <!-- Amber, alpha 15 -->
    <SolidColorBrush x:Key="Red1A"        Color="#1AC9402E"/>   <!-- Red, alpha 1A -->
    <SolidColorBrush x:Key="Ivory"        Color="#22E8B04A"/>   <!-- StandingGuideWindow Order button background -->

    <!-- Shared control styles (Styles.Default.xaml) -->
    <SolidColorBrush x:Key="ComboBg" Color="#FF181F2B"/>   <!-- ComboBox face -->
    <SolidColorBrush x:Key="ComboBorder" Color="#FF3D4C5F"/>   <!-- ComboBox / ToolTip border -->
    <SolidColorBrush x:Key="ComboItemBg" Color="#FF243040"/>   <!-- ComboBox item background -->
    <SolidColorBrush x:Key="ComboHover" Color="#FF2A3849"/>   <!-- ComboBox item hover -->
    <SolidColorBrush x:Key="ComboSelect" Color="#FF2A4F6E"/>   <!-- ComboBox item selected -->
    <SolidColorBrush x:Key="IceBlue" Color="#FF6ED3F0"/>   <!-- ComboBox selected text -->
    <SolidColorBrush x:Key="ComboEdge" Color="#FF3D4C5F"/>   <!-- ComboBox drop-down edge -->
    <SolidColorBrush x:Key="Indigo44" Color="#443D4C5F"/>   <!-- ComboBox popup shadow -->


    <!-- Role marker. ThemeManager swaps dictionaries by this, not by
         guessing from the keys they contain. -->
    <sys:String x:Key="__SkinDictionaryRole"
                xmlns:sys="clr-namespace:System;assembly=mscorlib">Tokens</sys:String>

    <!-- Skin-specific tokens. No counterpart in the default theme: these
         exist only for skins whose component layer draws things the
         default one does not (key bevels, glass, hazard striping). -->
    <SolidColorBrush x:Key="AccentKeyHi"  Color="#FF3F7297"/>
    <SolidColorBrush x:Key="AccentKeyLo"  Color="#FF2A4F6E"/>
    <SolidColorBrush x:Key="AmberKeyHi"   Color="#FF383023"/>
    <SolidColorBrush x:Key="AmberKeyLo"   Color="#FF29231A"/>
    <SolidColorBrush x:Key="GlassBorder"  Color="#FF10161D"/>
    <SolidColorBrush x:Key="GlassBottom"  Color="#FF040A12"/>
    <SolidColorBrush x:Key="GlassGlowTop" Color="#FF46AAE6"/>
    <SolidColorBrush x:Key="GlassText"    Color="#FF74A4C4"/>
    <SolidColorBrush x:Key="GlassTextHi"  Color="#FF6ED3F0"/>
    <SolidColorBrush x:Key="GlassTop"     Color="#FF081420"/>
    <SolidColorBrush x:Key="GreenKeyHi"   Color="#FF1E3438"/>
    <SolidColorBrush x:Key="GreenKeyLo"   Color="#FF152528"/>
    <SolidColorBrush x:Key="HazardA"      Color="#FFD9A03C"/>
    <SolidColorBrush x:Key="HazardB"      Color="#FF12161B"/>
    <SolidColorBrush x:Key="KeyBorder"    Color="#FF101620"/>
    <SolidColorBrush x:Key="KeyEdge"      Color="#FF0A0E15"/>
    <SolidColorBrush x:Key="KeyHi"        Color="#FF243040"/>
    <SolidColorBrush x:Key="KeyLip"       Color="#FFA0C8F0"/>
    <SolidColorBrush x:Key="KeyLo"        Color="#FF181F2B"/>
    <SolidColorBrush x:Key="RedKeyHi"     Color="#FF382526"/>
    <SolidColorBrush x:Key="RedKeyLo"     Color="#FF291A1B"/>

    <LinearGradientBrush x:Key="KeyFace" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF243040"/>
        <GradientStop Offset="1" Color="#FF181F2B"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentKeyFace" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF3F7297"/>
        <GradientStop Offset="1" Color="#FF2A4F6E"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AmberKeyFace" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF383023"/>
        <GradientStop Offset="1" Color="#FF29231A"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="RedKeyFace" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF382526"/>
        <GradientStop Offset="1" Color="#FF291A1B"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GreenKeyFace" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF1E3438"/>
        <GradientStop Offset="1" Color="#FF152528"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassFace" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF081420"/>
        <GradientStop Offset="1" Color="#FF040A12"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PlateFace" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF1E2630"/>
        <GradientStop Offset="1" Color="#FF12161B"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="KeySheen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#26FFFFFF"/>
        <GradientStop Offset="1" Color="#00FFFFFF"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="KeySheenLit" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#40FFFFFF"/>
        <GradientStop Offset="1" Color="#00FFFFFF"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PlateSheen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#0DFFFFFF"/>
        <GradientStop Offset="1" Color="#00FFFFFF"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassGlow" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#1F46AAE6"/>
        <GradientStop Offset="1" Color="#0046AAE6"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassBezel" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#80000000"/>
        <GradientStop Offset="1" Color="#00000000"/>
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="GlassAqua" Center="0.5,-0.55" GradientOrigin="0.5,-0.55" RadiusX="1.5" RadiusY="1.15">
        <GradientStop Offset="0" Color="#47FFFFFF"/>
        <GradientStop Offset="0.55" Color="#2BFFFFFF"/>
        <GradientStop Offset="0.7" Color="#1CFFFFFF"/>
        <GradientStop Offset="0.72" Color="#00FFFFFF"/>
        <GradientStop Offset="1" Color="#00FFFFFF"/>
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="GlassBounce" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#0046AAE6"/>
        <GradientStop Offset="1" Color="#3346AAE6"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassField" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#4D000000"/>
        <GradientStop Offset="1" Color="#4D000000"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassFieldEdge" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#4046AAE6"/>
        <GradientStop Offset="1" Color="#2646AAE6"/>
    </LinearGradientBrush>
</ResourceDictionary>
