<!-- filename: Themes/Tokens.Default.xaml -->
<!--
  The default theme's colours. This is the file a skin replaces.

  Names come from Themes/design-reference/*.css so the CSS skins and this XAML
  share one vocabulary (cx-text-dim -> TextDim). VALUES are today's overlay
  colours, not the reference's — this theme must look exactly like the app
  always has.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Bg"      Color="#CC1A1505"/>   <!-- was BgPanel -->
    <SolidColorBrush x:Key="Panel"   Color="#882C2308"/>   <!-- was BgCard -->
    <SolidColorBrush x:Key="Well"    Color="#EE151104"/>   <!-- was BgMultibox -->

    <!-- Borders -->
    <SolidColorBrush x:Key="Border"  Color="#FF574611"/>

    <!-- Text -->
    <SolidColorBrush x:Key="Text"    Color="#FFF0E6D2"/>   <!-- was TextPrimary -->
    <SolidColorBrush x:Key="TextDim" Color="#FFBCA982"/>   <!-- was TextSecondary -->

    <!-- Accents -->
    <SolidColorBrush x:Key="Accent"  Color="#FFAA7C46"/>   <!-- was AccentBlue -->
    <SolidColorBrush x:Key="Amber"   Color="#FFE8C974"/>   <!-- was AccentGold -->
    <SolidColorBrush x:Key="Red"     Color="#FFC9402E"/>   <!-- was AccentRed -->
    <SolidColorBrush x:Key="Green"   Color="#FF6E9A4A"/>   <!-- was AccentGreen -->

    <!-- Task 3: five smallest windows -->
    <SolidColorBrush x:Key="Surface"      Color="#FF231C07"/>   <!-- FirstRunWindow background -->
    <SolidColorBrush x:Key="PaleCyan"     Color="#FFD8C08A"/>   <!-- FirstRunWindow status text -->
    <SolidColorBrush x:Key="BgEE"         Color="#EE1A1505"/>   <!-- Bg, alpha EE -->
    <SolidColorBrush x:Key="Border44"     Color="#44574611"/>   <!-- Border, alpha 44 -->
    <SolidColorBrush x:Key="DeepNavy"     Color="#CC231C07"/>   <!-- ShipFitWindow title bar -->
    <SolidColorBrush x:Key="TextFaint"    Color="#FF8A7A5A"/>   <!-- ShipFitWindow close button -->
    <SolidColorBrush x:Key="Onyx"         Color="#CC231C07"/>   <!-- NotePrompt/MissionProgress title bar -->
    <SolidColorBrush x:Key="Border22"     Color="#22574611"/>   <!-- Border, alpha 22 -->
    <SolidColorBrush x:Key="White33"      Color="#33FFFFFF"/>   <!-- NotePromptWindow Cancel button -->
    <SolidColorBrush x:Key="Green33"      Color="#336E9A4A"/>   <!-- Green, alpha 33 -->
    <SolidColorBrush x:Key="Red33"        Color="#33C9402E"/>   <!-- Red, alpha 33 -->
    <SolidColorBrush x:Key="Abyss"        Color="#FF0E0B03"/>   <!-- ThumbnailWindow thumbnail host -->
    <SolidColorBrush x:Key="BorderStrong" Color="#FF705A16"/>   <!-- ThumbnailWindow BorderClr (hoisted) -->

    <!-- Task 4: mid-size windows -->
    <SolidColorBrush x:Key="GunMetal"     Color="#151104"/>     <!-- BriefingWindow window background -->
    <SolidColorBrush x:Key="Charcoal"     Color="#2C2308"/>     <!-- BriefingWindow title bar / transport bar -->
    <SolidColorBrush x:Key="Accent22"     Color="#22AA7C46"/>   <!-- Accent, alpha 22 -->
    <SolidColorBrush x:Key="Accent88"     Color="#88AA7C46"/>   <!-- Accent, alpha 88 -->
    <SolidColorBrush x:Key="Green22"      Color="#226E9A4A"/>   <!-- Green, alpha 22 -->
    <SolidColorBrush x:Key="Green88"      Color="#886E9A4A"/>   <!-- Green, alpha 88 -->
    <SolidColorBrush x:Key="Gray22"       Color="#22AA7C46"/>   <!-- Gray, alpha 22 -->
    <SolidColorBrush x:Key="Gray88"       Color="#88AA7C46"/>   <!-- Gray, alpha 88 -->
    <SolidColorBrush x:Key="SteelGrey"    Color="#FFBCA982"/>   <!-- BriefingWindow Close button text -->
    <SolidColorBrush x:Key="White11"      Color="#11FFFFFF"/>   <!-- White, alpha 11 -->
    <SolidColorBrush x:Key="Amber33"      Color="#33E8C974"/>   <!-- Amber, alpha 33 -->
    <SolidColorBrush x:Key="Emerald33"    Color="#336E8A3E"/>   <!-- Emerald, alpha 33 -->
    <SolidColorBrush x:Key="Accent33"     Color="#33AA7C46"/>   <!-- Accent, alpha 33 -->
    <SolidColorBrush x:Key="White22"      Color="#22FFFFFF"/>   <!-- White, alpha 22 -->
    <SolidColorBrush x:Key="DeepInk"      Color="#FF191405"/>   <!-- IntelWindow search box background -->
    <SolidColorBrush x:Key="PaleLavender" Color="#FFF0E6D2"/>   <!-- IntelWindow search box text -->

    <!-- Task 5: SkillPlan, MainWindow, Settings -->
    <SolidColorBrush x:Key="BgFF"         Color="#FF1A1505"/>   <!-- Bg, alpha FF -->
    <SolidColorBrush x:Key="Bg11"         Color="#111A1505"/>   <!-- Bg, alpha 11 -->
    <SolidColorBrush x:Key="BgDD"         Color="#DD1A1505"/>   <!-- Bg, alpha DD -->
    <SolidColorBrush x:Key="BorderCC"     Color="#CC574611"/>   <!-- Border, alpha CC -->
    <SolidColorBrush x:Key="SteelBlue"    Color="#FF705A16"/>   <!-- MainWindow/SettingsWindow border colour -->
    <SolidColorBrush x:Key="White"        Color="#FFFFFFFF"/>   <!-- base white -->
    <SolidColorBrush x:Key="Black"        Color="#FF000000"/>   <!-- base black -->
    <SolidColorBrush x:Key="White0D"      Color="#0DFFFFFF"/>   <!-- White, alpha 0D -->
    <SolidColorBrush x:Key="White44"      Color="#44FFFFFF"/>   <!-- White, alpha 44 -->
    <SolidColorBrush x:Key="Accent1A"     Color="#1AAA7C46"/>   <!-- Accent, alpha 1A -->
    <SolidColorBrush x:Key="Accent66"     Color="#66AA7C46"/>   <!-- Accent, alpha 66 -->
    <SolidColorBrush x:Key="Amber22"      Color="#22E8C974"/>   <!-- Amber, alpha 22 -->
    <SolidColorBrush x:Key="Orange"       Color="#FFD0812C"/>   <!-- MainWindow PIRATES report button -->
    <SolidColorBrush x:Key="Orange33"     Color="#33D0812C"/>   <!-- Orange, alpha 33 -->
    <SolidColorBrush x:Key="SlateGray"    Color="#FF8A7A5A"/>   <!-- SkillPlanWindow tooltip note text -->
    <SolidColorBrush x:Key="AquaBlue"     Color="#22BF9461"/>   <!-- MainWindow multibox card hover highlight -->
    <SolidColorBrush x:Key="Graphite"     Color="#CC1D1806"/>   <!-- MainWindow panel launcher background -->
    <SolidColorBrush x:Key="Obsidian"     Color="#CC151104"/>   <!-- MainWindow footer background -->
    <SolidColorBrush x:Key="InkBlue"      Color="#CC1B1605"/>   <!-- MainWindow sponsor banner background -->
    <SolidColorBrush x:Key="Black01"      Color="#01000000"/>   <!-- MainWindow resize-strip hit-test regions -->
    <SolidColorBrush x:Key="TwilightBlue" Color="#FF33290A"/>   <!-- SettingsWindow default button background -->
    <SolidColorBrush x:Key="Cyan"         Color="#FFF0D68A"/>   <!-- SettingsWindow accent cyan -->
    <SolidColorBrush x:Key="DeepTeal"     Color="#FF3A2E18"/>   <!-- SettingsWindow primary button background -->
    <SolidColorBrush x:Key="MintGreen"    Color="#FFA8C98A"/>   <!-- SettingsWindow linked-character bullet -->
    <SolidColorBrush x:Key="SlateNavy"    Color="#FF6E6047"/>   <!-- SettingsWindow faint hint text -->

    <!-- Task 7: StandingGuideWindow -->
    <SolidColorBrush x:Key="Bg0A"         Color="#0A1A1505"/>   <!-- Bg, alpha 0A -->
    <SolidColorBrush x:Key="Accent0A"     Color="#0AAA7C46"/>   <!-- Accent, alpha 0A -->
    <SolidColorBrush x:Key="DuskBlue"     Color="#33705A16"/>   <!-- StandingGuideWindow faction ListBoxItem selected background -->
    <SolidColorBrush x:Key="Border33"     Color="#33574611"/>   <!-- Border, alpha 33 -->
    <SolidColorBrush x:Key="Green0A"      Color="#0A6E9A4A"/>   <!-- Green, alpha 0A -->
    <SolidColorBrush x:Key="SkyBlue"      Color="#FFF0D68A"/>   <!-- StandingGuideWindow TIP text -->
    <SolidColorBrush x:Key="Amber1A"      Color="#1AE8C974"/>   <!-- Amber, alpha 1A -->
    <SolidColorBrush x:Key="Green15"      Color="#156E9A4A"/>   <!-- Green, alpha 15 -->
    <SolidColorBrush x:Key="Accent15"     Color="#15AA7C46"/>   <!-- Accent, alpha 15 -->
    <SolidColorBrush x:Key="Amber15"      Color="#15E8C974"/>   <!-- Amber, alpha 15 -->
    <SolidColorBrush x:Key="Red1A"        Color="#1AC9402E"/>   <!-- Red, alpha 1A -->
    <SolidColorBrush x:Key="Ivory"        Color="#22F5E6B0"/>   <!-- StandingGuideWindow Order button background -->

    <!-- Shared control styles (Styles.Default.xaml) -->
    <SolidColorBrush x:Key="ComboBg" Color="#FF1D1806"/>   <!-- ComboBox face -->
    <SolidColorBrush x:Key="ComboBorder" Color="#FF705A16"/>   <!-- ComboBox / ToolTip border -->
    <SolidColorBrush x:Key="ComboItemBg" Color="#FF2C2308"/>   <!-- ComboBox item background -->
    <SolidColorBrush x:Key="ComboHover" Color="#FF362C0B"/>   <!-- ComboBox item hover -->
    <SolidColorBrush x:Key="ComboSelect" Color="#FF574611"/>   <!-- ComboBox item selected -->
    <SolidColorBrush x:Key="IceBlue" Color="#FFF0D68A"/>   <!-- ComboBox selected text -->
    <SolidColorBrush x:Key="ComboEdge" Color="#FF705A16"/>   <!-- ComboBox drop-down edge -->
    <SolidColorBrush x:Key="Indigo44" Color="#44705A16"/>   <!-- ComboBox popup shadow -->


    <!-- Role marker. ThemeManager swaps dictionaries by this, not by
         guessing from the keys they contain. -->
    <sys:String x:Key="__SkinDictionaryRole"
                xmlns:sys="clr-namespace:System;assembly=mscorlib">Tokens</sys:String>

    <!-- Skin-specific tokens. No counterpart in the default theme: these
         exist only for skins whose component layer draws things the
         default one does not (key bevels, glass, hazard striping). -->
    <SolidColorBrush x:Key="AccentKeyHi"  Color="#FFAA7C46"/>
    <SolidColorBrush x:Key="AccentKeyLo"  Color="#FF7E5C34"/>
    <SolidColorBrush x:Key="AmberKeyHi"   Color="#FF4A3D1F"/>
    <SolidColorBrush x:Key="AmberKeyLo"   Color="#FF382E15"/>
    <SolidColorBrush x:Key="GlassBorder"  Color="#FF100D03"/>
    <SolidColorBrush x:Key="GlassBottom"  Color="#FF0E0B03"/>
    <SolidColorBrush x:Key="GlassGlowTop" Color="#FFE0B840"/>
    <SolidColorBrush x:Key="GlassText"    Color="#FFC4A96E"/>
    <SolidColorBrush x:Key="GlassTextHi"  Color="#FFF0D68A"/>
    <SolidColorBrush x:Key="GlassTop"     Color="#FF1B1605"/>
    <SolidColorBrush x:Key="GreenKeyHi"   Color="#FF1E3A34"/>
    <SolidColorBrush x:Key="GreenKeyLo"   Color="#FF152A26"/>
    <SolidColorBrush x:Key="HazardA"      Color="#FFE8C974"/>
    <SolidColorBrush x:Key="HazardB"      Color="#FF161009"/>
    <SolidColorBrush x:Key="KeyBorder"    Color="#FF705A16"/>
    <SolidColorBrush x:Key="KeyEdge"      Color="#FF171204"/>
    <SolidColorBrush x:Key="KeyHi"        Color="#FF46390E"/>
    <SolidColorBrush x:Key="KeyLip"       Color="#FFB39A6A"/>
    <SolidColorBrush x:Key="KeyLo"        Color="#FF33290A"/>
    <SolidColorBrush x:Key="RedKeyHi"     Color="#FF442426"/>
    <SolidColorBrush x:Key="RedKeyLo"     Color="#FF33191B"/>

    <LinearGradientBrush x:Key="KeyFace" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF46390E"/>
        <GradientStop Offset="1" Color="#FF33290A"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentKeyFace" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FFAA7C46"/>
        <GradientStop Offset="1" Color="#FF7E5C34"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AmberKeyFace" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF4A3D1F"/>
        <GradientStop Offset="1" Color="#FF382E15"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="RedKeyFace" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF442426"/>
        <GradientStop Offset="1" Color="#FF33191B"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GreenKeyFace" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF1E3A34"/>
        <GradientStop Offset="1" Color="#FF152A26"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassFace" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF1B1605"/>
        <GradientStop Offset="1" Color="#FF0E0B03"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PlateFace" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF2C2308"/>
        <GradientStop Offset="1" Color="#FF1A1505"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="KeySheen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#26FFFFFF"/>
        <GradientStop Offset="1" Color="#00FFFFFF"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="KeySheenLit" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#40FFFFFF"/>
        <GradientStop Offset="1" Color="#00FFFFFF"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PlateSheen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#0DFFFFFF"/>
        <GradientStop Offset="1" Color="#00FFFFFF"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassGlow" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#1FE0B840"/>
        <GradientStop Offset="1" Color="#00E0B840"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassBezel" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#80000000"/>
        <GradientStop Offset="1" Color="#00000000"/>
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="GlassAqua" Center="0.5,-0.55" GradientOrigin="0.5,-0.55" RadiusX="1.5" RadiusY="1.15">
        <GradientStop Offset="0" Color="#47FFFFFF"/>
        <GradientStop Offset="0.55" Color="#2BFFFFFF"/>
        <GradientStop Offset="0.7" Color="#1CFFFFFF"/>
        <GradientStop Offset="0.72" Color="#00FFFFFF"/>
        <GradientStop Offset="1" Color="#00FFFFFF"/>
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="GlassBounce" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#00E0B840"/>
        <GradientStop Offset="1" Color="#33E0B840"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassField" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#4D000000"/>
        <GradientStop Offset="1" Color="#4D000000"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassFieldEdge" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#40E0B840"/>
        <GradientStop Offset="1" Color="#26E0B840"/>
    </LinearGradientBrush>
</ResourceDictionary>
